            "SQL 2005 là phiên bản cũ; bản này không đảm bảo cài trên Windows 10/11." +
            "`nChỉ chọn bộ cài Microsoft từ nguồn bạn tin tưởng." +
            "`nTiếp tục?"
        ))) { return }

        $dialog = New-Object Windows.Forms.OpenFileDialog
        $dialog.Filter = 'Bộ cài EXE|*.exe'

        try {
            if ($dialog.ShowDialog() -ne
                [Windows.Forms.DialogResult]::OK) {
                return
            }

            $sig = Get-AuthenticodeSignature `
                -LiteralPath $dialog.FileName

            if ($sig.Status -ne 'Valid' -or
                $sig.SignerCertificate.Subject -notmatch
                'Microsoft Corporation') {
                throw 'Không xác minh được chữ ký Microsoft. Không chạy bộ cài.'
            }

            if (Confirm (
                "Chạy bộ cài: $($dialog.FileName)?" +
                "`nChữ ký hợp lệ không đảm bảo đây đúng phiên bản SQL bạn cần."
            )) {
                Start-Process -FilePath $dialog.FileName
                Log 'Đã mở bộ cài được chọn.'
            }
        }
        finally {
            $dialog.Dispose()
        }
    } 350 '#2C405E'

    # ==================== KHOI DONG ====================

    $script:form.Add_FormClosing({
        param($sender, $eventArgs)

        if ($script:busy) {
            $eventArgs.Cancel = $true
        }
    })

    Select-Page 0

    Log 'BEN OPTIMIZER 2.0: bản giao diện thanh danh mục bên trái.'
    Log 'Chưa áp dụng thay đổi hệ thống nào.'
    Log "Windows build: $script:build"
    Log "Thư mục sao lưu: $script:session"

    try {
        Fill-CurrentIP -Quiet
        Log 'Đã tự điền IP, prefix và gateway hiện tại.'
    }
    catch {
        $script:networkInfo.Text = 'Chưa tự nhận được IP. Bấm Lấy IP hiện tại.'
        Log ('Đọc mạng: ' + $_.Exception.Message)
    }

    try {
        [void]$script:form.ShowDialog()
    }
    finally {
        $script:form.Dispose()
    }
}

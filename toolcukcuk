    function Refresh-Network {
        $n = Active-Network
        $script:ipChoice.Items.Clear()

        $ips = @(
            Get-NetIPAddress -InterfaceIndex $n.Index `
                -AddressFamily IPv4 |
                Where-Object {
                    $_.AddressState -eq 'Preferred' -and
                    $_.IPAddress -notlike '169.254.*' -and
                    $_.IPAddress -notlike '127.*'
                }
        )

        foreach ($ip in $ips) {
            $entry = [pscustomobject]@{
                Display = '{0}/{1}' -f
                    $ip.IPAddress, $ip.PrefixLength
                IPAddress = [string]$ip.IPAddress
                PrefixLength = [int]$ip.PrefixLength
            }
            [void]$script:ipChoice.Items.Add($entry)
        }

        $script:ipChoice.DisplayMember = 'Display'
        $script:gatewayInput.Text = $n.Gateway

        if ($script:ipChoice.Items.Count -gt 0) {
            $script:ipChoice.SelectedIndex = 0
        }

        $kind = 'LAN / kết nối khác'
        $extra = ''

        if (Wifi-Card $n.Adapter) {
            $kind = 'Wi-Fi'
            $wifi = Wifi-Details
            $extra = ' | SSID: {0} | Băng tần: {1} | Sóng: {2}' -f
                $wifi.SSID, $wifi.Band, $wifi.Signal
        }

        $script:connectionInfo.Text = (
            '{0} | Card: {1} | Gateway: {2}{3}' -f
            $kind, $n.Alias, $n.Gateway, $extra
        )

        Log (
            "Đã nhận card $($n.Alias), " +
            "$($ips.Count) IPv4. Chưa sửa cấu hình."
        )
    }

    $staticButton = Button 'Đặt IP tĩnh' {
        $n = Active-Network
        $ip = $script:ipInput.Text.Trim()
        $gw = $script:gatewayInput.Text.Trim()

        $null = IPv4 $ip
        $null = IPv4 $gw

        $prefix = 0
        if (
            -not [int]::TryParse(
                $script:prefixInput.Text.Trim(),
                [ref]$prefix
            ) -or
            $prefix -lt 1 -or $prefix -gt 30
        ) {
            throw 'Prefix phải là số từ 1 đến 30.'
        }

        $existing = @(
            Get-NetIPAddress -InterfaceIndex $n.Index `
                -AddressFamily IPv4 |
                Where-Object {
                    $_.IPAddress -notlike '169.254.*'
                }
        )

        if ($existing.Count -ne 1) {
            throw (
                'Card đang có nhiều hoặc không có IPv4. ' +
                'Để tránh xóa IP thiết bị khác, tool không tự đặt tĩnh. ' +
                'Hãy dùng cấu hình mạng thủ công.'
            )
        }

        if ($ip -eq $gw) {
            throw 'IP máy không được trùng gateway.'
        }

        if (-not (Ask (
            "Đặt IP $ip/$prefix, gateway $gw trên card $($n.Alias)?" +
            "`nThao tác có thể ngắt mạng. Không dùng khi đang remote." +
            "`nNếu IP do DHCP cấp, nên giữ chỗ IP này trên router."
        ))) { return }

        Network-Backup $n.Index

        $oldDns = @(
            (Get-DnsClientServerAddress `
                -InterfaceIndex $n.Index `
                -AddressFamily IPv4).ServerAddresses
        )

        # netsh thay địa chỉ chính; không dùng nhánh này khi card có nhiều IP.
        $output = & "$env:SystemRoot\System32\netsh.exe" `
            interface ipv4 set address `
            name="$($n.Alias)" source=static `
            address="$ip" `
            mask=(
                [string](
                    & "$env:SystemRoot\System32\powershell.exe" `
                        -NoProfile -Command (
                            '$p=' + $prefix +
                            ';$b=([uint32]0xffffffff) -shl (32-$p);' +
                            '[string]::Join(''.'',@(' +
                            '24,16,8,0|%{($b -shr $_) -band 255}))'
                        )
                )
            ) `
            gateway="$gw" 2>&1

        if ($LASTEXITCODE -ne 0) {
            throw ('Không đặt được IP: ' + ($output | Out-String))
        }

        if ($oldDns.Count -gt 0) {
            Set-DnsClientServerAddress `
                -InterfaceIndex $n.Index `
                -ServerAddresses $oldDns
        }

        Log "Đã yêu cầu đặt IP tĩnh $ip/$prefix, gateway $gw."
        Info 'Đã gửi cấu hình IP. Hãy kiểm tra lại kết nối mạng.'
    }
    Cell $overview $staticButton 0 5

    $dhcpButton = Button 'Trả IP / DNS tự động' {
        $index = $script:lastIndex

        if ($null -eq $index) {
            $index = (Active-Network).Index
        }

        $adapter = Get-NetAdapter -InterfaceIndex $index `
            -ErrorAction Stop

        if (-not (Ask (
            "Trả IP và DNS về DHCP trên card $($adapter.Name)?" +
            "`nKhông dùng khi đang remote."
        ))) { return }

        Network-Backup $index

        $out = & "$env:SystemRoot\System32\netsh.exe" `
            interface ipv4 set address `
            name="$($adapter.Name)" source=dhcp 2>&1

        if ($LASTEXITCODE -ne 0) {
            throw ('Không bật được DHCP: ' + ($out | Out-String))
        }

        Set-DnsClientServerAddress -InterfaceIndex $index `
            -ResetServerAddresses

        Log "Đã yêu cầu bật DHCP trên $($adapter.Name)."
        Info 'Đã bật IP và DNS tự động. Chờ máy nhận IP rồi bấm Lấy IP hiện tại.'
    } '#475569'
    Cell $overview $dhcpButton 1 5

    $manualButton = Button 'Mở cấu hình mạng' {
        Start-Process 'ncpa.cpl'
    } '#475569'
    Cell $overview $manualButton 2 5

    $wifiButton = Button 'Ưu tiên Wi-Fi 5 GHz' {
        $n = Active-Network

        if (-not (Wifi-Card $n.Adapter)) {
            throw 'Đường mạng chính hiện không phải Wi-Fi.'
        }

        $properties = @(
            Get-NetAdapterAdvancedProperty `
                -Name $n.Alias `
                -ErrorAction Stop
        )

        $matches = @(
            $properties | Where-Object {
                $_.DisplayName -match
                    '(?i)preferred\s*band|band\s*preference|ưu tiên.*băng'
            }
        )

        if ($matches.Count -ne 1) {
            throw (
                'Driver không có đúng một mục ưu tiên băng tần ' +
                'mà tool nhận diện được. Không chỉnh bừa Registry.'
            )
        }

        $property = $matches[0]
        $values = @(
            $property.ValidDisplayValues |
                Where-Object {
                    $_ -match '(?i)prefer|ưu tiên' -and
                    $_ -match '5\s*G'
                }
        )

        if ($values.Count -ne 1) {
            throw (
                'Driver không cung cấp lựa chọn ưu tiên 5 GHz ' +
                'rõ ràng. Không thay đổi cấu hình.'
            )
        }

        if (-not (Ask (
            "Đặt '$($property.DisplayName)' thành '$($values[0])'?" +
            "`nWi-Fi có thể ngắt khi áp dụng. Không dùng lúc remote."
        ))) { return }

        $property | Select-Object `
            Name, DisplayName, DisplayValue,
            RegistryKeyword, RegistryValue |
            Export-Clixml -LiteralPath (
                Join-Path $script:session 'wifi-truoc.xml'
            )

        Set-NetAdapterAdvancedProperty `
            -Name $n.Alias `
            -DisplayName $property.DisplayName `
            -DisplayValue ([string]$values[0]) `
            -NoRestart `
            -ErrorAction Stop

        Log "Đã đặt ưu tiên 5 GHz trên $($n.Alias)."
        Info (
            'Đã lưu tùy chọn ưu tiên 5 GHz. ' +
            'Có thể cần kết nối lại Wi-Fi để có hiệu lực.'
        )
    } '#059669'
    Cell $overview $wifiButton 0 6

    $overviewNote = Label (
        'Nếu card có nhiều IPv4, chọn IP để xem; ' +
        'tool sẽ không tự xóa những IP còn lại.'
    )
    Cell $overview $overviewNote 0 7
    $overview.SetColumnSpan($overviewNote, 3)

    # ---------------- DNS ----------------

    $dnsGrid = New-Grid 2 6
    $dnsTab.Controls.Add($dnsGrid)

    Cell $dnsGrid (Label 'Nhà cung cấp DNS') 0 0

    $script:dnsChoice = New-Object System.Windows.Forms.ComboBox
    $script:dnsChoice.DropDownStyle = 'DropDownList'

    foreach ($name in @(
        'Tự nhập',
        'Cloudflare',

function Fill-CurrentIPv4 {
    param([switch]$Quiet)

    $network = Get-ActiveNetwork

    $addresses = @(
        Get-NetIPAddress -InterfaceIndex $network.Index `
            -AddressFamily IPv4 |
        Where-Object {
            $_.AddressState -eq 'Preferred' -and
            -not $_.SkipAsSource -and
            $_.IPAddress -notlike '169.254.*' -and
            $_.IPAddress -notlike '127.*'
        }
    )

    if ($addresses.Count -eq 0) {
        throw 'Card mạng hiện tại chưa có IPv4 sử dụng được.'
    }

    if ($addresses.Count -gt 1) {
        $script:networkLabel.Text =
            "Card: $($network.Alias) | Có nhiều IPv4: " +
            (($addresses.IPAddress) -join ', ')

        throw 'Card có nhiều IPv4. Hãy kiểm tra và nhập IP cần giữ, tool không tự chọn.'
    }

    $address = $addresses[0]

    $script:ipBox.Text = $address.IPAddress
    $script:prefixBox.Text = [string]$address.PrefixLength
    $script:gatewayBox.Text = $network.Gateway

    $script:networkLabel.Text = (
        'Card: {0} | IP hiện tại: {1}/{2} | Gateway: {3}' -f
        $network.Alias,
        $address.IPAddress,
        $address.PrefixLength,
        $network.Gateway
    )

    if (-not $Quiet) {
        Write-Log (
            "Đã điền IP hiện tại: $($address.IPAddress)" +
            "/$($address.PrefixLength), gateway $($network.Gateway)."
        )
        Write-Log 'Chưa đổi cấu hình. Bấm Đặt IP tĩnh nếu muốn áp dụng.'
    }
}


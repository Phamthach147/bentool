    }

    Cell $dnsGrid $script:dnsChoice 1 0

    $script:dns1 = Input
    $script:dns2 = Input

    Cell $dnsGrid (Label 'DNS chính') 0 1
    Cell $dnsGrid $script:dns1 1 1
    Cell $dnsGrid (Label 'DNS phụ') 0 2
    Cell $dnsGrid $script:dns2 1 2

    $script:dnsChoice.Add_SelectedIndexChanged({
        $script:dns1.Clear()
        $script:dns2.Clear()

        switch ([string]$script:dnsChoice.SelectedItem) {
            'Cloudflare' {
                $script:dns1.Text = '1.1.1.1'
                $script:dns2.Text = '1.0.0.1'
            }
            'Google' {
                $script:dns1.Text = '8.8.8.8'
                $script:dns2.Text = '8.8.4.4'
            }
        }

        $editable = (
            [string]$script:dnsChoice.SelectedItem -notin
            @('Nhanh nhất', 'Tự động (DHCP)')
        )

        $script:dns1.Enabled = $editable
        $script:dns2.Enabled = $editable
    })

    $script:dnsChoice.SelectedIndex = 0

    function Measure-DNS {
        $results = @()

        foreach ($provider in @(
            [pscustomobject]@{
                Name = 'Cloudflare'
                IP = '1.1.1.1'
                Secondary = '1.0.0.1'
            },
            [pscustomobject]@{
                Name = 'Google'
                IP = '8.8.8.8'
                Secondary = '8.8.4.4'
            }
        )) {
            $times = @()

            foreach ($hostName in @(
                'www.microsoft.com',
                'www.github.com',
                'www.wikipedia.org'
            )) {
                $watch = [System.Diagnostics.Stopwatch]::StartNew()

                try {
                    $answer = @(
                        Resolve-DnsName `
                            -Name $hostName `
                            -Type A `
                            -Server $provider.IP `
                            -DnsOnly `
                            -NoHostsFile `
                            -QuickTimeout `
                            -ErrorAction Stop
                    )

                    $watch.Stop()

                    if ($answer | Where-Object IPAddress) {
                        $times += $watch.Elapsed.TotalMilliseconds
                    }
                }
                catch {
                    $watch.Stop()
                }
            }

            if ($times.Count -gt 0) {
                $average = ($times |
                    Measure-Object -Average).Average

                $results += [pscustomobject]@{
                    Name = $provider.Name
                    Servers = @(
                        $provider.IP,
                        $provider.Secondary
                    )
                    Success = $times.Count
                    Average = [double]$average
                }

                Log (
                    '{0}: {1}/3 lượt, trung bình {2:N1} ms' -f
                    $provider.Name, $times.Count, $average
                )
            }
        }

        $winner = $results |
            Where-Object { $_.Success -ge 2 } |
            Sort-Object `
                @{ Expression = 'Success'; Descending = $true },
                @{ Expression = 'Average'; Descending = $false } |
            Select-Object -First 1

        if (-not $winner) {
            throw 'Đo DNS không đủ kết quả. DNS hiện tại không đổi.'
        }

        return $winner
    }

    $applyDns = Button 'Áp dụng DNS' {
        $n = Active-Network
        $choice = [string]$script:dnsChoice.SelectedItem

        if (-not (Ask (
            "Đổi DNS trên card $($n.Alias)?" +
            "`nDNS nội bộ của công ty hoặc VPN có thể bị ảnh hưởng."
        ))) { return }

        $servers = @()
        $winner = $null

        if ($choice -eq 'Nhanh nhất') {
            $winner = Measure-DNS
            $servers = $winner.Servers
        }
        elseif ($choice -ne 'Tự động (DHCP)') {
            if (-not $script:dns1.Text.Trim()) {
                throw 'Hãy nhập DNS chính.'
            }

            $servers = @(
                $script:dns1.Text.Trim(),
                $script:dns2.Text.Trim()
            ) | Where-Object { $_ }

            foreach ($server in $servers) {
                $null = IPv4 $server
            }
        }

        if ((Active-Network).Index -ne $n.Index) {
            throw 'Đường mạng đã thay đổi. Chưa áp dụng DNS.'
        }

        Network-Backup $n.Index

        if ($choice -eq 'Tự động (DHCP)') {
            Set-DnsClientServerAddress `
                -InterfaceIndex $n.Index `
                -ResetServerAddresses

            Log 'Đã trả DNS về tự động.'
            Info 'Đã trả DNS về tự động.'
        }
        else {
            Set-DnsClientServerAddress `
                -InterfaceIndex $n.Index `
                -ServerAddresses $servers

            $script:dns1.Text = $servers[0]

            if ($servers.Count -gt 1) {
                $script:dns2.Text = $servers[1]
            }

            Log ('Đã đặt DNS: ' + ($servers -join ', '))

            if ($winner) {
                Info (
                    "Đã chọn $($winner.Name)." +
                    "`nPhản hồi trung bình: " +
                    ('{0:N1} ms' -f $winner.Average) +
                    "`nKết quả chỉ phản ánh lượt đo vừa thực hiện."
                )
            }
            else {
                Info ('Đã đặt DNS: ' + ($servers -join ', '))
            }
        }

        Clear-DnsClientCache
    }
    Cell $dnsGrid $applyDns 0 3
    $dnsGrid.SetColumnSpan($applyDns, 2)

    $dnsNote = Label (
        '“Nhanh nhất” so thời gian trả lời DNS, ' +
        'không đo tốc độ tải Internet.'
    )
    Cell $dnsGrid $dnsNote 0 4
    $dnsGrid.SetColumnSpan($dnsNote, 2)

    # ---------------- PING ----------------

    $pingGrid = New-Grid 2 5
    $pingTab.Controls.Add($pingGrid)

    Cell $pingGrid (Label 'IP thiết bị cần kiểm tra') 0 0
    $script:pingInput = Input '192.168.1.1'
    Cell $pingGrid $script:pingInput 1 0

    $pingButton = Button 'Ping 4 lượt' {
        $target = $script:pingInput.Text.Trim()
        $address = IPv4 $target

        $pinger = New-Object System.Net.NetworkInformation.Ping
        $received = 0

        try {
            Log "Ping $target:"

            for ($i = 1; $i -le 4; $i++) {
                try {
                    $reply = $pinger.Send($address, 1000)

                    if (
                        $reply.Status -eq
                        [System.Net.NetworkInformation.IPStatus]::Success
                    ) {
                        $received++
                        Log (
                            'Lượt {0}: có phản hồi, {1} ms' -f
                            $i, $reply.RoundtripTime
                        )
                    }
                    else {
                        Log "Lượt ${i}: không phản hồi."
                    }
                }
                catch {
                    Log "Lượt ${i}: không nhận được phản hồi."
                }
            }
        }
        finally {
            $pinger.Dispose()
        }

        Log "Kết quả: nhận $received/4 lượt."
        Info (
            "Ping $target`: nhận $received/4 lượt." +
            "`nKhông phản hồi cũng có thể do thiết bị chặn ping."
        )
    }
    Cell $pingGrid $pingButton 0 1
    $pingGrid.SetColumnSpan($pingButton, 2)

    # ---------------- TỐI ƯU ----------------

    $optGrid = New-Grid 1 5
    $optTab.Controls.Add($optGrid)

    Cell $optGrid (Label (
        'Một nút áp dụng các thiết lập Windows; ' +
        'kết quả từng bước nằm trong nhật ký.'
    )) 0 0

    function Set-Reg {
        param(
            [string]$path,
            [string]$name,
            $value,
            [string]$kind = 'DWord'
        )

        if (-not (Test-Path -LiteralPath $path)) {
            New-Item -Path $path -Force | Out-Null
        }

        $key = Get-Item -LiteralPath $path
        $type = [Enum]::Parse(
            [Microsoft.Win32.RegistryValueKind],
            $kind
        )

        $key.SetValue($name, $value, $type)
    }

    function Tweak-Step {
        param([string]$name, [scriptblock]$action)

        try {
            & $action
            Log "Đã chạy: $name"
        }
        catch {
            Log "Không hoàn tất $name`: $($_.Exception.Message)"
        }
    }

    $optButton = Button 'Áp dụng tối ưu mặc định' {
        if (-not (Ask (
            "Sẽ thay đổi cài đặt Windows, dọn TEMP và thử gỡ " +
            "OneDrive/Widgets." +
            "`nHãy sao lưu dữ liệu trước. Tiếp tục?"
        ))) { return }

        try {
            Checkpoint-Computer `
                -Description 'Truoc Toi Uu CUKCUK' `
                -RestorePointType MODIFY_SETTINGS `
                -ErrorAction Stop

            Log 'Đã gửi yêu cầu tạo điểm khôi phục.'
        }
        catch {
            Log (
                'Không tạo được điểm khôi phục: ' +
                $_.Exception.Message
            )

            if (-not (Ask (
                'Không tạo được điểm khôi phục. Vẫn tiếp tục?'
            ))) { return }
        }

        Tweak-Step 'Tắt lịch sử hoạt động' {
            $p = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\System'
            Set-Reg $p 'EnableActivityFeed' 0
            Set-Reg $p 'PublishUserActivities' 0
            Set-Reg $p 'UploadUserActivities' 0
        }

        Tweak-Step 'Giảm nội dung ứng dụng gợi ý' {
            Set-Reg `
                'HKLM:\SOFTWARE\Policies\Microsoft\Windows\CloudContent' `
                'DisableWindowsConsumerFeatures' 1
        }

        Tweak-Step 'Tắt chia sẻ tải xuống ngang hàng' {
            Set-Reg `
                'HKLM:\SOFTWARE\Policies\Microsoft\Windows\DeliveryOptimization' `
                'DODownloadMode' 0
        }

        Tweak-Step 'Bật Kết thúc tác vụ trên taskbar nếu hỗ trợ' {
            $build = [int](
                Get-ItemProperty `
                    'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion'
            ).CurrentBuildNumber

            if ($build -ge 22621) {
                Set-Reg `
                    'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced\TaskbarDeveloperSettings' `
                    'TaskbarEndTask' 1
            }
            else {
                Log 'Bỏ qua Kết thúc tác vụ: Windows chưa hỗ trợ.'
            }
        }

        Tweak-Step 'Tắt tự đoán loại thư mục' {
            Set-Reg `
                'HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\Bags\AllFolders\Shell' `
                'FolderType' 'NotSpecified' 'String'
        }

        Tweak-Step 'Tắt vị trí qua chính sách' {
            $p = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\LocationAndSensors'
            Set-Reg $p 'DisableLocation' 1
            Set-Reg $p 'DisableWindowsLocationProvider' 1
        }

        Tweak-Step 'Giảm đề xuất trong ô tìm kiếm' {
            Set-Reg `
                'HKCU:\Software\Policies\Microsoft\Windows\Explorer' `
                'DisableSearchBoxSuggestions' 1
        }

        Tweak-Step 'Giảm dữ liệu chẩn đoán theo chính sách' {
            Set-Reg `
                'HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection' `
                'AllowTelemetry' 0
        }

        Tweak-Step 'Chuyển một số dịch vụ nền sang Manual' {
            $names = @(
                'MapsBroker', 'WerSvc', 'SysMain', 'TrkWks'
            )

            $previous = foreach ($name in $names) {
                $service = Get-CimInstance Win32_Service `
                    -Filter "Name='$name'"

                if ($service) {
                    [pscustomobject]@{
                        Name = $name
                        StartMode = $service.StartMode
                    }
                }
            }

            @($previous) | Export-Clixml -LiteralPath (
                Join-Path $script:session 'dich-vu-truoc.xml'
            )

            foreach ($name in $names) {
                if (Get-Service $name -ErrorAction SilentlyContinue) {
                    Set-Service $name -StartupType Manual
                }
            }
        }

        Tweak-Step 'Dọn tệp TEMP cũ hơn 7 ngày' {
            $count = 0
            $cutoff = (Get-Date).AddDays(-7)

            foreach ($item in @(
                Get-ChildItem -LiteralPath $env:TEMP `
                    -File -Recurse -Force `
                    -ErrorAction SilentlyContinue
            )) {
                if ($item.LastWriteTime -lt $cutoff) {
                    try {
                        Remove-Item -LiteralPath $item.FullName `
                            -Force -ErrorAction Stop
                        $count++
                    }
                    catch {}
                }
            }

            Log "Đã xóa $count tệp TEMP."
        }

        Tweak-Step 'Gỡ Widgets của tài khoản hiện tại' {
            Get-AppxPackage `
                -Name 'MicrosoftWindows.Client.WebExperience' |
                ForEach-Object {
                    Remove-AppxPackage `
                        -Package $_.PackageFullName `
                        -ErrorAction Stop
                }
        }

        Tweak-Step 'Vô hiệu hóa WPBT' {
            Set-Reg `
                'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager' `
                'DisableWpbtExecution' 1
        }

        Tweak-Step 'Bật menu chuột phải kiểu cũ trên Windows 11' {
            Set-Reg `
                'HKCU:\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32' `
                '' '' 'String'
        }

        Tweak-Step 'Tắt chính sách Copilot và Recall' {
            Set-Reg `
                'HKCU:\Software\Policies\Microsoft\Windows\WindowsCopilot' `
                'TurnOffWindowsCopilot' 1

            Set-Reg `
                'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsAI' `
                'DisableAIDataAnalysis' 1
        }

        Log (
            'Bỏ qua Start Menu kiểu cũ và việc gỡ toàn bộ AI: ' +
            'không có cách chung đáng tin cậy cho mọi bản Windows.'
        )
        Log (
            'Không tự gỡ OneDrive trong bản này để tránh mất ' +
            'dữ liệu chưa đồng bộ.'
        )
        Log 'Đã chạy xong. Xem nhật ký và khởi động lại khi thuận tiện.'
        Info 'Đã chạy xong các bước tối ưu. Xem nhật ký để biết mục bị bỏ qua.'
    }
    Cell $optGrid $optButton 0 1

    $restoreButton = Button 'Mở điểm khôi phục Windows' {
        Start-Process 'SystemPropertiesProtection.exe'
    } '#475569'
    Cell $optGrid $restoreButton 0 2

    # ---------------- BẢO MẬT ----------------

    $secGrid = New-Grid 2 5
    $securityTab.Controls.Add($secGrid)

    Cell $secGrid (Label (
        'Quản lý ba loại tường lửa và mở cài đặt Defender.'
    )) 0 0
    $secGrid.SetColumnSpan(
        $secGrid.Controls[$secGrid.Controls.Count - 1], 2
    )

    $firewallOff = Button 'Tắt 3 tường lửa' {
        if (-not (Ask (
            'Tắt Domain, Private và Public sẽ giảm bảo vệ máy. Tiếp tục?'
        ))) { return }

        Get-NetFirewallProfile |
            Select-Object Name, Enabled |
            Export-Clixml -LiteralPath (
                Join-Path $script:session 'firewall-truoc.xml'
            )

        Set-NetFirewallProfile `
            -Profile Domain,Private,Public `
            -Enabled False

        Log 'Đã yêu cầu tắt cả 3 tường lửa.'
    } '#B91C1C'
    Cell $secGrid $firewallOff 0 1

    $firewallOn = Button 'Bật 3 tường lửa' {
        Set-NetFirewallProfile `
            -Profile Domain,Private,Public `
            -Enabled True

        Log 'Đã bật cả 3 tường lửa.'
    } '#059669'
    Cell $secGrid $firewallOn 1 1

    $defenderButton = Button 'Mở Real-time protection' {
        Start-Process 'windowsdefender://threatsettings'

        Log (
            'Đã yêu cầu mở cài đặt Defender. Nếu chưa đúng trang, ' +
            'chọn Virus & threat protection > Manage settings.'
        )
    }
    Cell $secGrid $defenderButton 0 2
    $secGrid.SetColumnSpan($defenderButton, 2)

    # ---------------- SAO LƯU / SQL ----------------

    $otherGrid = New-Grid 1 5
    $otherTab.Controls.Add($otherGrid)

    $backupButton = Button 'Mở thư mục sao lưu / nhật ký' {
        Start-Process explorer.exe `
            -ArgumentList ('"{0}"' -f $script:session)
    }
    Cell $otherGrid $backupButton 0 0

    Cell $otherGrid (Label (
        'SQL Server 2005 là bản cũ; tool không tự tải bộ cài không rõ gói.'
    )) 0 1

    $sqlButton = Button 'Tìm SQL 2005 từ Microsoft' {
        Start-Process (
            'https://www.catalog.update.microsoft.com/Search.aspx?' +
            'q=SQL+Server+2005+Express'
        )

        Log (
            'Đã mở Microsoft Update Catalog. ' +
            'Không coi gói cập nhật là bộ cài mới.'
        )
    } '#475569'
    Cell $otherGrid $sqlButton 0 2

    # ---------------- KHỞI ĐỘNG GIAO DIỆN ----------------

    $script:form.Add_FormClosing({
        param($sender, $eventArgs)
        if ($script:busy) {
            $eventArgs.Cancel = $true
        }
    })

    Log 'Tối Ưu CUKCUK đã mở; chưa thay đổi cài đặt hệ thống.'
    Log "Sao lưu phiên này: $script:session"

    try {
        Refresh-Network
    }
    catch {
        $script:connectionInfo.Text =
            'Chưa đọc được mạng. Bấm Lấy IP hiện tại để thử lại.'
        Log ('Nhận diện mạng: ' + $_.Exception.Message)
    }

    try {
        [void]$script:form.ShowDialog()
    }
    finally {
        $script:form.Dispose()
    }
}

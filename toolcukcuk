$signature.Text = (
    "Tạo bởi`r`n" +
    "Phạm Ngọc Thạch đẹp trai`r`n" +
    "- ONB GPBL HCM"
)
$signature.SetBounds(18, 650, 195, 112)
$signature.ForeColor = Color '#86CFFF'
$signature.Font = New-Object Drawing.Font(
    'Segoe UI', 10, [Drawing.FontStyle]::Bold
)
$signature.TextAlign = 'MiddleCenter'
$sidebar.Controls.Add($signature)

# ---------- Cửa sổ vừa màn hình, màn nhỏ có thanh cuộn ----------

# Giữ bố cục gốc trong một vùng cuộn để không cắt mất nút.
$canvas = New-Object Windows.Forms.Panel
$canvas.Location = New-Object Drawing.Point(0, 0)
$canvas.Size = New-Object Drawing.Size(1100, 790)
$canvas.BackColor = $script:bg

$originalControls = @($script:form.Controls)

foreach ($control in $originalControls) {
    $canvas.Controls.Add($control)
}

$viewport = New-Object Windows.Forms.Panel
$viewport.Dock = 'Fill'
$viewport.AutoScroll = $true
$viewport.BackColor = $script:bg
$viewport.Controls.Add($canvas)
$script:form.Controls.Add($viewport)

$script:form.FormBorderStyle = 'Sizable'
$script:form.MaximizeBox = $true

# Không đặt MinimumSize lớn, tránh vượt màn POS nhỏ.
$script:form.MinimumSize = New-Object Drawing.Size(320, 240)

$script:form.Add_Shown({
    $work = [Windows.Forms.Screen]::FromControl(
        $script:form
    ).WorkingArea

    $script:form.WindowState = 'Normal'

    $width = [Math]::Min(
        $script:form.Width,
        [Math]::Max(320, $work.Width - 24)
    )

    $height = [Math]::Min(
        $script:form.Height,
        [Math]::Max(240, $work.Height - 24)
    )

    $script:form.Size = New-Object Drawing.Size(
        [int]$width, [int]$height
    )

    $script:form.Location = New-Object Drawing.Point(
        [int]($work.Left + ($work.Width - $script:form.Width) / 2),
        [int]($work.Top + ($work.Height - $script:form.Height) / 2)
    )
})

    $script:form.Add_FormClosing({
        param($sender, $eventArgs)

        if ($script:busy) {
            $eventArgs.Cancel = $true
        }
    })

    Select-Page 0

    Log 'BEN OPTIMIZER 2.0: bản giao diện thanh danh mục bên trái.'
    Log 'Chưa áp dụng thay đổi hệ thống nào.'
    Log "Windows build: $script:build"
    Log "Thư mục sao lưu: $script:session"

    try {
        Fill-CurrentIP -Quiet
        Log 'Đã tự điền IP, prefix và gateway hiện tại.'
    }
    catch {
        $script:networkInfo.Text = 'Chưa tự nhận được IP. Bấm Lấy IP hiện tại.'
        Log ('Đọc mạng: ' + $_.Exception.Message)
    }

    try {
        [void]$script:form.ShowDialog()
    }
    finally {
        $script:form.Dispose()
    }
}

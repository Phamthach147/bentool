        }
    }
})

# Xử lý nút đo nhanh nhất DNS
$btnMeasureFastest.Add_Click({
    $btnMeasureFastest.Enabled = $false
    $lblMeasureResult.Text = "Đang đo DNS nhanh nhất, vui lòng chờ..."
    Start-AsyncTask -task {
        # Đo DNS Google và Cloudflare qua 3 domain xen kẽ
        $dnsList = @("8.8.8.8","8.8.4.4","1.1.1.1","1.0.0.1")
        $domains = @("microsoft.com","google.com","cloudflare.com")
        $results = Measure-DNSLatency -dnsServers $dnsList -domains $domains -timeoutMs 2000
        return $results
    } -onComplete {
        $results = $results | Sort-Object Errors, AvgLatencyMs
        if ($results.Count -eq 0) {
            $lblMeasureResult.Text = "Không đo được DNS nhanh nhất."
        } else {
            $best = $results[0]
            $providerName = ""
            if ($best.DNS -in @("8.8.8.8","8.8.4.4")) { $providerName = "Google" }
            elseif ($best.DNS -in @("1.1.1.1","1.0.0.1")) { $providerName = "Cloudflare" }
            else { $providerName = "Không xác định" }
            $lblMeasureResult.Text = "DNS nhanh nhất: $($best.DNS) ($providerName), trung bình $($best.AvgLatencyMs) ms, lỗi $($best.Errors)"
            $tbDNSPrimary.Text = $best.DNS
            $tbDNSSecondary.Text = ""
        }
        $btnMeasureFastest.Enabled = $true
    }
})

# Xử lý nút áp dụng DNS
$btnApplyDNS.Add_Click({
    $sel = $cbDNSProvider.SelectedItem
    $dnsPrimary = $tbDNSPrimary.Text.Trim()
    $dnsSecondary = $tbDNSSecondary.Text.Trim()
    $dnsServers = @()
    if ($sel -eq "Tự nhập") {
        if (-not (Test-IPv4 $dnsPrimary)) {
            [System.Windows.Forms.MessageBox]::Show("DNS chính không hợp lệ.","Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
            return
        }
        if ($dnsSecondary -ne "" -and -not (Test-IPv4 $dnsSecondary)) {
            [System.Windows.Forms.MessageBox]::Show("DNS phụ không hợp lệ.","Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
            return
        }
        $dnsServers = @($dnsPrimary)
        if ($dnsSecondary -ne "") { $dnsServers += $dnsSecondary }
    } elseif ($sel -eq "Tự động DHCP") {
        # Đặt DNS tự động DHCP cho tất cả interface
        $confirm = [System.Windows.Forms.MessageBox]::Show("Bạn chắc chắn muốn đặt DNS tự động DHCP cho tất cả giao diện?","Xác nhận",[System.Windows.Forms.MessageBoxButtons]::YesNo,[System.Windows.Forms.MessageBoxIcon]::Warning)
        if ($confirm -ne [System.Windows.Forms.DialogResult]::Yes) { return }
        Set-BusyState -busy $true -controls @($btnApplyDNS, $cbDNSProvider, $tbDNSPrimary, $tbDNSSecondary, $btnMeasureFastest)
        Start-AsyncTask -task {
            $interfaces = Get-NetworkInterfaces
            foreach ($iface in $interfaces) {
                Set-DnsClientServerAddress -InterfaceAlias $iface.InterfaceAlias -ResetServerAddresses -ErrorAction SilentlyContinue
            }
        } -onComplete {
            Set-BusyState -busy $false -controls @($btnApplyDNS, $cbDNSProvider, $tbDNSPrimary, $tbDNSSecondary, $btnMeasureFastest)
            [System.Windows.Forms.MessageBox]::Show("Đã đặt DNS tự động DHCP cho tất cả giao diện.","Thông báo",[System.Windows.Forms.MessageBoxButtons]::OK,[System.Windows.Forms.MessageBoxIcon]::Information)
        }
        return
    } else {
        # Các provider khác
        $provider = $dnsProviders | Where-Object { $_.Name -eq $sel }
        if ($provider) {
            $dnsServers = $provider.Servers | Where-Object { $_ -ne "" }
        }
    }
    if ($dnsServers.Count -eq 0) {
        [System.Windows.Forms.MessageBox]::Show("Không có DNS hợp lệ để áp dụng.","Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
        return
    }
    $confirm = [System.Windows.Forms.MessageBox]::Show("Bạn chắc chắn muốn áp dụng DNS cho tất cả giao diện?","Xác nhận",[System.Windows.Forms.MessageBoxButtons]::YesNo,[System.Windows.Forms.MessageBoxIcon]::Warning)
    if ($confirm -ne [System.Windows.Forms.DialogResult]::Yes) { return }
    Set-BusyState -busy $true -controls @($btnApplyDNS, $cbDNSProvider, $tbDNSPrimary, $tbDNSSecondary, $btnMeasureFastest)
    Start-AsyncTask -task {
        $interfaces = Get-NetworkInterfaces
        foreach ($iface in $interfaces) {
            Set-DnsClientServerAddress -InterfaceAlias $iface.InterfaceAlias -ServerAddresses $dnsServers -ErrorAction SilentlyContinue
        }
    } -onComplete {
        Set-BusyState -busy $false -controls @($btnApplyDNS, $cbDNSProvider, $tbDNSPrimary, $tbDNSSecondary, $btnMeasureFastest)
        [System.Windows.Forms.MessageBox]::Show("Đã áp dụng DNS cho tất cả giao diện.","Thông báo",[System.Windows.Forms.MessageBoxButtons]::OK,[System.Windows.Forms.MessageBoxIcon]::Information)
    }
})


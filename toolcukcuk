                    $key = Get-Item -LiteralPath $r.Path
                    $kind = [Enum]::Parse(
                        [Microsoft.Win32.RegistryValueKind],
                        [string]$r.Kind
                    )

                    $key.SetValue([string]$r.Name, $r.Value, $kind)
                }
                elseif (Test-Path -LiteralPath $r.Path) {
                    $key = Get-Item -LiteralPath $r.Path
                    $key.DeleteValue([string]$r.Name, $false)
                }
            }

            Log 'Đã khôi phục các giá trị Registry trong file.'
            Notice 'Đã khôi phục Registry. Một số thay đổi cần khởi động lại.'

    function Active-Network {
        $candidates = @(
            foreach ($route in @(
                Get-NetRoute -AddressFamily IPv4 `
                    -DestinationPrefix '0.0.0.0/0' `
                    -PolicyStore ActiveStore
            )) {
                $adapter = Get-NetAdapter `
                    -InterfaceIndex $route.InterfaceIndex `
                    -ErrorAction SilentlyContinue

                if (-not $adapter -or $adapter.Status -ne 'Up') {
                    continue
                }

                $ipInterface = Get-NetIPInterface `
                    -InterfaceIndex $route.InterfaceIndex `
                    -AddressFamily IPv4 `
                    -ErrorAction SilentlyContinue

                if (-not $ipInterface) { continue }

                [pscustomobject]@{
                    Index = [int]$route.InterfaceIndex
                    Alias = [string]$adapter.Name
                    Gateway = [string]$route.NextHop
                    Score = (
                        [int]$route.RouteMetric +
                        [int]$ipInterface.InterfaceMetric
                    )
                    Adapter = $adapter
                }
            }
        )

        if ($candidates.Count -eq 0) {
            throw 'Không tìm thấy card đang dùng có gateway IPv4.'
        }

        $ordered = @($candidates | Sort-Object Score)
        $ties = @(
            $ordered |
                Where-Object {
                    $_.Score -eq $ordered[0].Score
                } |
                Select-Object -ExpandProperty Index -Unique
        )

        if ($ties.Count -gt 1) {
            throw 'Có nhiều đường mạng cùng ưu tiên. Hãy kiểm tra VPN/card phụ.'
        }

        $script:lastIndex = $ordered[0].Index
        return $ordered[0]
    }

    function IPv4 {
        param([string]$value)

        $parsed = $null

        if (
            $value -notmatch '^\d{1,3}(\.\d{1,3}){3}$' -or
            -not [System.Net.IPAddress]::TryParse(
                $value, [ref]$parsed
            ) -or
            $parsed.AddressFamily -ne
                [System.Net.Sockets.AddressFamily]::InterNetwork
        ) {
            throw "IPv4 không hợp lệ: $value"
        }

        return $parsed
    }

    function Network-Backup {
        param([int]$index)

        $file = Join-Path $script:session (
            'mang-{0}-{1}.xml' -f
            $index, (Get-Date -Format 'HHmmss-fff')
        )

        [pscustomobject]@{
            Index = $index
            IP = @(Get-NetIPAddress -InterfaceIndex $index)
            Route = @(Get-NetRoute -InterfaceIndex $index)
            DNS = @(Get-DnsClientServerAddress -InterfaceIndex $index)
            Interface = @(Get-NetIPInterface -InterfaceIndex $index)
        } | Export-Clixml -LiteralPath $file

        Log "Đã ghi cấu hình mạng tham khảo: $file"
    }

    function Wifi-Card {
        param($adapter)

        return (
            [int]$adapter.NdisPhysicalMedium -eq 9 -or
            [int]$adapter.InterfaceType -eq 71
        )
    }

    function Wifi-Details {
        $result = [ordered]@{
            SSID = 'Chưa xác định'
            Band = 'Chưa xác định'
            Signal = 'Chưa xác định'
        }

        try {
            $raw = & "$env:SystemRoot\System32\netsh.exe" `
                wlan show interfaces 2>&1

            foreach ($line in @($raw)) {
                $s = [string]$line

                if ($s -match '^\s*SSID\s*:\s*(.+)$' -and
                    $s -notmatch 'BSSID') {
                    $result.SSID = $Matches[1].Trim()
                }

                if ($s -match
                    '^\s*(Band|Băng tần)\s*:\s*(.+)$') {
                    $result.Band = $Matches[2].Trim()
                }

                if ($s -match
                    '^\s*(Signal|Tín hiệu)\s*:\s*(.+)$') {
                    $result.Signal = $Matches[2].Trim()
                }
            }
        }
        catch {}

        return [pscustomobject]$result
    }


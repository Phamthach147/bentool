    $tbPingResult.Text = ""
    $lblPingStats.Text = ""
    Start-AsyncTask -task {
        $pingResult = Ping-IPv4 -ip $ip -count 4 -timeout 1000
        return $pingResult
    } -onComplete {
        $text = ""
        for ($i=0; $i -lt 4; $i++) {
            $rtt = $pingResult.Results[$i]
            if ($rtt -ne $null) {
                $text += "Ping lần $($i+1): $rtt ms`r`n"
            } else {
                $text += "Ping lần $($i+1): Không phản hồi`r`n"
            }
        }
        $tbPingResult.Text = $text
        $stats = "Nhận: $($pingResult.Received), Mất: $($pingResult.Lost)"
        if ($pingResult.Received -gt 0) {
            $stats += ", Min: $($pingResult.Min) ms, Max: $($pingResult.Max) ms, Avg: $([math]::Round($pingResult.Avg,2)) ms"
        }
        $lblPingStats.Text = $stats
        $btnStartPing.Enabled = $true
    }
})


Add-Button $networkPage 'Ping 4 lượt' 398 786 {
    $target = $script:cukcukPingInput.Text.Trim()

    # Chỉ chấp nhận IPv4, không ghép dữ liệu nhập vào câu lệnh shell.
    $parsed = $null

    if (
        $target -notmatch '^\d{1,3}(\.\d{1,3}){3}$' -or
        -not [Net.IPAddress]::TryParse( $target, [ref]$parsed)
    ) {
        throw 'Nhập IPv4 hợp lệ, ví dụ 192.168.1.100.'
    }

    if ( $parsed.AddressFamily -ne
        [Net.Sockets.AddressFamily]::InterNetwork) {
        throw 'Chức năng này nhận địa chỉ IPv4.'
    }

    $bytes = $parsed.GetAddressBytes()

    if ( $bytes[0] -eq 0 -or $bytes[0] -ge 224) {
        throw 'Hãy nhập IP của một thiết bị, không dùng multicast/broadcast.'
    }

    $ping = New-Object Net.NetworkInformation.Ping
    $received = 0
    $latencies = New-Object Collections.ArrayList

    Log "========== PING $target =========="

    try {
        for ( $i = 1; $i -le 4; $i++) {
            try {
                $reply = $ping.Send( $parsed, 1000)

                if ( $reply.Status -eq
                    [Net.NetworkInformation.IPStatus]::Success) {

                    $received++
                    [void]$latencies.Add([double]$reply.RoundtripTime)

                    Log (
                        "Lượt ${i}: Có phản hồi | " +
                        "$( $reply.RoundtripTime) ms"
                    )
                }
                else {
                    Log (
                        "Lượt ${i}: Không phản hồi | " +
                        "$( $reply.Status)"
                    )
                }
            }
            catch {
                Log (
                    "Lượt ${i}: Không gửi/nhận được | " +
                    $_.Exception.Message
                )
            }

            $script:form.Refresh()
        }

        $loss = (4 - $received) * 25
        $summary = "Nhận: $received/4 | Mất gói: $loss%"

        if ( $latencies.Count -gt 0) {
            $stats = $latencies |
                Measure-Object -Minimum -Maximum -Average

            $summary += (
                ' | Trung bình: {0:N1} ms | Min: {1:N0} ms | Max: {2:N0} ms' -f
                $stats.Average, $stats.Minimum, $stats.Maximum
            )
        }

        Log $summary
        Log 'Không phản hồi có thể do thiết bị hoặc tường lửa chặn Ping.'
    }
    finally {
        $ping.Dispose()
    }
} 350 '#377DFF'


    Add-Button $networkPage 'Đặt IP tĩnh' 24 367 {
        $ip = $script:ipInput.Text.Trim()
        $gateway = $script:gatewayInput.Text.Trim()

        $ipObject = Validate-IP $ip
        $gatewayObject = Validate-IP $gateway

        $prefix = 0
        if (-not [int]::TryParse(
            $script:prefixInput.Text.Trim(), [ref]$prefix
        ) -or $prefix -lt 1 -or $prefix -gt 30) {
            throw 'Nhập prefix từ 1 đến 30, thông thường là 24.'
        }

        $ipBytes = $ipObject.GetAddressBytes()
        $gwBytes = $gatewayObject.GetAddressBytes()

        if ($ipBytes[0] -eq 0 -or $ipBytes[0] -eq 127 -or
            $ipBytes[0] -ge 224 -or
            $gwBytes[0] -eq 0 -or $gwBytes[0] -eq 127 -or
            $gwBytes[0] -ge 224) {
            throw 'IP hoặc gateway không phải địa chỉ unicast phù hợp.'
        }

        $remaining = $prefix
        $networkAddress = $true
        $broadcastAddress = $true
        $gatewayNetwork = $true
        $gatewayBroadcast = $true

        for ($i = 0; $i -lt 4; $i++) {
            $used = [Math]::Min(8, [Math]::Max(0, $remaining))

            $mask = 0
            if ($used -gt 0) {
                $mask = (255 -shl (8 - $used)) -band 255
            }

            $hostMask = 255 -bxor $mask

            if (($ipBytes[$i] -band $mask) -ne
                ($gwBytes[$i] -band $mask)) {
                throw 'IP và gateway không cùng subnet.'
            }

            $ipHost = $ipBytes[$i] -band $hostMask
            $gwHost = $gwBytes[$i] -band $hostMask

            if ($ipHost -ne 0) { $networkAddress = $false }
            if ($ipHost -ne $hostMask) { $broadcastAddress = $false }
            if ($gwHost -ne 0) { $gatewayNetwork = $false }
            if ($gwHost -ne $hostMask) { $gatewayBroadcast = $false }

            $remaining -= 8
        }

        if ($networkAddress -or $broadcastAddress -or
            $gatewayNetwork -or $gatewayBroadcast) {
            throw 'IP hoặc gateway là địa chỉ mạng/broadcast.'
        }

        if ($ip -eq $gateway) {
            throw 'IP máy tính không được trùng gateway.'
        }

        $n = Get-CurrentNetwork

        if (-not (Confirm (
            "Đặt IP tĩnh trên card $($n.Alias)?" +
            "`nIP: $ip/$prefix" +
            "`nGateway: $gateway" +
            "`nCó thể mất kết nối. Không làm khi đang remote." +
            "`nNếu đây là IP DHCP, cần giữ chỗ trên router để tránh trùng IP." +
            "`nTiếp tục?"
        ))) { return }

        Backup-Network $n.Index

        # Giữ DNS hiện tại trước khi chuyển từ DHCP sang IP tĩnh.
        $oldDNS = @(
            (Get-DnsClientServerAddress -InterfaceIndex $n.Index `
                -AddressFamily IPv4).ServerAddresses
        )

        try {
            Set-NetIPInterface -InterfaceIndex $n.Index `
                -AddressFamily IPv4 -Dhcp Disabled

            Get-NetRoute -InterfaceIndex $n.Index -AddressFamily IPv4 |
                Where-Object { $_.DestinationPrefix -eq '0.0.0.0/0' } |
                Remove-NetRoute -Confirm:$false

            Get-NetIPAddress -InterfaceIndex $n.Index `
                -AddressFamily IPv4 |
                Remove-NetIPAddress -Confirm:$false

            New-NetIPAddress -InterfaceIndex $n.Index `
                -IPAddress $ip -PrefixLength $prefix `
                -DefaultGateway $gateway | Out-Null

            if ($oldDNS.Count -gt 0) {
                Set-DnsClientServerAddress -InterfaceIndex $n.Index `
                    -ServerAddresses $oldDNS
            }

            Log "Đã gửi cấu hình IP tĩnh: $ip/$prefix"
            Log 'Chưa xác nhận Internet hoặc IP có trùng máy khác hay không.'

            $script:networkInfo.Text = (
                "$($n.Alias) | IP tĩnh: $ip/$prefix | Gateway: $gateway"
            )

            Notice (
                "Đã gửi cấu hình IP tĩnh: $ip/$prefix" +
                "`nGateway: $gateway" +
                "`nHãy kiểm tra lại kết nối mạng."
            )
        }
        catch {
            Log "Cấu hình có thể đã đổi một phần trên card $($n.Alias)."
            Log 'Có thể dùng Trả IP/DNS tự động hoặc mở ncpa.cpl.'
            throw
        }
    }


# ============================================================
# HÀM TẠO TABLELAYOUTPANEL CHUẨN
# ============================================================
function New-TableLayoutPanel {
    param(
        [int]$rows,
        [int]$cols,
        [string[]]$rowStyles = @(),
        [string[]]$colStyles = @()
    )
    $tlp = New-Object System.Windows.Forms.TableLayoutPanel
    $tlp.RowCount = $rows
    $tlp.ColumnCount = $cols
    $tlp.Dock = 'Fill'
    $tlp.Margin = '0,0,0,0'
    $tlp.BackColor = $colorBack
    $tlp.ForeColor = $colorFore
    $tlp.GrowStyle = 'FixedSize'
    # Xóa styles cũ
    $tlp.RowStyles.Clear()
    $tlp.ColumnStyles.Clear()
    # Thêm row styles
    for ($i=0; $i -lt $rows; $i++) {
        if ($rowStyles.Count -gt $i) {
            $style = $rowStyles[$i]
            if ($style -match '^Percent:(\d+)$') {
                $tlp.RowStyles.Add((New-Object System.Windows.Forms.RowStyle([System.Windows.Forms.SizeType]::Percent, [float]$matches[1])))
            } elseif ($style -match '^Absolute:(\d+)$') {
                $tlp.RowStyles.Add((New-Object System.Windows.Forms.RowStyle([System.Windows.Forms.SizeType]::Absolute, [int]$matches[1])))
            } else {
                $tlp.RowStyles.Add((New-Object System.Windows.Forms.RowStyle([System.Windows.Forms.SizeType]::AutoSize)))
            }
        } else {
            $tlp.RowStyles.Add((New-Object System.Windows.Forms.RowStyle([System.Windows.Forms.SizeType]::AutoSize)))
        }
    }
    # Thêm col styles
    for ($j=0; $j -lt $cols; $j++) {
        if ($colStyles.Count -gt $j) {
            $style = $colStyles[$j]
            if ($style -match '^Percent:(\d+)$') {
                $tlp.ColumnStyles.Add((New-Object System.Windows.Forms.ColumnStyle([System.Windows.Forms.SizeType]::Percent, [float]$matches[1])))
            } elseif ($style -match '^Absolute:(\d+)$') {
                $tlp.ColumnStyles.Add((New-Object System.Windows.Forms.ColumnStyle([System.Windows.Forms.SizeType]::Absolute, [int]$matches[1])))
            } else {
                $tlp.ColumnStyles.Add((New-Object System.Windows.Forms.ColumnStyle([System.Windows.Forms.SizeType]::AutoSize)))
            }
        } else {
            $tlp.ColumnStyles.Add((New-Object System.Windows.Forms.ColumnStyle([System.Windows.Forms.SizeType]::AutoSize)))
        }
    }
    return $tlp
}

# ============================================================
# HÀM KIỂM TRA IPv4 HỢP LỆ
# ============================================================
function Test-IPv4 {
    param([string]$ip)
    if ([string]::IsNullOrWhiteSpace($ip)) { return $false }
    $parts = $ip.Split('.')
    if ($parts.Count -ne 4) { return $false }
    foreach ($p in $parts) {
        $num = 0
        if (-not ([int]::TryParse($p,[ref]$num))) { return $false }
        if ($num -lt 0 -or $num -gt 255) { return $false }
    }
    return $true
}

# ============================================================
# HÀM KIỂM TRA PREFIX HỢP LỆ (1..30)
# ============================================================
function Test-Prefix {
    param([int]$prefix)
    return ($prefix -ge 1 -and $prefix -le 30)
}

# ============================================================
# HÀM KIỂM TRA GATEWAY CÙNG MẠNG VỚI IP/PREFIX
# ============================================================
function Test-GatewayInSubnet {
    param(
        [string]$ip,
        [int]$prefix,
        [string]$gateway
    )
    if (-not (Test-IPv4 $ip)) { return $false }
    if (-not (Test-IPv4 $gateway)) { return $false }
    if (-not (Test-Prefix $prefix)) { return $false }
    # Tính network address
    $ipBytes = [System.Net.IPAddress]::Parse($ip).GetAddressBytes()
    $gwBytes = [System.Net.IPAddress]::Parse($gateway).GetAddressBytes()
    $mask = [uint32]0
    for ($i=0; $i -lt $prefix; $i++) {
        $mask = $mask -bor (1 -shl (31 - $i))
    }
    $ipInt = [System.BitConverter]::ToUInt32(($ipBytes[3],$ipBytes[2],$ipBytes[1],$ipBytes[0]),0)
    $gwInt = [System.BitConverter]::ToUInt32(($gwBytes[3],$gwBytes[2],$gwBytes[1],$gwBytes[0]),0)
    $netIp = $ipInt -band $mask
    $netGw = $gwInt -band $mask
    return ($netIp -eq $netGw)
}

# ============================================================
# HÀM LẤY DANH SÁCH INTERFACE MẠNG WI-FI/LAN/VPN
# ============================================================
function Get-NetworkInterfaces {
    # Lấy tất cả adapter vật lý đang hoạt động
    $adapters = Get-NetAdapter -Physical | Where-Object { $_.Status -eq 'Up' }
    # Lấy thêm VPN adapter (tình trạng Up)
    $vpnAdapters = Get-NetAdapter | Where-Object { $_.Status -eq 'Up' -and $_.InterfaceDescription -match 'VPN' }
    $allAdapters = $adapters + $vpnAdapters | Sort-Object -Property InterfaceAlias
    return $allAdapters
}

# ============================================================
# HÀM LẤY THÔNG TIN IP IPv4 CỦA INTERFACE
# ============================================================
function Get-IPv4Info {
    param([string]$ifAlias)
    $ips = Get-NetIPAddress -InterfaceAlias $ifAlias -AddressFamily IPv4 -ErrorAction SilentlyContinue | Where-Object { $_.PrefixLength -ge 1 -and $_.PrefixLength -le 30 }
    return $ips
}

# ============================================================
# HÀM LẤY THÔNG TIN TỔNG QUAN MẠNG WI-FI/LAN/VPN
# ============================================================
function Get-NetworkOverview {
    $interfaces = Get-NetworkInterfaces
    $list = @()
    foreach ($iface in $interfaces) {
        $ipInfos = Get-IPv4Info -ifAlias $iface.InterfaceAlias
        $ipStr = if ($ipInfos) { ($ipInfos | ForEach-Object { "$($_.IPAddress)/$($_.PrefixLength)" }) -join ", " } else { "Không có IPv4" }
        $gateway = (Get-NetRoute -InterfaceIndex $iface.ifIndex -DestinationPrefix "0.0.0.0/0" -ErrorAction SilentlyContinue | Select-Object -First 1).NextHop
        $dnsServers = (Get-DnsClientServerAddress -InterfaceIndex $iface.ifIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue).ServerAddresses
        $dnsStr = if ($dnsServers) { $dnsServers -join ", " } else { "Không có DNS" }
        $ssid = ""
        $band = ""
        $signal = ""
        # Nếu là Wi-Fi, lấy SSID, băng tần, tín hiệu
        if ($iface.InterfaceDescription -match "Wi-Fi|Wireless") {
            try {
                $wlan = netsh wlan show interfaces | Select-String -Pattern $iface.InterfaceAlias -Context 0,20
                if ($wlan) {
                    $lines = $wlan.Context.PostContext
                    foreach ($line in $lines) {
                        if ($line -match "SSID\s+:\s+(.+)") { $ssid = $matches[1].Trim() }
                        if ($line -match "Signal\s+:\s+(\d+)%") { $signal = $matches[1].Trim() }
                    }
                    # Lấy băng tần thực tế từ driver advanced property Preferred Band
                    $advProps = Get-NetAdapterAdvancedProperty -Name $iface.InterfaceAlias -ErrorAction SilentlyContinue
                    $prefBandProp = $advProps | Where-Object { $_.DisplayName -match "Preferred Band" }
                    if ($prefBandProp) {
                        $bandVal = $prefBandProp.RegistryValue
                        switch ($bandVal) {
                            "5 GHz" { $band = "5 GHz" }
                            "2.4 GHz" { $band = "2.4 GHz" }
                            "6 GHz" { $band = "6 GHz" }
                            default { $band = $bandVal }
                        }
                    }
                }
            } catch {}
        }
        $list += [PSCustomObject]@{
            InterfaceAlias = $iface.InterfaceAlias
            Description = $iface.InterfaceDescription
            Status = $iface.Status
            MACAddress = $iface.MacAddress
            IPv4 = $ipStr
            Gateway = $gateway
            DNS = $dnsStr
            SSID = $ssid
            Band = $band
            Signal = $signal
        }
    }
    return $list
}

# ============================================================
# HÀM LẤY IP HIỆN TẠI ƯU TIÊN WI-FI 5GHZ
# ============================================================
function Get-PreferredIP {
    $interfaces = Get-NetworkInterfaces
    # Ưu tiên Wi-Fi 5GHz
    foreach ($iface in $interfaces) {
        if ($iface.InterfaceDescription -match "Wi-Fi|Wireless") {
            $advProps = Get-NetAdapterAdvancedProperty -Name $iface.InterfaceAlias -ErrorAction SilentlyContinue
            $prefBandProp = $advProps | Where-Object { $_.DisplayName -match "Preferred Band" }
            if ($prefBandProp -and $prefBandProp.RegistryValue -eq "5 GHz") {
                $ip = Get-IPv4Info -ifAlias $iface.InterfaceAlias | Select-Object -First 1
                if ($ip) {
                    return @{
                        InterfaceAlias = $iface.InterfaceAlias
                        IP = $ip.IPAddress
                        Prefix = $ip.PrefixLength
                        Gateway = (Get-NetRoute -InterfaceIndex $iface.ifIndex -DestinationPrefix "0.0.0.0/0" -ErrorAction SilentlyContinue | Select-Object -First 1).NextHop
                    }
                }
            }
        }
    }
    # Nếu không có Wi-Fi 5GHz, lấy IP đầu tiên có IPv4
    foreach ($iface in $interfaces) {
        $ip = Get-IPv4Info -ifAlias $iface.InterfaceAlias | Select-Object -First 1
        if ($ip) {
            return @{
                InterfaceAlias = $iface.InterfaceAlias
                IP = $ip.IPAddress
                Prefix = $ip.PrefixLength
                Gateway = (Get-NetRoute -InterfaceIndex $iface.ifIndex -DestinationPrefix "0.0.0.0/0" -ErrorAction SilentlyContinue | Select-Object -First 1).NextHop
            }
        }
    }
    return $null
}


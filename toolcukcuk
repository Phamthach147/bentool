# Ben Optimizer
# Run in Windows PowerShell 5.1 as Administrator.
# No changes are applied until a button is clicked.

$ErrorActionPreference = 'Stop'

$identity = [Security.Principal.WindowsIdentity]::GetCurrent()
$principal = New-Object Security.Principal.WindowsPrincipal( $identity)

if (-not $principal.IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator
)) {
    Write-Host 'Hay mo Windows PowerShell bang Run as administrator.' -ForegroundColor Yellow
    return
}

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
Add-Type -AssemblyName Microsoft.VisualBasic

[System.Windows.Forms.Application]::EnableVisualStyles()

$script:backupDir = Join-Path $env:LOCALAPPDATA 'BenOptimizer\Backups'
New-Item -ItemType Directory -Path $script:backupDir -Force | Out-Null

$script:form = New-Object System.Windows.Forms.Form
$script:form.Text = 'Ben Optimizer - Windows 10 / 11'
$script:form.Size = New-Object System.Drawing.Size(780, 730)
$script:form.StartPosition = 'CenterScreen'
$script:form.Font = New-Object System.Drawing.Font('Segoe UI', 10)
$script:form.AutoScroll = $true

$script:log = New-Object System.Windows.Forms.TextBox
$script:log.Location = New-Object System.Drawing.Point(20, 480)
$script:log.Size = New-Object System.Drawing.Size(720, 190)
$script:log.Multiline = $true
$script:log.ReadOnly = $true
$script:log.ScrollBars = 'Vertical'
$script:form.Controls.Add( $script:log)

function Write-Log {
    param([string]$Text)
    $script:log.AppendText(
        ('[{0}] {1}' -f (Get-Date -Format 'HH:mm:ss'), $Text) +
        [Environment]::NewLine
    )
}

function Confirm-Action {
    param([string]$Text)
    return (
        [System.Windows.Forms.MessageBox]::Show(
            $Text,
            'Xac nhan',
            [System.Windows.Forms.MessageBoxButtons]::YesNo,
            [System.Windows.Forms.MessageBoxIcon]::Warning
        ) -eq [System.Windows.Forms.DialogResult]::Yes
    )
}

function Ask-Value {
    param([string]$Text, [string]$Default = '')
    return [Microsoft.VisualBasic.Interaction]::InputBox(
        $Text, 'Ben Optimizer', $Default
    ).Trim()
}

function Assert-IPv4 {
    param([string]$Value)
    $parsed = $null
    if (-not [System.Net.IPAddress]::TryParse( $Value, [ref]$parsed)) {
        throw "IP khong hop le: $Value"
    }
    if ( $parsed.AddressFamily -ne
        [System.Net.Sockets.AddressFamily]::InterNetwork) {
        throw "Chi nhap IPv4: $Value"
    }
}

function Add-Button {
    param(
        [string]$Text,
        [int]$X,
        [int]$Y,
        [scriptblock]$Action
    )
    $button = New-Object System.Windows.Forms.Button
    $button.Text = $Text
    $button.Location = New-Object System.Drawing.Point( $X, $Y)
    $button.Size = New-Object System.Drawing.Size(350, 42)
    $button.Tag = $Action
    $button.Add_Click({
        param( $sender, $eventArgs)
        $sender.Enabled = $false
        try {
            & $sender.Tag
        } catch {
            Write-Log ("LOI: " + $_.Exception.Message)
            [System.Windows.Forms.MessageBox]::Show(
                $_.Exception.Message, 'Loi'
            ) | Out-Null
        } finally {
            $sender.Enabled = $true
        }
    })
    $script:form.Controls.Add( $button)
}

$label = New-Object System.Windows.Forms.Label
$label.Text = 'Chon dung card mang truoc khi doi DNS / IP:'
$label.Location = New-Object System.Drawing.Point(20, 15)
$label.AutoSize = $true
$script:form.Controls.Add( $label)

$script:adapterBox = New-Object System.Windows.Forms.ComboBox
$script:adapterBox.Location = New-Object System.Drawing.Point(20, 45)
$script:adapterBox.Size = New-Object System.Drawing.Size(720, 30)
$script:adapterBox.DropDownStyle = 'DropDownList'
$script:adapterBox.DisplayMember = 'Display'
$script:form.Controls.Add( $script:adapterBox)

function Refresh-Adapters {
    $script:adapterBox.Items.Clear()
    foreach ( $adapter in @(Get-NetAdapter | Sort-Object Name)) {
        $item = [pscustomobject]@{
            Display = '{0} | {1} | index {2}' -f
                $adapter.Name, $adapter.Status, $adapter.ifIndex
            Index = [int]$adapter.ifIndex
        }
        [void]$script:adapterBox.Items.Add( $item)
    }
    if ( $script:adapterBox.Items.Count -gt 0) {
        $script:adapterBox.SelectedIndex = 0
    }
}

function Get-SelectedIndex {
    if ( $null -eq $script:adapterBox.SelectedItem) {
        throw 'Chua chon card mang.'
    }
    return [int]$script:adapterBox.SelectedItem.Index
}

function Backup-Network {
    param([int]$Index)
    $file = Join-Path $script:backupDir (
        'network-{0}-{1}.json' -f $Index,
        (Get-Date -Format 'yyyyMMdd-HHmmss-fff')
    )
    $data = [ordered]@{
        InterfaceIndex = $Index
        Interface = @(Get-NetIPInterface -InterfaceIndex $Index |
            Select-Object InterfaceAlias, AddressFamily, Dhcp)
        Addresses = @(Get-NetIPAddress -InterfaceIndex $Index |
            Select-Object IPAddress, PrefixLength, AddressFamily,
                PrefixOrigin, SuffixOrigin)
        Routes = @(Get-NetRoute -InterfaceIndex $Index |
            Select-Object DestinationPrefix, NextHop, RouteMetric,
                AddressFamily)
        DNS = @(Get-DnsClientServerAddress -InterfaceIndex $Index |
            Select-Object AddressFamily, ServerAddresses)
    }
    $data | ConvertTo-Json -Depth 6 |
        Set-Content -LiteralPath $file -Encoding UTF8
    Write-Log "Da luu cau hinh mang: $file"
}

function Set-ToolDNS {
    param([string[]]$Servers)
    foreach ( $server in $Servers) {
        Assert-IPv4 $server
    }
    $index = Get-SelectedIndex
    Backup-Network $index
    Set-DnsClientServerAddress -InterfaceIndex $index `
        -ServerAddresses $Servers
    Clear-DnsClientCache
    Write-Log ('Da dat DNS: ' + ( $Servers -join ', '))
}

function Clear-SelectedIPv4 {
    param([int]$Index)
    Get-NetRoute -InterfaceIndex $Index -AddressFamily IPv4 |
        Where-Object { $_.DestinationPrefix -eq '0.0.0.0/0' } |
        Remove-NetRoute -Confirm:$false

    Get-NetIPAddress -InterfaceIndex $Index -AddressFamily IPv4 |
        Remove-NetIPAddress -Confirm:$false
}


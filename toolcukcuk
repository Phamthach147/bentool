        $list = Get-NetworkOverview
        foreach ($item in $list) {
            $row = $gridOverview.Rows.Add()
            $gridOverview.Rows[$row].Cells["InterfaceAlias"].Value = $item.InterfaceAlias
            $gridOverview.Rows[$row].Cells["Description"].Value = $item.Description
            $gridOverview.Rows[$row].Cells["Status"].Value = $item.Status
            $gridOverview.Rows[$row].Cells["MACAddress"].Value = $item.MACAddress
            $gridOverview.Rows[$row].Cells["IPv4"].Value = $item.IPv4
            $gridOverview.Rows[$row].Cells["Gateway"].Value = $item.Gateway
            $gridOverview.Rows[$row].Cells["DNS"].Value = $item.DNS
            $gridOverview.Rows[$row].Cells["SSID"].Value = $item.SSID
            $gridOverview.Rows[$row].Cells["Band"].Value = $item.Band
            $gridOverview.Rows[$row].Cells["Signal"].Value = $item.Signal
        }
    } catch {
        [System.Windows.Forms.MessageBox]::Show("Lỗi khi lấy thông tin mạng: $_","Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)

Add-Button 'Don file tam cua tai khoan hien tai' 20 345 {
    if (-not (Confirm-Action (
        'Dong cac ung dung truoc khi don TEMP.' +
        "`nChi xoa muc cu hon 7 ngay; bo qua muc dang bi khoa. Tiep tuc?"
    ))) { return }

    $cutoff = (Get-Date).AddDays(-7)
    $removed = 0
    $skipped = 0

    foreach ( $item in @(Get-ChildItem -LiteralPath $env:TEMP `
        -File -Recurse -Force -ErrorAction SilentlyContinue)) {
        if ( $item.LastWriteTime -lt $cutoff) {
            try {
                Remove-Item -LiteralPath $item.FullName -Force `
                    -ErrorAction Stop
                $removed++
            } catch {
                $skipped++
            }
        }
    }
    Write-Log "Da xoa $removed file tam; bo qua $skipped file."
}


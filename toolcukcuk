        if ($LASTEXITCODE -ne 0) {
            throw ('Không bật được DHCP: ' + ($out | Out-String))
        }

        Set-DnsClientServerAddress -InterfaceIndex $index `
            -ResetServerAddresses

        Log "Đã yêu cầu bật DHCP trên $($adapter.Name)."
        Info 'Đã bật IP và DNS tự động. Chờ máy nhận IP rồi bấm Lấy IP hiện tại.'
    } '#475569'

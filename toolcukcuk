    function Measure-FastestDNS {
        param([int]$ExpectedIndex)

        $providers = @(
            [pscustomobject]@{
                Name = 'Cloudflare'
                Servers = @('1.1.1.1', '1.0.0.1')
            },
            [pscustomobject]@{
                Name = 'Google'
                Servers = @('8.8.8.8', '8.8.4.4')
            }
        )

        $times = @{
            Cloudflare = New-Object Collections.ArrayList
            Google = New-Object Collections.ArrayList
        }

        $domains = @(
            'www.microsoft.com',
            'www.github.com',
            'www.wikipedia.org'
        )

        Log 'Đang đo DNS bằng truy vấn thực tế...'

        # Warm-up, không tính vào kết quả.
        foreach ($provider in $providers) {
            foreach ($server in $provider.Servers) {
                try {
                    $null = Resolve-DnsName -Name 'www.microsoft.com.' `
                        -Type A -Server $server -DnsOnly -NoHostsFile `
                        -QuickTimeout -ErrorAction Stop
                }
                catch {}
            }
        }

        foreach ($domain in $domains) {
            foreach ($provider in @(
                $providers | Sort-Object { Get-Random }
            )) {
                foreach ($server in $provider.Servers) {
                    $watch = [Diagnostics.Stopwatch]::StartNew()

                    try {
                        $answer = @(
                            Resolve-DnsName -Name ($domain + '.') `
                                -Type A -Server $server -DnsOnly `
                                -NoHostsFile -QuickTimeout `
                                -ErrorAction Stop
                        )

                        $watch.Stop()

                        if (-not ($answer |
                            Where-Object { $_.IPAddress })) {
                            throw 'Không nhận được IPv4.'
                        }

                        [void]$times[$provider.Name].Add(
                            $watch.Elapsed.TotalMilliseconds
                        )
                    }
                    catch {
                        $watch.Stop()
                        Log "Không đo được $server với $domain"
                    }

                    $script:form.Refresh()
                }
            }
        }

        $results = @(
            foreach ($provider in $providers) {
                $values = @($times[$provider.Name])
                $average = [double]::PositiveInfinity

                if ($values.Count -gt 0) {
                    $average = [double](
                        $values | Measure-Object -Average
                    ).Average

                    Log (
                        '{0}: {1:N1} ms, thành công {2}/6' -f
                        $provider.Name, $average, $values.Count
                    )
                }
                else {
                    Log "$($provider.Name): không có kết quả."
                }

                [pscustomobject]@{
                    Name = $provider.Name
                    Servers = $provider.Servers
                    Success = $values.Count
                    Failed = 6 - $values.Count
                    Average = $average
                }
            }
        )

        # Ưu tiên ít lỗi hơn; nếu bằng nhau chọn phản hồi nhanh hơn.
        $winner = $results |
            Where-Object { $_.Success -ge 4 } |
            Sort-Object Failed, Average |
            Select-Object -First 1

        if (-not $winner) {
            throw 'Kết quả đo chưa đủ tin cậy. Giữ nguyên DNS hiện tại.'
        }

        $current = Get-CurrentNetwork

        if ($current.Index -ne $ExpectedIndex) {
            throw 'Đường mạng thay đổi trong lúc đo. Hãy thử lại.'
        }

        return $winner
    }


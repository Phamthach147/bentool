# ============================================================
# HÀM TẠO BUTTON CHUẨN
# ============================================================
function New-Button {
    param(
        [string]$text,
        [scriptblock]$onClick
    )
    $btn = New-Object System.Windows.Forms.Button
    $btn.Text = $text
    $btn.Dock = 'Fill'
    $btn.Margin = '3,3,3,3'
    $btn.BackColor = $colorButtonBack
    $btn.ForeColor = $colorFore
    $btn.FlatStyle = 'Flat'
    $btn.FlatAppearance.BorderSize = 0
    $btn.Font = New-Object System.Drawing.Font("Segoe UI",9)
    $btn.Add_MouseEnter({$btn.BackColor = $colorButtonHover})
    $btn.Add_MouseLeave({
        if(-not $btn.Enabled){
            $btn.BackColor = $colorButtonDisabled
        } else {
            $btn.BackColor = $colorButtonBack
        }
    })
    if ($onClick) { $btn.Add_Click($onClick) }
    return $btn
}


# ---------- Tìm lựa chọn ưu tiên 5 GHz driver thực sự cung cấp ----------

function Find-Cukcuk5GHzPreference {
    param( $Adapter)

    $properties = @(
        Get-NetAdapterAdvancedProperty -Name $Adapter.Name `
            -AllProperties
    )

    $options = @(
        foreach ( $property in $properties) {
            # Chỉ tìm thuộc tính ưu tiên băng tần.
            # Không sửa Wireless Mode, Channel Width hoặc chế độ khóa băng tần.
            if (
                $property.DisplayName -notmatch
                '(?i)(preferred.*band|band.*prefer|ưu tiên.*băng|băng.*ưu tiên)' -and
                $property.RegistryKeyword -notmatch
                '(?i)(preferredband|bandpreference)'
            ) {
                continue
            }

            $displayValues = @( $property.ValidDisplayValues)
            $registryValues = @( $property.ValidRegistryValues)

            if ( $displayValues.Count -ne $registryValues.Count) {
                continue
            }

            for ( $i = 0; $i -lt $displayValues.Count; $i++) {
                $label = [string]$displayValues[$i]

                # Chỉ nhận lựa chọn ghi rõ ưu tiên 5 GHz.
                # Không áp dụng mã "2" hoặc "3" đoán theo hãng.
                if (
                    $label -match '(?i)5\s*(?:GHz|G\s*Hz)' -and
                    $label -match '(?i)(prefer|ưu tiên)' -and
                    $label -notmatch '(?i)(2[\.,]4|6\s*GHz|only|chỉ)'
                ) {
                    [pscustomobject]@{
                        Property = $property
                        DisplayValue = $label
                        RegistryValue = [string]$registryValues[$i]
                    }
                }
            }
        }
    )

    if ( $options.Count -ne 1) {
        throw (
            'Driver không cung cấp một lựa chọn ưu tiên 5 GHz ' +
            'mà tool nhận diện chắc chắn. Không thay đổi cài đặt.'
        )
    }

    return $options[0]
}


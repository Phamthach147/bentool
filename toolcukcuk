        Out-Null

    $script:logFile = Join-Path $script:session 'nhat-ky.txt'
    $script:busy = $false
    $script:lastIndex = $null

    function C {
        param([string]$hex)
        return [System.Drawing.ColorTranslator]::FromHtml($hex)
    }


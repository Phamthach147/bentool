function Set-Reg {
    param(
        [string]$Path,
        [string]$Name,
        $Value,
        [string]$Kind = 'DWord'
    )

    $saved = @(
        $script:regBackup |
            Where-Object { $_.Path -eq $Path -and $_.Name -eq $Name }
    )

    if ( $saved.Count -eq 0) {
        $keyExists = Test-Path -LiteralPath $Path
        $exists = $false
        $old = $null
        $oldKind = $null

        if ( $keyExists) {
            $key = Get-Item -LiteralPath $Path
            if ( $key.GetValueNames() -contains $Name) {
                $exists = $true
                $old = $key.GetValue( $Name)
                $oldKind = $key.GetValueKind( $Name).ToString()
            }
        }

        [void]$script:regBackup.Add([pscustomobject]@{
            Path = $Path
            Name = $Name
            Exists = $exists
            Value = $old
            Kind = $oldKind
        })

        $script:regBackup.ToArray() |
            Export-Clixml -LiteralPath (
                Join-Path $script:session 'registry-before.xml'
            )
    }

    New-Item -Path $Path -Force | Out-Null
    New-ItemProperty -LiteralPath $Path -Name $Name `
        -Value $Value -PropertyType $Kind -Force | Out-Null
}

function Run-Step {
    param([string]$Name, [scriptblock]$Action)

    Write-Log "ĐANG CHẠY: $Name"
    try {
        & $Action
        Write-Log "HOÀN TẤT LỆNH: $Name"
    }
    catch {
        Write-Log ("THẤT BẠI: $Name | " + $_.Exception.Message)
    }
}

function New-RestorePoint {
    $drive = "$( $env:SystemDrive)\"

    Enable-ComputerRestore -Drive $drive
    Checkpoint-Computer -Description 'Before Ben Optimizer' `
        -RestorePointType MODIFY_SETTINGS

    $latest = Get-ComputerRestorePoint |
        Sort-Object SequenceNumber -Descending |
        Select-Object -First 1

    if (-not $latest -or
        $latest.Description -ne 'Before Ben Optimizer') {
        throw 'Chưa xác nhận được điểm khôi phục Ben Optimizer.'
    }

    $when = [System.Management.ManagementDateTimeConverter]::ToDateTime(
        $latest.CreationTime
    )

    if ( $when -lt (Get-Date).AddMinutes(-10)) {
        throw 'Điểm khôi phục tìm thấy không phải điểm vừa tạo.'
    }

    Write-Log (
        'Đã xác nhận điểm khôi phục, số: ' + $latest.SequenceNumber
    )
}

function Remove-CurrentUserApp {
    param([string]$PackageName)

    $packages = @(Get-AppxPackage -Name $PackageName)
    if ( $packages.Count -eq 0) {
        Write-Log "Không có ứng dụng $PackageName trong tài khoản hiện tại."
        return
    }

    foreach ( $package in $packages) {
        Remove-AppxPackage -Package $package.PackageFullName
        Write-Log "Đã gửi lệnh gỡ: $( $package.Name)"
    }
}


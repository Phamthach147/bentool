# ---------- Nhận diện loại kết nối ----------

function Get-CukcukAdapterType {
    param( $Adapter)

    # NdisPhysicalMedium 9: Native 802.11.
    # InterfaceType 71: IEEE 802.11.
    if (
        [int]$Adapter.NdisPhysicalMedium -eq 9 -or
        [int]$Adapter.InterfaceType -eq 71
    ) {
        return 'Wi-Fi'
    }

    if ( $Adapter.HardwareInterface -and
        [int]$Adapter.InterfaceType -eq 6) {
        return 'LAN'
    }

    return 'VPN / card ảo / kết nối khác'
}

# ---------- Đọc thông tin Wi-Fi thực tế ----------

function Get-CukcukWifiInfo {
    param( $Adapter)

    $result = [ordered]@{
        SSID = 'Chưa xác định'
        Band = 'Chưa xác định'
        Signal = 'Chưa xác định'
        Channel = 'Chưa xác định'
    }

    try {
        $raw = (& "$env:SystemRoot\System32\netsh.exe" `
            wlan show interfaces 2>&1 | Out-String)

        if ( $LASTEXITCODE -ne 0) {
            return [pscustomobject]$result
        }

        # Chọn đúng khối của card theo GUID.
        # Không lấy nhầm Wi-Fi khác khi máy có nhiều card.
        $guid = ([string]$Adapter.InterfaceGuid).Trim('{}')
        $blocks = @( $raw -split '(?:\r?\n)\s*(?:\r?\n)')

        $block = $blocks |
            Where-Object {
                $_ -match [regex]::Escape( $guid)
            } |
            Select-Object -First 1

        if (-not $block) {
            return [pscustomobject]$result
        }

        foreach ( $line in ( $block -split '\r?\n')) {
            if ( $line -match '^\s*SSID\s*:\s*(.+?)\s*$') {
                $result.SSID = $Matches[1]
            }

            if ( $line -match
                '^\s*(?:Band|Băng tần|Băng tầng)\s*:\s*(.+?)\s*$') {

                $bandText = $Matches[1]

                if ( $bandText -match '2[\.,]4\s*GHz') {
                    $result.Band = '2.4 GHz'
                }
                elseif ( $bandText -match '(^|\s)5\s*GHz') {
                    $result.Band = '5 GHz'
                }
                elseif ( $bandText -match '(^|\s)6\s*GHz') {
                    $result.Band = '6 GHz'
                }
            }

            if ( $line -match
                '^\s*(?:Signal|Tín hiệu)\s*:\s*(.+?)\s*$') {
                $result.Signal = $Matches[1]
            }

            if ( $line -match
                '^\s*(?:Channel|Kênh)\s*:\s*(\d+)\s*$') {
                $result.Channel = $Matches[1]
            }
        }

        # Không suy ra băng tần chỉ từ channel hoặc chuẩn 802.11.
        # Windows/driver không trả Band thì giữ "Chưa xác định".
    }
    catch {
        Log ('Đọc Wi-Fi: ' + $_.Exception.Message)
    }

    return [pscustomobject]$result
}


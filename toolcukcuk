function Clear-IPv4Configuration {
    param([int]$Index)

    Get-NetRoute -InterfaceIndex $Index -AddressFamily IPv4 |
        Where-Object { $_.DestinationPrefix -eq '0.0.0.0/0' } |
        Remove-NetRoute -Confirm:$false

    Get-NetIPAddress -InterfaceIndex $Index -AddressFamily IPv4 |
        Remove-NetIPAddress -Confirm:$false
}

Add-Button $netTab 'Đặt IP tĩnh' 20 258 {
    $ip = $script:ipBox.Text.Trim()
    $gateway = $script:gatewayBox.Text.Trim()

    $null = Assert-IPv4 $ip
    $null = Assert-IPv4 $gateway

    $prefix = 0
    if (-not [int]::TryParse(
        $script:prefixBox.Text.Trim(), [ref]$prefix
    ) -or $prefix -lt 1 -or $prefix -gt 30) {
        throw 'Với cấu hình có gateway, nhập prefix từ 1 đến 30.'
    }

    $ipBytes = ([System.Net.IPAddress]::Parse( $ip)).GetAddressBytes()
    $gwBytes = ([System.Net.IPAddress]::Parse( $gateway)).GetAddressBytes()
    $bits = $prefix

    for ( $i = 0; $i -lt 4; $i++) {
        $used = [Math]::Min(8, [Math]::Max(0, $bits))
        $mask = if ( $used -eq 0) { 0 } else {
            (255 -shl (8 - $used)) -band 255
        }

        if (( $ipBytes[$i] -band $mask) -ne
            ( $gwBytes[$i] -band $mask)) {
            throw 'IP và gateway không cùng subnet theo prefix đã nhập.'
        }
        $bits -= 8
    }

    if ( $ip -eq $gateway) { throw 'IP máy không được trùng gateway.' }

    $n = Get-ActiveNetwork
    if (-not (Confirm-Network $n (
        "Thay IPv4 hiện tại bằng $ip/$prefix, gateway $gateway." +
        "`nTool chưa xác minh IP này có bị trùng hoặc là địa chỉ mạng/broadcast."
    ))) { return }

    Backup-Network $n.Index

    try {
        Set-NetIPInterface -InterfaceIndex $n.Index `
            -AddressFamily IPv4 -Dhcp Disabled
        Clear-IPv4Configuration $n.Index
        New-NetIPAddress -InterfaceIndex $n.Index -IPAddress $ip `
            -PrefixLength $prefix -DefaultGateway $gateway | Out-Null

        Write-Log "Đã gửi cấu hình IP $ip/$prefix trên $( $n.Alias)."
        Write-Log 'Chưa xác nhận kết nối Internet hoặc kiểm tra trùng IP.'
    }
    catch {
        Write-Log "Cấu hình có thể đã thay đổi một phần trên index $( $n.Index)."
        Write-Log "Nếu mất mạng, mở ncpa.cpl để trả IPv4 và DNS về tự động."
        throw
    }
}


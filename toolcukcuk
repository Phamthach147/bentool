# ============================================================
# HÀM ĐO DNS NHANH NHẤT (RESOLVE-DNSNAME)
# ============================================================
function Measure-DNSLatency {
    param(
        [string[]]$dnsServers,
        [string[]]$domains = @("microsoft.com","google.com","cloudflare.com"),
        [int]$timeoutMs = 2000
    )
    $results = @()
    foreach ($dns in $dnsServers) {
        $latencies = @()
        $errors = 0
        foreach ($domain in $domains) {
            try {
                $sw = [System.Diagnostics.Stopwatch]::StartNew()
                Resolve-DnsName -Name $domain -Server $dns -ErrorAction Stop | Out-Null
                $sw.Stop()
                $latencies += $sw.ElapsedMilliseconds
            } catch {
                $errors++
                $latencies += $timeoutMs
            }
        }
        $avg = ($latencies | Measure-Object -Average).Average
        $results += [PSCustomObject]@{
            DNS = $dns
            AvgLatencyMs = [math]::Round($avg,2)
            Errors = $errors
        }
    }
    # Sắp xếp ưu tiên ít lỗi, thấp latency
    $results = $results | Sort-Object Errors, AvgLatencyMs
    return $results
}

# ============================================================
# HÀM PING IPv4 4 LẦN ICMP BẰNG .NET PING
# ============================================================
function Ping-IPv4 {
    param(
        [string]$ip,
        [int]$count = 4,
        [int]$timeout = 1000
    )
    $ping = New-Object System.Net.NetworkInformation.Ping
    $results = @()
    for ($i=0; $i -lt $count; $i++) {
        try {
            $reply = $ping.Send($ip, $timeout)
            if ($reply.Status -eq "Success") {
                $results += $reply.RoundtripTime
            } else {
                $results += $null
            }
        } catch {
            $results += $null
        }
        Start-Sleep -Milliseconds 200
    }
    $received = ($results | Where-Object { $_ -ne $null }).Count
    $lost = $count - $received
    $min = if ($received -gt 0) { ($results | Where-Object { $_ -ne $null } | Measure-Object -Minimum).Minimum } else { $null }
    $max = if ($received -gt 0) { ($results | Where-Object { $_ -ne $null } | Measure-Object -Maximum).Maximum } else { $null }
    $avg = if ($received -gt 0) { ($results | Where-Object { $_ -ne $null } | Measure-Object -Average).Average } else { $null }
    return [PSCustomObject]@{
        Results = $results
        Received = $received
        Lost = $lost
        Min = $min
        Max = $max
        Avg = $avg
    }
}

# ============================================================
# HÀM CHẠY ASYNC TASK VỚI MARSHALING UI
# ============================================================
function Start-AsyncTask {
    param(
        [scriptblock]$task,
        [scriptblock]$onComplete
    )
    $syncContext = [System.Threading.SynchronizationContext]::Current
    $job = [System.Threading.Tasks.Task]::Run($task)
    $job.ContinueWith({
        param($t)
        $syncContext.Post([System.Threading.SendOrPostCallback]{
            $onComplete.Invoke()
        }, $null)
    }) | Out-Null
}


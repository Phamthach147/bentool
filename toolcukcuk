function Add-Button {
    param(
        $Parent,
        [string]$Text,
        [int]$X,
        [int]$Y,
        [scriptblock]$Action,
        [int]$Width = 405
    )

    $c = New-Object System.Windows.Forms.Button
    $c.Text = $Text
    $c.Location = New-Object System.Drawing.Point( $X, $Y)
    $c.Size = New-Object System.Drawing.Size( $Width, 44)
    $c.FlatStyle = 'Flat'
    $c.FlatAppearance.BorderSize = 0
    $c.BackColor = [System.Drawing.Color]::FromArgb(42, 101, 190)
    $c.ForeColor = [System.Drawing.Color]::White
    $c.Cursor = 'Hand'
    $c.Tag = $Action

    $c.Add_Click({
        param( $sender, $e)

        if ( $script:busy) { return }

        $script:busy = $true
        foreach ( $b in $script:buttons) { $b.Enabled = $false }

        try {
            & $sender.Tag
        }
        catch {
            Write-Log ('LỖI: ' + $_.Exception.Message)
            [System.Windows.Forms.MessageBox]::Show(
                $script:form,
                $_.Exception.Message,
                'Thao tác không hoàn tất'
            ) | Out-Null
        }
        finally {
            foreach ( $b in $script:buttons) { $b.Enabled = $true }
            $script:busy = $false
        }
    })

    $Parent.Controls.Add( $c)
    [void]$script:buttons.Add( $c)
}


function Measure-BenDNS {
    param($Network)

    $providers = @(
        [pscustomobject]@{
            Name = 'Cloudflare'
            Servers = @('1.1.1.1', '1.0.0.1')
        },
        [pscustomobject]@{
            Name = 'Google'
            Servers = @('8.8.8.8', '8.8.4.4')
        }
    )

    $samples = @{
        Cloudflare = New-Object System.Collections.ArrayList
        Google = New-Object System.Collections.ArrayList
    }

    $failures = @{
        Cloudflare = 0
        Google = 0
    }

    $domains = @(
        'www.microsoft.com',
        'www.wikipedia.org',
        'www.github.com'
    )

    Write-Log 'Đang đo DNS Google và Cloudflare...'
    Write-Log 'Mỗi nhà cung cấp: 6 truy vấn, gồm cả DNS chính và phụ.'

    foreach ($domain in $domains) {
        # Đảo thứ tự để tránh luôn đo một bên trước.
        foreach ($provider in @($providers | Sort-Object { Get-Random })) {
            foreach ($server in $provider.Servers) {
                $watch = [System.Diagnostics.Stopwatch]::StartNew()

                try {
                    $answer = @(
                        Resolve-DnsName -Name $domain -Type A `
                            -Server $server -DnsOnly -NoHostsFile `
                            -QuickTimeout -ErrorAction Stop
                    )

                    $watch.Stop()

                    if (-not ($answer | Where-Object { $_.IPAddress })) {
                        throw 'Không nhận được bản ghi IPv4.'
                    }

                    [void]$samples[$provider.Name].Add(
                        [double]$watch.Elapsed.TotalMilliseconds
                    )
                }
                catch {
                    $watch.Stop()
                    $failures[$provider.Name]++
                }

                $script:form.Refresh()
            }
        }
    }

    $results = foreach ($provider in $providers) {
        $times = @($samples[$provider.Name])
        $average = [double]::PositiveInfinity

        if ($times.Count -gt 0) {
            $average = [double](
                $times | Measure-Object -Average
            ).Average
        }

        [pscustomobject]@{
            Name = $provider.Name
            Servers = $provider.Servers
            Success = $times.Count
            Failed = $failures[$provider.Name]
            Average = $average
        }
    }

    foreach ($result in $results) {
        if ($result.Success -gt 0) {
            Write-Log (
                '{0}: trung bình {1:N1} ms | thành công {2}/6.' -f
                $result.Name, $result.Average, $result.Success
            )
        }
        else {
            Write-Log "$($result.Name): không đo được."
        }
    }

    # Cần tối thiểu 4/6 truy vấn thành công.
    # Ưu tiên ít lỗi hơn, rồi tới thời gian trung bình thấp hơn.
    $winner = $results |
        Where-Object { $_.Success -ge 4 } |
        Sort-Object Failed, Average |
        Select-Object -First 1

    if (-not $winner) {
        throw 'Kết quả đo chưa đủ tin cậy. DNS hiện tại được giữ nguyên.'
    }

    $currentNetwork = Get-ActiveNetwork
    if ($currentNetwork.Index -ne $Network.Index) {
        throw 'Đường mạng đã thay đổi trong lúc đo. Hãy thử lại.'
    }

    return $winner
}

# ---------- Thay logic nút Áp dụng DNS ----------

foreach ($button in $script:buttons) {
    if ($button.Text -eq 'Áp dụng DNS') {
        $button.Tag = {
            $network = Get-ActiveNetwork
            $selection = [string]$script:dnsChoice.SelectedItem
            $auto = $selection -eq 'Tự động (DHCP)'
            $fastest = $selection -eq 'Nhanh nhất'
            $winner = $null
            $servers = @()

            if (-not $auto -and -not $fastest) {
                if (-not $script:dns1.Text.Trim()) {
                    throw 'Hãy nhập DNS chính hoặc chọn nhà cung cấp.'
                }

                $servers = @(
                    $script:dns1.Text.Trim(),
                    $script:dns2.Text.Trim()
                ) | Where-Object { $_ }

                foreach ($server in $servers) {
                    $null = Assert-IPv4 $server
                }
            }

            $message = 'Áp dụng DNS vừa chọn?'
            if ($fastest) {
                $message =
                    'Đo Google và Cloudflare, rồi áp dụng bên có kết quả tốt hơn?'
            }

            if (-not (Confirm-Network $network $message)) {
                return
            }

            if ($fastest) {
                $winner = Measure-BenDNS $network
                $servers = $winner.Servers
            }

            Backup-Network $network.Index

            if ($auto) {
                Set-DnsClientServerAddress `
                    -InterfaceIndex $network.Index `
                    -ResetServerAddresses

                Write-Log 'Đã đặt DNS tự động.'
            }
            else {
                Set-DnsClientServerAddress `
                    -InterfaceIndex $network.Index `
                    -ServerAddresses $servers

                Write-Log ('Đã áp dụng DNS: ' + ($servers -join ', '))
            }

            Clear-DnsClientCache

            if ($fastest) {
                # Giữ lựa chọn Nhanh nhất để lần sau có thể đo lại.
                $script:dns1.Text = $servers[0]
                $script:dns2.Text = $servers[1]

                $notice = (
                    "Đã chọn DNS $($winner.Name)." +
                    "`nThời gian phản hồi trung bình: " +
                    ('{0:N1} ms' -f $winner.Average) +
                    "`nDNS chính: $($servers[0])" +
                    "`nDNS phụ: $($servers[1])"
                )

                Write-Log (
                    'DNS được chọn: {0}, trung bình {1:N1} ms.' -f
                    $winner.Name, $winner.Average
                )

                [System.Windows.Forms.MessageBox]::Show(
                    $script:form,
                    $notice,
                    'Đã chọn DNS',
                    [System.Windows.Forms.MessageBoxButtons]::OK,
                    [System.Windows.Forms.MessageBoxIcon]::Information
                ) | Out-Null
            }
        }
    }
}

# Khi mở tool, chỉ đọc và điền IP, không thay cấu hình.
try {
    Fill-CurrentIPv4 -Quiet
}
catch {
    Write-Log ('Đọc IP hiện tại: ' + $_.Exception.Message)
}

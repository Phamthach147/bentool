    function Add-Button {
        param(
            $Parent,
            [string]$Text,
            [int]$X,
            [int]$Y,
            [scriptblock]$Action,
            [int]$Width = 350,
            [string]$Hex = '#377DFF'
        )

        $b = New-Object Windows.Forms.Button
        $b.Text = $Text
        $b.Location = New-Object Drawing.Point($X, $Y)
        $b.Size = New-Object Drawing.Size($Width, 46)
        $b.FlatStyle = 'Flat'
        $b.FlatAppearance.BorderSize = 0
        $b.BackColor = Color $Hex
        $b.ForeColor = [Drawing.Color]::White
        $b.Font = New-Object Drawing.Font(
            'Segoe UI', 10, [Drawing.FontStyle]::Bold
        )
        $b.Cursor = [Windows.Forms.Cursors]::Hand
        $b.Tag = $Action

        $b.Add_Click({
            param($sender, $eventArgs)

            if ($script:busy) { return }

            $script:busy = $true
            $script:form.UseWaitCursor = $true

            foreach ($button in $script:actionButtons) {
                $button.Enabled = $false
            }

            foreach ($button in $script:navButtons) {
                $button.Enabled = $false
            }

            try {
                & $sender.Tag
            }
            catch {
                Log ('LỖI: ' + $_.Exception.Message)

                [Windows.Forms.MessageBox]::Show(
                    $script:form,
                    $_.Exception.Message,
                    'Thao tác chưa hoàn tất',
                    [Windows.Forms.MessageBoxButtons]::OK,
                    [Windows.Forms.MessageBoxIcon]::Error
                ) | Out-Null
            }
            finally {
                foreach ($button in $script:actionButtons) {
                    $button.Enabled = $true
                }

                foreach ($button in $script:navButtons) {
                    $button.Enabled = $true
                }

                $script:form.UseWaitCursor = $false
                $script:busy = $false
            }
        })

        $Parent.Controls.Add($b)
        [void]$script:actionButtons.Add($b)
    }


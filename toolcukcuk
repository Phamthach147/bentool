function Update-CukcukConnection {
    param([switch]$Quiet)

    try {
        $n = Get-CurrentNetwork
        $adapter = Get-NetAdapter -InterfaceIndex $n.Index
        $type = Get-CukcukAdapterType $adapter

        $ips = @(
            Get-NetIPAddress -InterfaceIndex $n.Index `
                -AddressFamily IPv4 |
                Where-Object {
                    $_.AddressState -eq 'Preferred' -and
                    $_.IPAddress -notlike '127.*' -and
                    $_.IPAddress -notlike '169.254.*'
                }
        )

        $ipText = (
            $ips | ForEach-Object {
                '{0}/{1}' -f $_.IPAddress, $_.PrefixLength
            }
        ) -join ', '

        if (-not $ipText) {
            $ipText = 'Chưa có IPv4 sử dụng được'
        }

        $lines = @(
            "Kết nối: $type"
            "Card mạng: $( $adapter.Name)"
            "IPv4 / prefix: $ipText"
            "Gateway: $( $n.Gateway)"
        )

        if ( $type -eq 'Wi-Fi') {
            $wifi = Get-CukcukWifiInfo $adapter

            $lines += "Tên Wi-Fi: $( $wifi.SSID)"
            $lines += (
                "Băng tần: $( $wifi.Band) | " +
                "Tín hiệu: $( $wifi.Signal) | Kênh: $( $wifi.Channel)"
            )
        }

        $script:cukcukConnection.Text = $lines -join "`r`n"

        if (-not $Quiet) {
            Log ( $lines -join ' | ')
        }
    }
    catch {
        $script:cukcukConnection.Text = (
            'Chưa đọc được kết nối: ' + $_.Exception.Message
        )

        if (-not $Quiet) {
            Log $script:cukcukConnection.Text
        }
    }
}


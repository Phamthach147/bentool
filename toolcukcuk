Add-Button 'Dat IP tinh IPv4' 20 195 {
    $index = Get-SelectedIndex

    $ip = Ask-Value 'Nhap IP tinh, vi du 192.168.1.100:'
    if (-not $ip) { return }
    Assert-IPv4 $ip

    $prefixText = Ask-Value 'Nhap prefix 1-32. Subnet 255.255.255.0 = 24:' '24'
    if (-not $prefixText) { return }
    $prefix = 0
    if (-not [int]::TryParse( $prefixText, [ref]$prefix) -or
        $prefix -lt 1 -or $prefix -gt 32) {
        throw 'Prefix phai la so tu 1 den 32.'
    }

    $gateway = Ask-Value 'Nhap gateway, vi du 192.168.1.1:'
    if (-not $gateway) { return }
    Assert-IPv4 $gateway

    if (-not (Confirm-Action (
        "Se thay TOAN BO IPv4 va default gateway tren card da chon." +
        "`nIP: $ip/$prefix - Gateway: $gateway" +
        "`nCo the mat ket noi. KHONG lam khi dang remote." +
        "`nBan co chac dia chi nay dung va chua bi trung?"
    ))) { return }

    Backup-Network $index
    try {
        Set-NetIPInterface -InterfaceIndex $index `
            -AddressFamily IPv4 -Dhcp Disabled
        Clear-SelectedIPv4 $index
        New-NetIPAddress -InterfaceIndex $index -IPAddress $ip `
            -PrefixLength $prefix -DefaultGateway $gateway | Out-Null
        Write-Log "Da gui cau hinh IP: $ip/$prefix, gateway $gateway."
        Write-Log 'Chua xac nhan Internet. Neu sai, bam IP tu dong.'
    } catch {
        Write-Log 'Cau hinh co the da thay doi mot phan. Bam IP tu dong neu can.'
        throw
    }
}

Add-Button 'IP + DNS tu dong (DHCP)' 390 195 {
    if (-not (Confirm-Action (
        'Se xoa IPv4 hien tai tren card da chon va dung DHCP.' +
        "`nKhong phai khoi phuc cau hinh IP tinh cu. Tiep tuc?"
    ))) { return }
    $index = Get-SelectedIndex
    Backup-Network $index
    Clear-SelectedIPv4 $index
    Set-NetIPInterface -InterfaceIndex $index `
        -AddressFamily IPv4 -Dhcp Enabled
    Set-DnsClientServerAddress -InterfaceIndex $index `
        -ResetServerAddresses
    Write-Log 'Da bat DHCP. Cho card mang nhan lai dia chi.'
}

Add-Button 'Tat Firewall: Domain / Private / Public' 20 245 {
    if (-not (Confirm-Action (
        'Tat ca 3 Firewall lam giam bao ve may.' +
        "`nChi tat tam thoi tren mang tin cay. Tiep tuc?"
    ))) { return }

    $file = Join-Path $script:backupDir (
        'firewall-{0}.xml' -f (Get-Date -Format 'yyyyMMdd-HHmmss-fff')
    )
    Get-NetFirewallProfile | Select-Object Name, Enabled |
        Export-Clixml -LiteralPath $file

    Set-NetFirewallProfile -Profile Domain,Private,Public -Enabled False
    Write-Log "Da yeu cau tat 3 Firewall. Backup: $file"
    Get-NetFirewallProfile | ForEach-Object {
        Write-Log ("Firewall {0}: {1}" -f $_.Name, $_.Enabled)
    }
}


# ============================================================
# HÀM BACKUP MẠNG XML
# ============================================================
function Backup-NetworkConfig {
    param([string]$path)
    try {
        $interfaces = Get-NetworkInterfaces
        $xml = New-Object System.Xml.XmlDocument
        $root = $xml.CreateElement("NetworkBackup")
        $xml.AppendChild($root) | Out-Null
        foreach ($iface in $interfaces) {
            $ifaceNode = $xml.CreateElement("Interface")
            $ifaceNode.SetAttribute("InterfaceAlias",$iface.InterfaceAlias)
            $ifaceNode.SetAttribute("InterfaceGuid",$iface.InterfaceGuid)
            $ifaceNode.SetAttribute("InterfaceIndex",$iface.ifIndex)
            $ifaceNode.SetAttribute("Description",$iface.InterfaceDescription)
            $ips = Get-IPv4Info -ifAlias $iface.InterfaceAlias
            foreach ($ip in $ips) {
                $ipNode = $xml.CreateElement("IPAddress")
                $ipNode.SetAttribute("Address",$ip.IPAddress)
                $ipNode.SetAttribute("PrefixLength",$ip.PrefixLength)
                $ifaceNode.AppendChild($ipNode) | Out-Null
            }
            $root.AppendChild($ifaceNode) | Out-Null
        }
        $xml.Save($path)
        return $true
    } catch {
        return $false
    }
}

# ============================================================
# HÀM RESTORE MẠNG XML (CHỈ INTERFACE ĐÃ BACKUP)
# ============================================================
function Restore-NetworkConfig {
    param([string]$path)
    try {
        $xml = New-Object System.Xml.XmlDocument
        $xml.Load($path)
        $root = $xml.DocumentElement
        foreach ($ifaceNode in $root.SelectNodes("Interface")) {
            $alias = $ifaceNode.GetAttribute("InterfaceAlias")
            $ips = @()
            foreach ($ipNode in $ifaceNode.SelectNodes("IPAddress")) {
                $ips += [PSCustomObject]@{
                    IPAddress = $ipNode.GetAttribute("Address")
                    PrefixLength = [int]$ipNode.GetAttribute("PrefixLength")

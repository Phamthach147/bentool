Add-Button 'SQL 2005: chon bo cai co san' 390 395 {
    if (-not (Confirm-Action (
        'SQL Server 2005 khong duoc ho tro tren Windows 10/11.' +
        "`nNen dung may ao cho phan mem cu." +
        "`nTool chi mo bo cai cua ban, khong dam bao cai thanh cong." +
        "`nTiep tuc chon file EXE?"
    ))) { return }

    $dialog = New-Object System.Windows.Forms.OpenFileDialog
    $dialog.Filter = 'Installer (*.exe)|*.exe'
    try {
        if ( $dialog.ShowDialog() -eq
            [System.Windows.Forms.DialogResult]::OK) {
            $signature = Get-AuthenticodeSignature `
                -LiteralPath $dialog.FileName
            if ( $signature.Status -ne 'Valid') {
                throw 'Bo cai khong co chu ky hop le. Khong chay.'
            }
            if (-not (Confirm-Action (
                "Nguoi ky: $( $signature.SignerCertificate.Subject)" +
                "`nChi chay neu ban tin tuong nguon bo cai. Tiep tuc?"
            ))) { return }
            Start-Process -FilePath $dialog.FileName
            Write-Log 'Da mo bo cai. Tu lam theo huong dan cua bo cai.'
        }
    } finally {
        $dialog.Dispose()
    }
}

Refresh-Adapters

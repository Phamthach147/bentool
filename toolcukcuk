# Xử lý nút áp dụng IP tĩnh
$btnApplyStaticIP.Add_Click({
    $iface = $cbInterfacesStaticIP.SelectedItem
    $ip = $tbIPStatic.Text.Trim()
    $prefix = $tbPrefixStatic.Text.Trim()
    $gateway = $tbGatewayStatic.Text.Trim()
    $dnsText = $tbDNSStatic.Text.Trim()

    # Validate IP
    if (-not (Test-IPv4 $ip)) {
        [System.Windows.Forms.MessageBox]::Show("Địa chỉ IP không hợp lệ.","Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
        return
    }
    # Validate prefix
    $prefixNum = 0
    if (-not ([int]::TryParse($prefix,[ref]$prefixNum) -and (Test-Prefix $prefixNum))) {
        [System.Windows.Forms.MessageBox]::Show("Prefix phải là số nguyên từ 1 đến 30.","Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
        return
    }
    # Validate gateway
    if (-not (Test-IPv4 $gateway)) {
        [System.Windows.Forms.MessageBox]::Show("Gateway không hợp lệ.","Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
        return
    }
    # Kiểm tra gateway cùng mạng
    if (-not (Test-GatewayInSubnet -ip $ip -prefix $prefixNum -gateway $gateway)) {
        [System.Windows.Forms.MessageBox]::Show("Gateway không cùng mạng với IP và prefix.","Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
        return
    }
    # DNS có thể trống giữ nguyên
    $dnsServers = @()
    if ($dnsText -ne "") {
        $dnsServers = $dnsText.Split(",") | ForEach-Object { $_.Trim() } | Where-Object { Test-IPv4 $_ }
        if ($dnsServers.Count -eq 0) {
            [System.Windows.Forms.MessageBox]::Show("DNS nhập không hợp lệ.","Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
            return
        }
    }

    # Xác nhận thay đổi IP tĩnh có thể mất remote
    $confirm = [System.Windows.Forms.MessageBox]::Show("Bạn chắc chắn muốn áp dụng IP tĩnh cho giao diện $iface? Có thể mất kết nối mạng tạm thời.", "Xác nhận", [System.Windows.Forms.MessageBoxButtons]::YesNo, [System.Windows.Forms.MessageBoxIcon]::Warning)
    if ($confirm -ne [System.Windows.Forms.DialogResult]::Yes) { return }

    # Backup mạng trước khi thay đổi
    $backupPath = Join-Path $env:TEMP "network_backup_$(Get-Date -Format 'yyyyMMddHHmmss').xml"
    if (-not (Backup-NetworkConfig -path $backupPath)) {
        [System.Windows.Forms.MessageBox]::Show("Không thể backup cấu hình mạng. Hủy thao tác.", "Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
        return
    }

    # Áp dụng IP tĩnh async
    Set-BusyState -busy $true -controls @($btnApplyStaticIP, $cbInterfacesStaticIP, $tbIPStatic, $tbPrefixStatic, $tbGatewayStatic, $tbDNSStatic)
    Start-AsyncTask -task {
        try {
            # Xóa IP hiện tại (chỉ IP chính)
            $currentIPs = Get-NetIPAddress -InterfaceAlias $iface -AddressFamily IPv4 -PrefixOrigin Manual -ErrorAction SilentlyContinue
            foreach ($ipEntry in $currentIPs) {
                Remove-NetIPAddress -InterfaceAlias $iface -IPAddress $ipEntry.IPAddress -Confirm:$false -ErrorAction SilentlyContinue
            }
            # Thêm IP mới
            New-NetIPAddress -InterfaceAlias $iface -IPAddress $ip -PrefixLength $prefixNum -DefaultGateway $gateway -ErrorAction Stop
            # Cập nhật DNS nếu có
            if ($dnsServers.Count -gt 0) {
                Set-DnsClientServerAddress -InterfaceAlias $iface -ServerAddresses $dnsServers -ErrorAction Stop
            }
            Write-Log "Đã áp dụng IP tĩnh cho $iface: $ip/$prefixNum Gateway $gateway DNS $($dnsServers -join ', ')"
        } catch {
            Write-Log "Lỗi áp dụng IP tĩnh: $_"
            throw $_
        }
    } -onComplete {
        Set-BusyState -busy $false -controls @($btnApplyStaticIP, $cbInterfacesStaticIP, $tbIPStatic, $tbPrefixStatic, $tbGatewayStatic, $tbDNSStatic)
        [System.Windows.Forms.MessageBox]::Show("Đã áp dụng IP tĩnh cho giao diện $iface.", "Thông báo", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Information)
        $btnRefreshOverview.PerformClick()
    }
})


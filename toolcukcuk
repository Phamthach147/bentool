    function Log {
        param([string]$message)

        $line = '[{0}] {1}' -f (Get-Date -Format 'HH:mm:ss'), $message
        Add-Content -LiteralPath $script:logFile -Value $line `
            -Encoding UTF8

        if ($script:logBox -and -not $script:logBox.IsDisposed) {
            $script:logBox.AppendText(
                $line + [Environment]::NewLine
            )
        }
    }

    function Ask {
        param([string]$message)

        return (
            [System.Windows.Forms.MessageBox]::Show(
                $script:form,
                $message,
                'Tối Ưu CUKCUK',
                [System.Windows.Forms.MessageBoxButtons]::YesNo,
                [System.Windows.Forms.MessageBoxIcon]::Warning
            ) -eq [System.Windows.Forms.DialogResult]::Yes
        )
    }

    function Info {
        param([string]$message)

        [System.Windows.Forms.MessageBox]::Show(
            $script:form,
            $message,
            'Tối Ưu CUKCUK',
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Information
        ) | Out-Null
    }

    function New-Grid {
        param(
            [int]$columns,
            [int]$rows
        )

        $g = New-Object System.Windows.Forms.TableLayoutPanel
        $g.Dock = 'Fill'
        $g.BackColor = $script:card
        $g.ColumnCount = $columns
        $g.RowCount = $rows
        $g.Padding = New-Object System.Windows.Forms.Padding(10)

        for ($i = 0; $i -lt $columns; $i++) {
            $style = New-Object System.Windows.Forms.ColumnStyle
            $style.SizeType =
                [System.Windows.Forms.SizeType]::Percent
            $style.Width = 100 / $columns
            [void]$g.ColumnStyles.Add($style)
        }

        for ($i = 0; $i -lt $rows; $i++) {
            $style = New-Object System.Windows.Forms.RowStyle
            $style.SizeType =
                [System.Windows.Forms.SizeType]::Percent
            $style.Height = 100 / $rows
            [void]$g.RowStyles.Add($style)
        }

        return $g
    }

    function Cell {
        param($grid, $control, [int]$column, [int]$row)

        $control.Dock = 'Fill'
        $control.Margin = New-Object System.Windows.Forms.Padding(5)
        $grid.Controls.Add($control, $column, $row)
    }

    function Label {
        param([string]$text)

        $x = New-Object System.Windows.Forms.Label
        $x.Text = $text
        $x.ForeColor = $script:fg
        $x.TextAlign = 'MiddleLeft'
        return $x
    }

    function Input {
        param([string]$text = '')

        $x = New-Object System.Windows.Forms.TextBox
        $x.Text = $text
        $x.BackColor = $script:field
        $x.ForeColor = $script:fg
        $x.BorderStyle = 'FixedSingle'
        return $x
    }

    function Button {
        param(
            [string]$text,
            [scriptblock]$action,
            [string]$color = '#2563EB'
        )

        $b = New-Object System.Windows.Forms.Button
        $b.Text = $text
        $b.BackColor = C $color
        $b.ForeColor = [System.Drawing.Color]::White
        $b.FlatStyle = 'Flat'
        $b.FlatAppearance.BorderSize = 0
        $b.Cursor = 'Hand'
        $b.Tag = $action

        $b.Add_Click({
            param($sender, $eventArgs)

            if ($script:busy) { return }
            $script:busy = $true
            $sender.Enabled = $false

            try {
                & $sender.Tag
            }
            catch {
                Log ('LỖI: ' + $_.Exception.Message)
                [System.Windows.Forms.MessageBox]::Show(
                    $script:form,
                    $_.Exception.Message,
                    'Thao tác chưa hoàn tất',
                    [System.Windows.Forms.MessageBoxButtons]::OK,
                    [System.Windows.Forms.MessageBoxIcon]::Error
                ) | Out-Null
            }
            finally {
                $sender.Enabled = $true
                $script:busy = $false
            }
        })

        return $b
    }


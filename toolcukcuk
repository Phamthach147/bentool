function Assert-IPv4 {
    param([string]$Value)

    if ( $Value -notmatch '^\d{1,3}(\.\d{1,3}){3}$') {
        throw "IPv4 không hợp lệ: $Value"
    }

    foreach ( $part in ( $Value -split '\.')) {
        if ([int]$part -gt 255) { throw "IPv4 không hợp lệ: $Value" }
    }

    return [System.Net.IPAddress]::Parse( $Value)
}

function Get-ActiveNetwork {
    # Choose an active IPv4 default route by combined route/interface metric.
    # Refuse ties instead of silently choosing a random interface.

    $candidates = foreach ( $route in @(
        Get-NetRoute -AddressFamily IPv4 `
            -DestinationPrefix '0.0.0.0/0' -PolicyStore ActiveStore
    )) {
        $adapter = Get-NetAdapter -InterfaceIndex $route.InterfaceIndex `
            -ErrorAction SilentlyContinue

        if (-not $adapter -or $adapter.Status -ne 'Up') { continue }

        $ipif = Get-NetIPInterface -InterfaceIndex $route.InterfaceIndex `
            -AddressFamily IPv4

        [pscustomobject]@{
            Index = [int]$route.InterfaceIndex
            Alias = $adapter.Name
            Gateway = $route.NextHop
            Score = [int]$route.RouteMetric + [int]$ipif.InterfaceMetric
        }
    }

    $ordered = @( $candidates | Sort-Object Score)
    if ( $ordered.Count -eq 0) {
        throw 'Không tìm thấy card đang Up có default route IPv4.'
    }

    $best = @(
        $ordered |
            Where-Object { $_.Score -eq $ordered[0].Score } |
            Select-Object Index -Unique
    )

    if ( $best.Count -gt 1) {
        throw 'Có nhiều đường mạng cùng ưu tiên. Hãy ngắt VPN/card phụ rồi thử lại.'
    }

    $chosen = $ordered[0]
    $script:networkLabel.Text = (
        'Đường mạng nhận diện: {0} | index {1} | gateway {2}' -f
        $chosen.Alias, $chosen.Index, $chosen.Gateway
    )
    return $chosen
}

function Backup-Network {
    param([int]$Index)

    $file = Join-Path $script:session (
        'network-{0}-{1}.xml' -f $Index, (Get-Date -Format 'HHmmss-fff')
    )

    [pscustomobject]@{
        Index = $Index
        Interface = @(Get-NetIPInterface -InterfaceIndex $Index)
        Addresses = @(Get-NetIPAddress -InterfaceIndex $Index)
        Routes = @(Get-NetRoute -InterfaceIndex $Index)
        DNS = @(Get-DnsClientServerAddress -InterfaceIndex $Index)
    } | Export-Clixml -LiteralPath $file

    Write-Log "Đã ghi cấu hình mạng tham khảo: $file"
}

function Confirm-Network {
    param( $Network, [string]$Description)

    return Confirm-Action (
        "$Description" +
        "`nCard: $( $Network.Alias), index $( $Network.Index)" +
        "`nCó thể ảnh hưởng VPN, DNS nội bộ và kết nối từ xa." +
        "`nKhông thao tác nếu đang remote qua card này. Tiếp tục?"
    )
}


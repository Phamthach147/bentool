if ($networkTabs -and $networkTabs.TabPages.Count -eq 3) {
    $networkTabs.SizeMode =
        [System.Windows.Forms.TabSizeMode]::Fixed

    $networkTabs.ItemSize = New-Object System.Drawing.Size(142, 42)

    $networkTabs.DrawMode =
        [System.Windows.Forms.TabDrawMode]::OwnerDrawFixed

    $networkTabs.Add_DrawItem({
        param($sender, $e)

        $rect = $sender.GetTabRect($e.Index)

        # Thu nho hinh ve de tao khe ho giua cac tab.
        $cardRect = New-Object System.Drawing.Rectangle(
            ($rect.X + 4),
            ($rect.Y + 4),
            [Math]::Max(1, ($rect.Width - 8)),
            [Math]::Max(1, ($rect.Height - 5))
        )

        $isSelected = ($e.Index -eq $sender.SelectedIndex)

        if ($isSelected) {
            $backColor = [System.Drawing.ColorTranslator]::FromHtml(
                '#315FAD'
            )
            $borderColor = [System.Drawing.ColorTranslator]::FromHtml(
                '#83B2FF'
            )
            $textColor = [System.Drawing.Color]::White
        }
        else {
            $backColor = [System.Drawing.ColorTranslator]::FromHtml(
                '#24334A'
            )
            $borderColor = [System.Drawing.ColorTranslator]::FromHtml(
                '#425570'
            )
            $textColor = [System.Drawing.ColorTranslator]::FromHtml(
                '#DAE5F5'
            )
        }

        $background = New-Object System.Drawing.SolidBrush(
            $backColor
        )
        $border = New-Object System.Drawing.Pen(
            $borderColor, 1
        )

        try {
            $e.Graphics.FillRectangle($background, $cardRect)
            $e.Graphics.DrawRectangle($border, $cardRect)

            $font = New-Object System.Drawing.Font(
                'Segoe UI',
                9,
                [System.Drawing.FontStyle]::Bold
            )

            try {
                [System.Windows.Forms.TextRenderer]::DrawText(
                    $e.Graphics,
                    $sender.TabPages[$e.Index].Text,
                    $font,
                    $cardRect,
                    $textColor,
                    (
                        [System.Windows.Forms.TextFormatFlags]::HorizontalCenter -bor
                        [System.Windows.Forms.TextFormatFlags]::VerticalCenter -bor
                        [System.Windows.Forms.TextFormatFlags]::EndEllipsis
                    )
                )
            }
            finally {
                $font.Dispose()
            }
        }
        finally {
            $background.Dispose()
            $border.Dispose()
        }
    })

    $networkTabs.Invalidate()
}


    $wifiButton = Button 'Ưu tiên Wi-Fi 5 GHz' {
        $n = Active-Network

        if (-not (Wifi-Card $n.Adapter)) {
            throw 'Đường mạng chính hiện không phải Wi-Fi.'
        }

        $properties = @(
            Get-NetAdapterAdvancedProperty `
                -Name $n.Alias `
                -ErrorAction Stop
        )

        $matches = @(
            $properties | Where-Object {
                $_.DisplayName -match
                    '(?i)preferred\s*band|band\s*preference|ưu tiên.*băng'
            }
        )

        if ($matches.Count -ne 1) {
            throw (
                'Driver không có đúng một mục ưu tiên băng tần ' +
                'mà tool nhận diện được. Không chỉnh bừa Registry.'
            )
        }

        $property = $matches[0]
        $values = @(
            $property.ValidDisplayValues |
                Where-Object {
                    $_ -match '(?i)prefer|ưu tiên' -and
                    $_ -match '5\s*G'
                }
        )

        if ($values.Count -ne 1) {
            throw (
                'Driver không cung cấp lựa chọn ưu tiên 5 GHz ' +
                'rõ ràng. Không thay đổi cấu hình.'
            )
        }

        if (-not (Ask (
            "Đặt '$($property.DisplayName)' thành '$($values[0])'?" +
            "`nWi-Fi có thể ngắt khi áp dụng. Không dùng lúc remote."
        ))) { return }

        $property | Select-Object `
            Name, DisplayName, DisplayValue,
            RegistryKeyword, RegistryValue |
            Export-Clixml -LiteralPath (
                Join-Path $script:session 'wifi-truoc.xml'
            )

        Set-NetAdapterAdvancedProperty `
            -Name $n.Alias `
            -DisplayName $property.DisplayName `
            -DisplayValue ([string]$values[0]) `
            -NoRestart `
            -ErrorAction Stop

        Log "Đã đặt ưu tiên 5 GHz trên $($n.Alias)."
        Info (
            'Đã lưu tùy chọn ưu tiên 5 GHz. ' +
            'Có thể cần kết nối lại Wi-Fi để có hiệu lực.'
        )
    } '#059669'

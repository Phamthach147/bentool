    function Set-RegValue {
        param(
            [string]$Path,
            [string]$Name,
            $Value,
            [string]$Kind = 'DWord'
        )

        $existingBackup = @(
            $script:regBackup |
                Where-Object {
                    $_.Path -eq $Path -and $_.Name -eq $Name
                }
        )

        if ($existingBackup.Count -eq 0) {
            $exists = $false
            $oldValue = $null
            $oldKind = $null

            if (Test-Path -LiteralPath $Path) {
                $key = Get-Item -LiteralPath $Path

                if ($key.GetValueNames() -contains $Name) {
                    $exists = $true
                    $oldValue = $key.GetValue($Name)
                    $oldKind = $key.GetValueKind($Name).ToString()
                }
            }

            [void]$script:regBackup.Add([pscustomobject]@{
                Path = $Path
                Name = $Name
                Exists = $exists
                Value = $oldValue
                Kind = $oldKind
            })

            $script:regBackup.ToArray() |
                Export-Clixml -LiteralPath (
                    Join-Path $script:session 'registry-before.xml'
                )
        }

        if (-not (Test-Path -LiteralPath $Path)) {
            New-Item -Path $Path -Force | Out-Null
        }

        $key = Get-Item -LiteralPath $Path
        $valueKind = [Enum]::Parse(
            [Microsoft.Win32.RegistryValueKind], $Kind
        )
        $key.SetValue($Name, $Value, $valueKind)
    }

    function Create-RestorePoint {
        Enable-ComputerRestore -Drive "$($env:SystemDrive)\"

        $start = Get-Date

        Checkpoint-Computer -Description 'Ben Optimizer 2.0' `
            -RestorePointType MODIFY_SETTINGS -WarningAction Stop

        $point = Get-ComputerRestorePoint |
            Sort-Object SequenceNumber -Descending |
            Select-Object -First 1

        if (-not $point) {
            throw 'Không tìm thấy điểm khôi phục vừa tạo.'
        }

        $created = [Management.ManagementDateTimeConverter]::ToDateTime(
            $point.CreationTime
        )

        if ($point.Description -ne 'Ben Optimizer 2.0' -or
            $created -lt $start.AddMinutes(-2)) {
            throw 'Chưa xác nhận được điểm khôi phục mới.'
        }

        Log "Đã tạo điểm khôi phục số $($point.SequenceNumber)."
    }

    function Step {
        param([string]$Name, [scriptblock]$Action)

        Log "Đang chạy: $Name"

        try {
            & $Action
            Log "Đã thực hiện bước: $Name"
        }
        catch {
            $script:stepErrors++
            Log "Thất bại: $Name | $($_.Exception.Message)"
        }
    }

    function Remove-UserApp {
        param([string]$Name)

        $apps = @(Get-AppxPackage -Name $Name)

        if ($apps.Count -eq 0) {
            Log "Không có ứng dụng: $Name"
            return
        }

        foreach ($app in $apps) {
            Remove-AppxPackage -Package $app.PackageFullName
            Log "Đã gửi lệnh gỡ: $($app.Name)"
        }
    }


# Load danh sách interface cho combobox IP tĩnh
function Load-InterfacesStaticIP {
    $cbInterfacesStaticIP.Items.Clear()
    $interfaces = Get-NetworkInterfaces
    foreach ($iface in $interfaces) {
        $cbInterfacesStaticIP.Items.Add($iface.InterfaceAlias)
    }
    if ($cbInterfacesStaticIP.Items.Count -gt 0) {
        $cbInterfacesStaticIP.SelectedIndex = 0
    }
}

# Load IP hiện tại vào ô IP tĩnh khi chọn interface
function Load-CurrentIPStatic {
    param([string]$ifaceAlias)
    $ipInfo = Get-IPv4Info -ifAlias $ifaceAlias | Select-Object -First 1
    if ($ipInfo) {
        $tbIPStatic.Text = $ipInfo.IPAddress
        $tbPrefixStatic.Text = $ipInfo.PrefixLength.ToString()
        $gw = (Get-NetRoute -InterfaceAlias $ifaceAlias -DestinationPrefix "0.0.0.0/0" -ErrorAction SilentlyContinue | Select-Object -First 1).NextHop
        $tbGatewayStatic.Text = $gw
        # DNS hiện tại lấy từ interface
        $dns = (Get-DnsClientServerAddress -InterfaceAlias $ifaceAlias -AddressFamily IPv4 -ErrorAction SilentlyContinue).ServerAddresses
        if ($dns) {
            $tbDNSStatic.Text = $dns -join ", "
        } else {
            $tbDNSStatic.Text = ""
        }
        $lblWarningStaticIP.Text = ""
    } else {
        $tbIPStatic.Text = ""
        $tbPrefixStatic.Text = ""
        $tbGatewayStatic.Text = ""
        $tbDNSStatic.Text = ""
        $lblWarningStaticIP.Text = "Giao diện chưa có IP IPv4 hợp lệ."
    }
}

# Xử lý chọn interface IP tĩnh
$cbInterfacesStaticIP.Add_SelectedIndexChanged({
    $iface = $cbInterfacesStaticIP.SelectedItem
    if ($iface) {
        Load-CurrentIPStatic -ifaceAlias $iface
    }
})

# Xử lý nút làm mới tổng quan

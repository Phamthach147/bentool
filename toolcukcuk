    function Get-CurrentNetwork {
        $candidates = @(
            foreach ($route in @(
                Get-NetRoute -AddressFamily IPv4 `
                    -DestinationPrefix '0.0.0.0/0' `
                    -PolicyStore ActiveStore
            )) {
                $adapter = Get-NetAdapter `
                    -InterfaceIndex $route.InterfaceIndex `
                    -ErrorAction SilentlyContinue

                if (-not $adapter -or $adapter.Status -ne 'Up') {
                    continue
                }

                $ipInterface = Get-NetIPInterface `
                    -InterfaceIndex $route.InterfaceIndex `
                    -AddressFamily IPv4

                [pscustomobject]@{
                    Index = [int]$route.InterfaceIndex
                    Alias = $adapter.Name
                    Gateway = $route.NextHop
                    Score = [int]$route.RouteMetric +
                        [int]$ipInterface.InterfaceMetric
                }
            }
        )

        if ($candidates.Count -eq 0) {
            throw 'Chưa tìm được đường mạng IPv4 đang hoạt động.'
        }

        $sorted = @($candidates | Sort-Object Score)

        $best = @(
            $sorted |
                Where-Object { $_.Score -eq $sorted[0].Score } |
                Select-Object Index -Unique
        )

        if ($best.Count -gt 1) {
            throw 'Nhiều card cùng ưu tiên. Ngắt VPN/card phụ rồi lấy IP lại.'
        }

        $script:lastNetwork = $sorted[0]
        return $sorted[0]
    }

    function Fill-CurrentIP {
        param([switch]$Quiet)

        $n = Get-CurrentNetwork

        $addresses = @(
            Get-NetIPAddress -InterfaceIndex $n.Index `
                -AddressFamily IPv4 |
                Where-Object {
                    $_.AddressState -eq 'Preferred' -and
                    -not $_.SkipAsSource -and
                    $_.IPAddress -notlike '169.254.*' -and
                    $_.IPAddress -notlike '127.*'
                }
        )

        if ($addresses.Count -ne 1) {
            $script:networkInfo.Text = (
                "Card: $($n.Alias) | IPv4: " +
                ($addresses.IPAddress -join ', ')
            )

            throw 'Không có đúng một IPv4 để tự điền. Hãy kiểm tra mạng.'
        }

        $address = $addresses[0]

        $script:ipInput.Text = $address.IPAddress
        $script:prefixInput.Text = [string]$address.PrefixLength
        $script:gatewayInput.Text = $n.Gateway

        $script:networkInfo.Text = (
            '{0} | IP: {1}/{2} | Gateway: {3}' -f
            $n.Alias, $address.IPAddress,
            $address.PrefixLength, $n.Gateway
        )

        if (-not $Quiet) {
            Log "Đã đọc IP hiện tại: $($address.IPAddress)"
        }
    }

    function Backup-Network {
        param([int]$Index)

        $file = Join-Path $script:session (
            'network-{0}-{1}.xml' -f
            $Index, (Get-Date -Format 'HHmmss-fff')
        )

        [pscustomobject]@{
            Index = $Index
            Interface = @(Get-NetIPInterface -InterfaceIndex $Index)
            IP = @(Get-NetIPAddress -InterfaceIndex $Index)
            Routes = @(Get-NetRoute -InterfaceIndex $Index)
            DNS = @(Get-DnsClientServerAddress -InterfaceIndex $Index)
        } | Export-Clixml -LiteralPath $file

        Log "Đã lưu cấu hình mạng: $file"
    }

    function Validate-IP {
        param([string]$Value)

        if ($Value -notmatch '^\d{1,3}(\.\d{1,3}){3}$') {
            throw "IPv4 không hợp lệ: $Value"
        }

        foreach ($part in ($Value -split '\.')) {
            if ([int]$part -gt 255) {
                throw "IPv4 không hợp lệ: $Value"
            }
        }

        return [Net.IPAddress]::Parse($Value)
    }


    function Measure-DNS {
        $results = @()

        foreach ($provider in @(
            [pscustomobject]@{
                Name = 'Cloudflare'
                IP = '1.1.1.1'
                Secondary = '1.0.0.1'
            },
            [pscustomobject]@{
                Name = 'Google'
                IP = '8.8.8.8'
                Secondary = '8.8.4.4'
            }
        )) {
            $times = @()

            foreach ($hostName in @(
                'www.microsoft.com',
                'www.github.com',
                'www.wikipedia.org'
            )) {
                $watch = [System.Diagnostics.Stopwatch]::StartNew()

                try {
                    $answer = @(
                        Resolve-DnsName `
                            -Name $hostName `
                            -Type A `
                            -Server $provider.IP `
                            -DnsOnly `
                            -NoHostsFile `
                            -QuickTimeout `
                            -ErrorAction Stop
                    )

                    $watch.Stop()

                    if ($answer | Where-Object IPAddress) {
                        $times += $watch.Elapsed.TotalMilliseconds
                    }
                }
                catch {
                    $watch.Stop()
                }
            }

            if ($times.Count -gt 0) {
                $average = ($times |
                    Measure-Object -Average).Average

                $results += [pscustomobject]@{
                    Name = $provider.Name
                    Servers = @(
                        $provider.IP,
                        $provider.Secondary
                    )
                    Success = $times.Count
                    Average = [double]$average
                }

                Log (
                    '{0}: {1}/3 lượt, trung bình {2:N1} ms' -f
                    $provider.Name, $times.Count, $average
                )
            }
        }

        $winner = $results |
            Where-Object { $_.Success -ge 2 } |
            Sort-Object `
                @{ Expression = 'Success'; Descending = $true },
                @{ Expression = 'Average'; Descending = $false } |
            Select-Object -First 1

        if (-not $winner) {
            throw 'Đo DNS không đủ kết quả. DNS hiện tại không đổi.'
        }

        return $winner
    }


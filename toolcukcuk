    function Refresh-Network {
        $n = Active-Network
        $script:ipChoice.Items.Clear()

        $ips = @(
            Get-NetIPAddress -InterfaceIndex $n.Index `
                -AddressFamily IPv4 |
                Where-Object {
                    $_.AddressState -eq 'Preferred' -and
                    $_.IPAddress -notlike '169.254.*' -and
                    $_.IPAddress -notlike '127.*'
                }
        )

        foreach ($ip in $ips) {
            $entry = [pscustomobject]@{
                Display = '{0}/{1}' -f
                    $ip.IPAddress, $ip.PrefixLength
                IPAddress = [string]$ip.IPAddress
                PrefixLength = [int]$ip.PrefixLength
            }
            [void]$script:ipChoice.Items.Add($entry)
        }

        $script:ipChoice.DisplayMember = 'Display'
        $script:gatewayInput.Text = $n.Gateway

        if ($script:ipChoice.Items.Count -gt 0) {
            $script:ipChoice.SelectedIndex = 0
        }

        $kind = 'LAN / kết nối khác'
        $extra = ''

        if (Wifi-Card $n.Adapter) {
            $kind = 'Wi-Fi'
            $wifi = Wifi-Details
            $extra = ' | SSID: {0} | Băng tần: {1} | Sóng: {2}' -f
                $wifi.SSID, $wifi.Band, $wifi.Signal
        }

        $script:connectionInfo.Text = (
            '{0} | Card: {1} | Gateway: {2}{3}' -f
            $kind, $n.Alias, $n.Gateway, $extra
        )

        Log (
            "Đã nhận card $($n.Alias), " +
            "$($ips.Count) IPv4. Chưa sửa cấu hình."
        )
    }

    $staticButton = Button 'Đặt IP tĩnh' {
        $n = Active-Network
        $ip = $script:ipInput.Text.Trim()
        $gw = $script:gatewayInput.Text.Trim()

        $null = IPv4 $ip
        $null = IPv4 $gw

        $prefix = 0
        if (
            -not [int]::TryParse(
                $script:prefixInput.Text.Trim(),
                [ref]$prefix
            ) -or
            $prefix -lt 1 -or $prefix -gt 30
        ) {
            throw 'Prefix phải là số từ 1 đến 30.'
        }

        $existing = @(
            Get-NetIPAddress -InterfaceIndex $n.Index `
                -AddressFamily IPv4 |
                Where-Object {
                    $_.IPAddress -notlike '169.254.*'
                }
        )

        if ($existing.Count -ne 1) {
            throw (
                'Card đang có nhiều hoặc không có IPv4. ' +
                'Để tránh xóa IP thiết bị khác, tool không tự đặt tĩnh. ' +
                'Hãy dùng cấu hình mạng thủ công.'
            )
        }

        if ($ip -eq $gw) {
            throw 'IP máy không được trùng gateway.'
        }

        if (-not (Ask (
            "Đặt IP $ip/$prefix, gateway $gw trên card $($n.Alias)?" +
            "`nThao tác có thể ngắt mạng. Không dùng khi đang remote." +
            "`nNếu IP do DHCP cấp, nên giữ chỗ IP này trên router."
        ))) { return }

        Network-Backup $n.Index

        $oldDns = @(
            (Get-DnsClientServerAddress `
                -InterfaceIndex $n.Index `
                -AddressFamily IPv4).ServerAddresses
        )

        # netsh thay địa chỉ chính; không dùng nhánh này khi card có nhiều IP.
        $output = & "$env:SystemRoot\System32\netsh.exe" `
            interface ipv4 set address `
            name="$($n.Alias)" source=static `
            address="$ip" `
            mask=(
                [string](
                    & "$env:SystemRoot\System32\powershell.exe" `
                        -NoProfile -Command (
                            '$p=' + $prefix +
                            ';$b=([uint32]0xffffffff) -shl (32-$p);' +
                            '[string]::Join(''.'',@(' +
                            '24,16,8,0|%{($b -shr $_) -band 255}))'
                        )
                )
            ) `
            gateway="$gw" 2>&1

        if ($LASTEXITCODE -ne 0) {
            throw ('Không đặt được IP: ' + ($output | Out-String))
        }

        if ($oldDns.Count -gt 0) {
            Set-DnsClientServerAddress `
                -InterfaceIndex $n.Index `
                -ServerAddresses $oldDns
        }

        Log "Đã yêu cầu đặt IP tĩnh $ip/$prefix, gateway $gw."
        Info 'Đã gửi cấu hình IP. Hãy kiểm tra lại kết nối mạng.'
    }

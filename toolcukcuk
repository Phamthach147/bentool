            $tbDNSSecondary.ReadOnly = $true
            $lblMeasureResult.Text = "Nhấn 'Đo Nhanh Nhất' để đo DNS nhanh nhất."
        } elseif ($sel -eq "Tự động DHCP") {
            $tbDNSPrimary.Text = ""
            $tbDNSSecondary.Text = ""
            $tbDNSPrimary.ReadOnly = $true
            $tbDNSSecondary.ReadOnly = $true
            $lblMeasureResult.Text = "DNS tự động lấy từ DHCP."
        } else {
            $tbDNSPrimary.Text = $provider.Servers[0]
            $tbDNSSecondary.Text = $provider.Servers[1]
            $tbDNSPrimary.ReadOnly = $true
            $tbDNSSecondary.ReadOnly = $true

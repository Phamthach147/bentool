function ConvertTo-CCIPv4Number {
    param([Parameter(Mandatory = $true)][string]$Address)

    if ($Address -notmatch '^\d{1,3}(\.\d{1,3}){3}$') {
        throw ('IPv4 không hợp lệ: {0}' -f $Address)
    }

    $parts = $Address.Split('.')
    [uint64]$number = 0

    foreach ($part in $parts) {
        $value = [int]$part
        if ($value -gt 255) {
            throw ('IPv4 không hợp lệ: {0}' -f $Address)
        }
        $number = $number * 256 + $value
    }

    return $number
}

function ConvertFrom-CCIPv4Number {
    param([uint64]$Number)

    if ($Number -gt 4294967295) { throw 'Giá trị IPv4 vượt phạm vi.' }

    return ('{0}.{1}.{2}.{3}' -f
        (($Number -shr 24) -band 255),
        (($Number -shr 16) -band 255),
        (($Number -shr 8) -band 255),
        ($Number -band 255))
}

function Get-CCSubnetInfo {
    param(
        [Parameter(Mandatory = $true)][string]$IPAddress,
        [ValidateRange(1, 30)][int]$PrefixLength
    )

    $number = ConvertTo-CCIPv4Number $IPAddress
    [uint64]$size = [Math]::Pow(2, (32 - $PrefixLength))
    [uint64]$network = [Math]::Floor($number / $size) * $size
    [uint64]$broadcast = $network + $size - 1
    [uint64]$mask = 4294967295 - ($size - 1)

    [pscustomobject]@{
        NetworkNumber = $network
        BroadcastNumber = $broadcast
        Network = ConvertFrom-CCIPv4Number $network
        Broadcast = ConvertFrom-CCIPv4Number $broadcast
        Mask = ConvertFrom-CCIPv4Number $mask
        IsHost = ($number -gt $network -and $number -lt $broadcast)
    }
}

function Assert-CCStaticIPv4 {
    param([string]$IPAddress, [int]$PrefixLength, [string]$Gateway)

    $number = ConvertTo-CCIPv4Number $IPAddress
    $first = [int]($number -shr 24)

    if ($first -eq 0 -or $first -eq 127 -or $first -ge 224) {
        throw 'Không dùng địa chỉ loopback, multicast hoặc địa chỉ dành riêng làm IP máy.'
    }

    $subnet = Get-CCSubnetInfo $IPAddress $PrefixLength
    if (-not $subnet.IsHost) {
        throw 'IP máy trùng địa chỉ mạng hoặc broadcast.'
    }

    if (-not [string]::IsNullOrWhiteSpace($Gateway)) {
        $gw = ConvertTo-CCIPv4Number $Gateway
        if ($gw -le $subnet.NetworkNumber -or
            $gw -ge $subnet.BroadcastNumber -or
            $gw -eq $number) {
            throw 'Gateway phải là địa chỉ host khác IP máy và nằm trong cùng subnet.'
        }
    }
}

function Get-CCNetworkOverview {
    $adapters = @(Get-NetAdapter -IncludeHidden -ErrorAction Stop)
    $routes = @(Get-NetRoute -AddressFamily IPv4 `
        -DestinationPrefix '0.0.0.0/0' -ErrorAction SilentlyContinue)
    $interfaces = @(Get-NetIPInterface -AddressFamily IPv4 -ErrorAction Stop)

    $ranked = @(
        foreach ($route in $routes) {
            $iface = $interfaces | Where-Object {
                $_.InterfaceIndex -eq $route.InterfaceIndex
            } | Select-Object -First 1

            if ($iface.ConnectionState -eq 'Connected') {
                [pscustomobject]@{
                    Index = $route.InterfaceIndex
                    Score = [int]$route.RouteMetric + [int]$iface.InterfaceMetric
                }
            }
        }
    )

    $preferred = $ranked | Sort-Object Score | Select-Object -First 1
    $sourceIP = $null

    try {
        $best = @(Find-NetRoute -RemoteIPAddress '1.1.1.1' -ErrorAction Stop)
        $sourceIP = $best | Where-Object {
            $_.PSObject.Properties.Name -contains 'IPAddress'
        } | Select-Object -First 1
    }
    catch {
        # Khong co route Internet van co the co mang noi bo.
    }
    # Doc danh sach DNS mot lan.
    # Loi truy van that van duoc bao; card khong co ban ghi
    # se khong lam hong toan bo luot doc mang.
    $ccAllIPv4DNS = @(
        Get-DnsClientServerAddress -AddressFamily IPv4 -ErrorAction Stop
        )

    foreach ($adapter in $adapters) {
        if ($adapter.Status -ne 'Up' -and
            $adapter.InterfaceIndex -ne $preferred.Index) {
            continue
        }

        $addresses = @(Get-NetIPAddress -InterfaceIndex $adapter.InterfaceIndex `
            -AddressFamily IPv4 -ErrorAction SilentlyContinue |
            Where-Object { $_.IPAddress -ne '127.0.0.1' })

        $gateway = @($routes | Where-Object {
            $_.InterfaceIndex -eq $adapter.InterfaceIndex
        } | Select-Object -ExpandProperty NextHop -Unique)

        $ccAdapterDNS = @(
    $ccAllIPv4DNS | Where-Object {
        [int]$_.InterfaceIndex -eq [int]$adapter.InterfaceIndex
    }
)

$ccDNSServers = @(
    foreach ($ccDNSRecord in $ccAdapterDNS) {
        foreach ($ccServer in @($ccDNSRecord.ServerAddresses)) {
            if (-not [string]::IsNullOrWhiteSpace([string]$ccServer)) {
                [string]$ccServer
            }
        }
    }
)


        $type = 'LAN'
        if ([int]$adapter.NdisPhysicalMedium -eq 9 -or
            $adapter.InterfaceDescription -match 'Wireless|Wi-Fi|802\.11') {
            $type = 'Wi-Fi'
        }
        elseif ($adapter.Virtual -or -not $adapter.HardwareInterface) {
            $type = 'VPN / card ảo'
        }

        [pscustomobject]@{
            InterfaceIndex = [int]$adapter.InterfaceIndex
            InterfaceGuid = [string]$adapter.InterfaceGuid
            Name = $adapter.Name
            Type = $type
            Description = $adapter.InterfaceDescription
            MAC = $adapter.MacAddress
            Status = [string]$adapter.Status
            IPv4 = @($addresses | Select-Object IPAddress, PrefixLength,
                PrefixOrigin, AddressState, SkipAsSource)
            Gateway = $gateway
            DNS = @($ccDNSServers | Select-Object -Unique)
            Preferred = ($adapter.InterfaceIndex -eq $preferred.Index)
            SourceIPv4 = $(if ($sourceIP.InterfaceIndex -eq $adapter.InterfaceIndex) {
                $sourceIP.IPAddress
            } else { $null })
            SourceDestination = '1.1.1.1, chỉ tra bảng định tuyến'
            SSID = 'Chưa xác định'
            Band = 'Chưa xác định'
            Signal = 'Chưa xác định'
            Channel = 'Chưa xác định'
        }
    }
}

function Assert-CCAdapterIdentity {
    param([int]$InterfaceIndex, [string]$InterfaceGuid)

    $adapter = Get-NetAdapter -InterfaceIndex $InterfaceIndex -ErrorAction Stop

    if ([string]$adapter.InterfaceGuid -ne $InterfaceGuid) {
        throw 'Card mạng đã thay đổi. Hãy làm mới và xác nhận lại.'
    }

    return $adapter
}

function Save-CCNetworkSnapshot {
    param($Context, [int]$InterfaceIndex, [string]$InterfaceGuid)

    $adapter = Assert-CCAdapterIdentity $InterfaceIndex $InterfaceGuid
    $interface = Get-NetIPInterface -InterfaceIndex $InterfaceIndex `
        -AddressFamily IPv4 -ErrorAction Stop

    $guid = ([guid]$adapter.InterfaceGuid).ToString('B')
    $dnsSetting = Get-CCRegistryValue -Hive LocalMachine `
        -SubKey ('SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces\{0}' -f $guid) `
        -Name NameServer

    $data = [pscustomobject]@{
        InterfaceIndex = $InterfaceIndex
        InterfaceGuid = $InterfaceGuid
        Name = $adapter.Name
        DHCP = [string]$interface.Dhcp
        IP = @(Get-NetIPAddress -InterfaceIndex $InterfaceIndex `
            -AddressFamily IPv4 -ErrorAction Stop |
            Select-Object IPAddress, PrefixLength, PrefixOrigin, SkipAsSource)
        Routes = @(Get-NetRoute -InterfaceIndex $InterfaceIndex `
            -AddressFamily IPv4 -ErrorAction Stop |
            Select-Object DestinationPrefix, NextHop, RouteMetric, Protocol)
        DNS = @((Get-DnsClientServerAddress -InterfaceIndex $InterfaceIndex `
            -AddressFamily IPv4 -ErrorAction Stop).ServerAddresses)
        DNSAutomatic = [string]::IsNullOrWhiteSpace([string]$dnsSetting.Value)
    }

    return (Save-CCSnapshot $Context 'Network' $data)
}

function Get-CCRouteFingerprint {
    param([int]$InterfaceIndex)

    $addresses = @(Get-NetIPAddress -InterfaceIndex $InterfaceIndex `
        -AddressFamily IPv4 -ErrorAction Stop |
        Sort-Object IPAddress |
        ForEach-Object { '{0}/{1}' -f $_.IPAddress, $_.PrefixLength })

    $routes = @(Get-NetRoute -AddressFamily IPv4 -ErrorAction Stop |
        Sort-Object InterfaceIndex, DestinationPrefix, NextHop |
        ForEach-Object {
            '{0}|{1}|{2}|{3}' -f $_.InterfaceIndex,
                $_.DestinationPrefix, $_.NextHop, $_.RouteMetric
        })

    return (($addresses + $routes) -join ';')
}


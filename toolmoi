function Set-CCIPv4Configuration {
    param($InputData, $Context)

    $index = [int]$InputData.InterfaceIndex
    $guid = [string]$InputData.InterfaceGuid
    $adapter = Assert-CCAdapterIdentity $index $guid

    if ($adapter.Virtual -or -not $adapter.HardwareInterface) {
        throw 'Bản thử nghiệm không tự sửa IP trên VPN/card ảo.'
    }

    $addresses = @(Get-NetIPAddress -InterfaceIndex $index `
        -AddressFamily IPv4 -ErrorAction Stop)

    $defaults = @(Get-NetRoute -InterfaceIndex $index `
        -AddressFamily IPv4 -DestinationPrefix '0.0.0.0/0' `
        -ErrorAction SilentlyContinue)

    if ($InputData.Mode -eq 'DHCP') {
        if (-not $InputData.RemoveManualConfirmed) {
            throw 'Chưa xác nhận xóa IPv4/tuyến mặc định Manual trên card này.'
        }

        $backup = Save-CCNetworkSnapshot $Context $index $guid

        foreach ($route in @($defaults | Where-Object Protocol -eq 'NetMgmt')) {
            $route | Remove-NetRoute -Confirm:$false -ErrorAction Stop
        }

        foreach ($address in @($addresses | Where-Object PrefixOrigin -eq 'Manual')) {
            $address | Remove-NetIPAddress -Confirm:$false -ErrorAction Stop
        }

        Set-NetIPInterface -InterfaceIndex $index -AddressFamily IPv4 `
            -Dhcp Enabled -ErrorAction Stop

        # Chi reset DNS IPv4.
        Get-DnsClientServerAddress -InterfaceIndex $index `
            -AddressFamily IPv4 -ErrorAction Stop |
            Set-DnsClientServerAddress -ResetServerAddresses -ErrorAction Stop

        $check = Get-NetIPInterface -InterfaceIndex $index `
            -AddressFamily IPv4 -ErrorAction Stop

        if ([string]$check.Dhcp -ne 'Enabled') {
            throw ('Chưa xác nhận DHCP Enabled. Sao lưu: {0}' -f $backup)
        }

        $dnsKey = 'SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces\{0}' -f (
            ([guid]$guid).ToString('B')
        )
        $dnsCheck = Get-CCRegistryValue -Hive LocalMachine `
            -SubKey $dnsKey -Name NameServer

        if (-not [string]::IsNullOrWhiteSpace([string]$dnsCheck.Value)) {
            throw ('DHCP đã bật nhưng DNS thủ công vẫn còn. Sao lưu: {0}' -f $backup)
        }

        New-CCResult 'Trả IPv4/DNS về DHCP' Info (
            'Đã xác nhận DHCP Enabled và bỏ DNS IPv4 thủ công. ' +
            'Chưa bảo đảm đã nhận lease mới. Bấm Làm mới để kiểm tra. Sao lưu: {0}' -f
            $backup
        )
        return
    }

    $ip = ([string]$InputData.IP).Trim()
    $prefix = [int]$InputData.Prefix
    $gateway = ([string]$InputData.Gateway).Trim()

    Assert-CCStaticIPv4 $ip $prefix $gateway

    if ($addresses.Count -gt 1 -or $defaults.Count -gt 1) {
        throw (
            'Card có nhiều IPv4 hoặc nhiều gateway. Không tự xóa IP phụ. ' +
            'Hãy dùng nút Cấu hình Windows để chỉnh có chủ đích.'
        )
    }

    $beforeInterface = Get-NetIPInterface -InterfaceIndex $index `
        -AddressFamily IPv4 -ErrorAction Stop

    $backup = Save-CCNetworkSnapshot $Context $index $guid

    try {
        Set-NetIPInterface -InterfaceIndex $index -AddressFamily IPv4 `
            -Dhcp Disabled -ErrorAction Stop

        # Sau khi tat DHCP, doc lai vi dia chi DHCP co the da bien mat.
        $current = @(Get-NetIPAddress -InterfaceIndex $index `
            -AddressFamily IPv4 -ErrorAction SilentlyContinue)

        foreach ($address in $current) {
            if ($address.IPAddress -ne $ip -or
                [string]$address.PrefixOrigin -ne 'Manual') {
                $address | Remove-NetIPAddress -Confirm:$false -ErrorAction Stop
            }
        }

        $same = @(Get-NetIPAddress -InterfaceIndex $index `
            -AddressFamily IPv4 -ErrorAction SilentlyContinue |
            Where-Object IPAddress -eq $ip)

        if ($same.Count -gt 0) {
            $same | Set-NetIPAddress -PrefixLength $prefix -ErrorAction Stop
        }
        else {
            [void](New-NetIPAddress -InterfaceIndex $index `
                -IPAddress $ip -PrefixLength $prefix -ErrorAction Stop)
        }

        $routesNow = @(Get-NetRoute -InterfaceIndex $index `
            -AddressFamily IPv4 -DestinationPrefix '0.0.0.0/0' `
            -ErrorAction SilentlyContinue)

        foreach ($route in $routesNow) {
            if ($route.NextHop -ne $gateway) {
                $route | Remove-NetRoute -Confirm:$false -ErrorAction Stop
            }
        }

        if (-not [string]::IsNullOrWhiteSpace($gateway)) {
            $matchingRoute = @(Get-NetRoute -InterfaceIndex $index `
                -AddressFamily IPv4 -DestinationPrefix '0.0.0.0/0' `
                -ErrorAction SilentlyContinue |
                Where-Object NextHop -eq $gateway)

            if ($matchingRoute.Count -eq 0) {
                [void](New-NetRoute -InterfaceIndex $index `
                    -AddressFamily IPv4 -DestinationPrefix '0.0.0.0/0' `
                    -NextHop $gateway -ErrorAction Stop)
            }
        }

        # Cho Windows co thoi gian kiem tra trung dia chi.
        $verified = $null
        for ($attempt = 0; $attempt -lt 8; $attempt++) {
            Start-Sleep -Milliseconds 500
            $verified = Get-NetIPAddress -InterfaceIndex $index `
                -AddressFamily IPv4 -IPAddress $ip -ErrorAction Stop

            if ([string]$verified.AddressState -ne 'Tentative') { break }
        }

        if ([string]$verified.AddressState -eq 'Duplicate') {
            throw 'Windows phát hiện IP trùng. Cần đổi IP hoặc trả DHCP.'
        }

        if ($verified.PrefixLength -ne $prefix -or
            [string]$verified.PrefixOrigin -ne 'Manual') {
            throw 'IP/prefix đọc lại không khớp cấu hình tĩnh.'
        }

        $dhcpCheck = Get-NetIPInterface -InterfaceIndex $index `
            -AddressFamily IPv4 -ErrorAction Stop
        if ([string]$dhcpCheck.Dhcp -ne 'Disabled') {
            throw 'DHCP chưa ở trạng thái Disabled.'
        }

        $routeCheck = @(Get-NetRoute -InterfaceIndex $index `
            -AddressFamily IPv4 -DestinationPrefix '0.0.0.0/0' `
            -ErrorAction SilentlyContinue)

        if ($gateway -and $gateway -notin @($routeCheck.NextHop)) {
            throw 'Chưa đọc lại được gateway yêu cầu.'
        }
        if (-not $gateway -and $routeCheck.Count -gt 0) {
            throw 'Vẫn còn default route dù gateway yêu cầu để trống.'
        }

        New-CCResult 'Đặt IPv4 tĩnh' Info (
            'Đọc lại: {0}/{1}; gateway {2}; trạng thái {3}. ' +
            'Chưa kiểm tra kết nối CUKCUK hoặc khả năng duy trì sau khởi động lại. ' +
            'Sao lưu: {4}' -f
            $ip, $prefix, $gateway, $verified.AddressState, $backup
        )
    }
    catch {
        throw (
            'Thay đổi IP chưa hoàn tất: {0}. Có thể đã thay đổi một phần. ' +
            'Không tự phục hồi mù. Chọn lại card bằng danh sách đang giữ, ' +
            'dùng DHCP hoặc cấu hình Windows. Sao lưu: {1}' -f
            $_.Exception.Message, $backup
        )
    }
}


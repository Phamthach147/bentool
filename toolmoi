function New-CCLayout {
    param([int]$Columns = 1, [int]$Rows = 1)

    $control = New-Object Windows.Forms.TableLayoutPanel
    $control.Dock = 'Fill'
    $control.Margin = New-Object Windows.Forms.Padding(0)
    $control.Padding = New-Object Windows.Forms.Padding(6)
    $control.ColumnCount = $Columns
    $control.RowCount = $Rows
    $control.BackColor = $script:CC.Colors.Background

    for ($i = 0; $i -lt $Columns; $i++) {
        [void]$control.ColumnStyles.Add(
            (New-Object Windows.Forms.ColumnStyle(
                [Windows.Forms.SizeType]::Percent, (100.0 / $Columns)
            ))
        )
    }
    for ($i = 0; $i -lt $Rows; $i++) {
        [void]$control.RowStyles.Add(
            (New-Object Windows.Forms.RowStyle(
                [Windows.Forms.SizeType]::Percent, (100.0 / $Rows)
            ))
        )
    }

    return ,$control
}


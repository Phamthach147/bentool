function Save-CCSnapshot {
    param(
        [Parameter(Mandatory = $true)]$Context,
        [Parameter(Mandatory = $true)][string]$Kind,
        [Parameter(Mandatory = $true)]$Data
    )

    if (-not [IO.Directory]::Exists($Context.SessionDir)) {
        throw 'Thư mục sao lưu chưa sẵn sàng.'
    }

    $safeKind = $Kind -replace '[^A-Za-z0-9_-]', '_'
    $name = '{0}_{1}_{2}.clixml' -f (
        Get-Date -Format 'yyyyMMdd_HHmmss_ffff'
    ), $safeKind, ([guid]::NewGuid().ToString('N'))

    $path = Join-Path $Context.SessionDir $name

    $record = [pscustomobject]@{
        Schema   = 1
        Kind     = $Kind
        Created  = Get-Date
        Computer = $env:COMPUTERNAME
        UserSid  = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value
        Data     = $Data
    }

    $record | Export-Clixml -LiteralPath $path -Depth 16 -ErrorAction Stop

    if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
        throw 'Không tạo được bản sao lưu. Đã dừng trước khi thay đổi.'
    }

    return $path
}

function Set-CCRegistryValue {
    param(
        [Parameter(Mandatory = $true)]$Context,
        [ValidateSet('LocalMachine', 'CurrentUser')]
        [string]$Hive = 'LocalMachine',
        [Parameter(Mandatory = $true)][string]$SubKey,
        [Parameter(Mandatory = $true)]
        [AllowEmptyString()][string]$Name,
        [Parameter(Mandatory = $true)]
        [AllowEmptyString()]$Value,
        [ValidateSet('DWord', 'QWord', 'String', 'ExpandString',
            'MultiString', 'Binary')]
        [string]$Kind = 'DWord'
    )

    $before = Get-CCRegistryValue -Hive $Hive -SubKey $SubKey -Name $Name

    # Khong ghi neu dung gia tri va dung kieu.
    if ($before.ValueExists -and $before.Kind -eq $Kind) {
        $oldSerialized = [Management.Automation.PSSerializer]::Serialize(
            $before.Value
        )
        $newTyped = $Value

        switch ($Kind) {
            DWord       { $newTyped = [int]$Value }
            QWord       { $newTyped = [long]$Value }
            String      { $newTyped = [string]$Value }
            ExpandString { $newTyped = [string]$Value }
            MultiString { $newTyped = [string[]]$Value }
            Binary      { $newTyped = [byte[]]$Value }
        }

        if ($oldSerialized -eq
            [Management.Automation.PSSerializer]::Serialize($newTyped)) {
            return
        }
    }

    $backup = Save-CCSnapshot $Context 'Registry' $before
    $base = $null
    $key = $null

    try {
        $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey(
            [Microsoft.Win32.RegistryHive]::$Hive,
            [Microsoft.Win32.RegistryView]::$($before.View)
        )

        $key = $base.CreateSubKey($SubKey)

        if ($null -eq $key) {
            throw 'Không tạo hoặc mở được khóa Registry.'
        }

        $typedValue = $Value

        switch ($Kind) {
            DWord        { $typedValue = [int]$Value }
            QWord        { $typedValue = [long]$Value }
            String       { $typedValue = [string]$Value }
            ExpandString { $typedValue = [string]$Value }
            MultiString  { $typedValue = [string[]]$Value }
            Binary       { $typedValue = [byte[]]$Value }
        }

        $key.SetValue(
            $Name,
            $typedValue,
            [Microsoft.Win32.RegistryValueKind]::$Kind
        )
        $key.Flush()

        $readBack = $key.GetValue(
            $Name, $null,
            [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames
        )

        if ($key.GetValueKind($Name).ToString() -ne $Kind -or
            [Management.Automation.PSSerializer]::Serialize($readBack) -ne
            [Management.Automation.PSSerializer]::Serialize($typedValue)) {
            throw ('Đọc lại không khớp. Bản sao lưu: {0}' -f $backup)
        }
    }
    finally {
        if ($null -ne $key) { $key.Dispose() }
        if ($null -ne $base) { $base.Dispose() }
    }
}

function Restore-CCRegistrySnapshot {
    param(
        [Parameter(Mandatory = $true)]$Context,
        [Parameter(Mandatory = $true)][string]$Path
    )

    $record = Import-Clixml -LiteralPath $Path -ErrorAction Stop

    if ($record.Schema -ne 1 -or $record.Kind -ne 'Registry') {
        throw 'Không phải bản sao lưu Registry được hỗ trợ.'
    }

    if ($record.Computer -ne $env:COMPUTERNAME) {
        throw 'Bản sao lưu thuộc máy khác.'
    }

    $old = $record.Data
    $sid = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value

    if ($old.Hive -eq 'CurrentUser' -and $record.UserSid -ne $sid) {
        throw 'Bản sao lưu thuộc tài khoản Windows khác.'
    }

    if ($old.Hive -notin @('CurrentUser', 'LocalMachine') -or
        $old.View -notin @('Registry32', 'Registry64')) {
        throw 'Thông tin Registry trong bản sao lưu không hợp lệ.'
    }

    if ($old.ValueExists) {
        Set-CCRegistryValue -Context $Context -Hive $old.Hive `
            -SubKey $old.SubKey -Name $old.Name `
            -Value $old.Value -Kind $old.Kind
    }
    else {
        $current = Get-CCRegistryValue -Hive $old.Hive `
            -SubKey $old.SubKey -Name $old.Name -View $old.View

        if ($current.ValueExists) {
            [void](Save-CCSnapshot $Context 'Registry' $current)
            $base = $null
            $key = $null

            try {
                $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey(
                    [Microsoft.Win32.RegistryHive]::$($old.Hive),
                    [Microsoft.Win32.RegistryView]::$($old.View)
                )
                $key = $base.OpenSubKey($old.SubKey, $true)
                if ($null -ne $key) {
                    $key.DeleteValue($old.Name, $false)
                    $key.Flush()
                }
            }
            finally {
                if ($null -ne $key) { $key.Dispose() }
                if ($null -ne $base) { $base.Dispose() }
            }
        }

        $check = Get-CCRegistryValue -Hive $old.Hive `
            -SubKey $old.SubKey -Name $old.Name -View $old.View

        if ($check.ValueExists) {
            throw 'Giá trị vẫn tồn tại sau khi khôi phục.'
        }

        # Khong xoa ca key, vi co the da co gia tri cua ung dung khac.
    }

    New-CCResult 'Khôi phục Registry' PendingRestart `
        'Đã đọc lại giá trị. Có thể cần đăng xuất hoặc khởi động lại.'
}


function Initialize-CCStorage {
    [CmdletBinding()]
    param()

    # Chi tao thu muc khi ham duoc goi.
    if ($script:CC.SessionDir) {
        return
    }

    $directory = Join-Path `
        $script:CC.Root `
        ('Sessions\' + $script:CC.SessionId)

    [void][IO.Directory]::CreateDirectory($directory)

    $script:CC.SessionDir = $directory
    $script:CC.LogPath = Join-Path $directory 'activity.log'
}

function Write-CCLog {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Message,

        [ValidateSet('INFO', 'OK', 'WARN', 'ERROR')]
        [string]$Level = 'INFO'
    )

    # Chi goi ham nay tren luong giao dien.
    # Worker se gui du lieu ve, khong cham vao control.

    $line = '[{0}] [{1}] {2}' -f (
        Get-Date -Format 'HH:mm:ss'
    ), $Level, $Message

    try {
        Initialize-CCStorage

        $encoding = New-Object System.Text.UTF8Encoding($true)

        [IO.File]::AppendAllText(
            $script:CC.LogPath,
            $line + [Environment]::NewLine,
            $encoding
        )
    }
    catch {
        Write-Warning (
            'Không ghi được nhật ký: {0}' -f
            $_.Exception.Message
        )
    }

    $box = $script:CC.LogBox

    if ($null -ne $box -and -not $box.IsDisposed) {
        if ($box.InvokeRequired) {
            throw 'Write-CCLog phải được gọi trên luồng giao diện.'
        }

        if ($box.TextLength -gt 60000) {
            $box.Clear()
        }

        $box.AppendText($line + [Environment]::NewLine)
        $box.SelectionStart = $box.TextLength
        $box.ScrollToCaret()
    }
}

function New-CCResult {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Action,

        [Parameter(Mandatory = $true)]
        [ValidateSet(
            'Success',
            'PendingRestart',
            'NotPresent',
            'Unsupported',
            'Failed',
            'NeedsConfirmation',
            'Info'
        )]
        [string]$Status,

        [string]$Reason = '',

        [object]$Data = $null
    )

    $labels = @{
        Success           = 'Thành công'
        PendingRestart    = 'Đã cấu hình, cần khởi động lại'
        NotPresent        = 'Không có trên máy'
        Unsupported       = 'Không hỗ trợ'
        Failed            = 'Thất bại'
        NeedsConfirmation = 'Cần người dùng xác nhận'
        Info              = 'Thông tin'
    }

    [pscustomobject]@{
        Time       = Get-Date
        Action     = $Action
        Status     = $Status
        StatusText = $labels[$Status]
        Reason     = $Reason
        Data       = $Data
    }
}

function Confirm-CCAction {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Message,

        [string]$Title = 'Xác nhận thao tác'
    )

    $buttons = [Windows.Forms.MessageBoxButtons]::YesNo
    $icon = [Windows.Forms.MessageBoxIcon]::Warning
    $default = [Windows.Forms.MessageBoxDefaultButton]::Button2

    if ($null -ne $script:CC.Form -and
        -not $script:CC.Form.IsDisposed) {

        $answer = [Windows.Forms.MessageBox]::Show(
            $script:CC.Form,
            $Message,
            $Title,
            $buttons,
            $icon,
            $default
        )
    }
    else {
        $answer = [Windows.Forms.MessageBox]::Show(
            $Message,
            $Title,
            $buttons,
            $icon,
            $default
        )
    }

    return ($answer -eq [Windows.Forms.DialogResult]::Yes)
}

function Get-CCRegistryValue {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [ValidateSet('LocalMachine', 'CurrentUser')]
        [string]$Hive,

        [Parameter(Mandatory = $true)]
        [string]$SubKey,

        [Parameter(Mandatory = $true)]
        [AllowEmptyString()]
        [string]$Name,

        [ValidateSet('Registry64', 'Registry32')]
        [string]$View = 'Registry64'
    )

    if (-not [Environment]::Is64BitOperatingSystem) {
        $View = 'Registry32'
    }

    $base = $null
    $key = $null

    try {
        $hiveEnum = [Microsoft.Win32.RegistryHive]::$Hive
        $viewEnum = [Microsoft.Win32.RegistryView]::$View

        $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey(
            $hiveEnum,
            $viewEnum
        )

        $key = $base.OpenSubKey($SubKey, $false)

        $exists = $false
        $value = $null
        $kind = $null

        if ($null -ne $key) {
            $exists = @($key.GetValueNames()) -contains $Name

            if ($exists) {
                $kind = $key.GetValueKind($Name).ToString()

                $value = $key.GetValue(
                    $Name,
                    $null,
                    [Microsoft.Win32.RegistryValueOptions]::
                        DoNotExpandEnvironmentNames
                )
            }
        }

        [pscustomobject]@{
            Hive        = $Hive
            View        = $View
            SubKey      = $SubKey
            Name        = $Name
            KeyExists   = ($null -ne $key)
            ValueExists = $exists
            Kind        = $kind
            Value       = $value
        }
    }
    finally {
        if ($null -ne $key) {
            $key.Dispose()
        }

        if ($null -ne $base) {
            $base.Dispose()
        }
    }
}


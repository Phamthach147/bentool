$script:CC.UI.AVGrid = New-CCGrid @('Ứng dụng', 'Phiên bản', 'Nhà phát hành')

$avButtons = New-CCLayout 3 1
Add-CCRow $avButtons 0 @(
    (New-CCButton 'Quét / Kiểm tra lại antivirus' {
        Invoke-CCUIWorker Antivirus 'Quét antivirus' -Completed {
            param($completion)
            if ($completion.State -ne 'Completed') {
                Show-CCCompletion $completion
                return
            }

            $grid = $script:CC.UI.AVGrid
            $grid.Rows.Clear()
            foreach ($app in @($completion.Output)) {
                $row = $grid.Rows.Add([object[]]@(
                    $app.Name, $app.Version, $app.Publisher
                ))
                $grid.Rows[$row].Tag = $app
            }
            Write-CCLog -Message (
                'Tìm thấy {0} mục khớp danh sách nhận diện hẹp. ' +
                'Không có trong bảng không có nghĩa máy không có antivirus khác.' -f
                $grid.Rows.Count
            )
        }
    }),
    (New-CCButton 'Mở trình gỡ mục đã chọn' {
        $row = $script:CC.UI.AVGrid.CurrentRow
        if ($null -eq $row) { throw 'Chọn ứng dụng trong bảng trước.' }
        $app = $row.Tag
        if (-not (Confirm-CCAction (
            'Mở trình gỡ chính thức của "{0}"? Hoàn tất trình gỡ rồi quét lại.' -f
            $app.Name
        ))) { return }

        Invoke-CCUIWorker Uninstall 'Mở bộ gỡ antivirus' `
            @{ App = $app } @('SystemChange')
    }),
    (New-CCButton 'Kiểm tra bảo vệ sau gỡ' {
        Invoke-CCUIWorker Setup 'Kiểm tra sau gỡ antivirus' @{} @('Network')
    })
)

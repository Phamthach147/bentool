function Set-CCDNS {
    param($InputData, $Context)

    $index = [int]$InputData.InterfaceIndex
    $guid = [string]$InputData.InterfaceGuid
    [void](Assert-CCAdapterIdentity $index $guid)

    $automatic = ($InputData.Mode -eq 'Automatic')
    $servers = @($InputData.Servers | Where-Object {
        -not [string]::IsNullOrWhiteSpace([string]$_)
    })

    $measurement = ''

    if ($InputData.Mode -eq 'Fastest') {
        $beforeRoute = Get-CCRouteFingerprint $index
        $scores = New-Object 'System.Collections.Generic.List[object]'
        $providers = @(
            [pscustomobject]@{
                Name = 'Cloudflare'; Servers = @('1.1.1.1', '1.0.0.1')
            }
            [pscustomobject]@{
                Name = 'Google'; Servers = @('8.8.8.8', '8.8.4.4')
            }
        )

        $domains = @('microsoft.com', 'cloudflare.com', 'google.com')

        foreach ($provider in $providers) {
            $times = New-Object 'System.Collections.Generic.List[double]'
            $successByServer = @{}
            foreach ($server in $provider.Servers) {
                $successByServer[$server] = 0

                foreach ($domain in $domains) {
                    Send-CCProgress $Context (
                        'Đo DNS {0}: {1}' -f $provider.Name, $domain
                    )

                    $watch = [Diagnostics.Stopwatch]::StartNew()
                    try {
                        $answer = @(Resolve-DnsName -Name $domain -Type A `
                            -Server $server -DnsOnly -NoHostsFile -QuickTimeout `
                            -ErrorAction Stop | Where-Object {
                                $_.PSObject.Properties.Name -contains 'IPAddress'
                            })

                        if ($answer.Count -eq 0) {
                            throw 'Không có bản ghi A.'
                        }

                        $watch.Stop()
                        $times.Add($watch.Elapsed.TotalMilliseconds)
                        $successByServer[$server]++
                    }
                    catch {
                        $watch.Stop()
                    }
                }
            }

            $average = [double]::PositiveInfinity
            if ($times.Count -gt 0) {
                $average = ($times | Measure-Object -Average).Average
            }

            $scores.Add([pscustomobject]@{
                Name = $provider.Name
                Servers = $provider.Servers
                Success = $times.Count
                Average = $average
                Reliable = (
                    $successByServer[$provider.Servers[0]] -ge 2 -and
                    $successByServer[$provider.Servers[1]] -ge 2
                )
            })
        }

        [void](Assert-CCAdapterIdentity $index $guid)

        if ($beforeRoute -ne (Get-CCRouteFingerprint $index)) {
            throw 'Địa chỉ hoặc tuyến mạng đã thay đổi trong lúc đo. Giữ nguyên DNS.'
        }

        $reliable = @($scores | Where-Object Reliable)
        if ($reliable.Count -lt 2) {
            throw 'Chưa đủ mẫu đáng tin cậy của cả hai nhà cung cấp. Giữ nguyên DNS.'
        }

        $winner = $reliable |
            Sort-Object @{Expression = 'Success'; Descending = $true},
                @{Expression = 'Average'; Descending = $false} |
            Select-Object -First 1

        $servers = @($winner.Servers)
        $measurement = (
            'Chọn {0}; {1}/6 truy vấn thành công, trung bình {2:N1} ms. ' +
            'Đây là phép đo truy vấn DNS trên đường mạng hiện tại, không phải tốc độ tải. '
        ) -f $winner.Name, $winner.Success, $winner.Average
    }

    if (-not $automatic) {
        if ($servers.Count -lt 1 -or $servers.Count -gt 2) {
            throw 'Nhập một hoặc hai địa chỉ DNS IPv4.'
        }

        foreach ($server in $servers) {
            $number = ConvertTo-CCIPv4Number ([string]$server)
            if ($number -eq 0 -or ($number -shr 24) -ge 224) {
                throw 'Địa chỉ DNS không hợp lệ.'
            }
        }
    }

    $backup = Save-CCNetworkSnapshot $Context $index $guid

    if ($automatic) {
        Set-DnsClientServerAddress -InterfaceIndex $index `
            -ResetServerAddresses -ErrorAction Stop
    }
    else {
        Set-DnsClientServerAddress -InterfaceIndex $index `
            -ServerAddresses ([string[]]$servers) -ErrorAction Stop
    }

    [void](Assert-CCAdapterIdentity $index $guid)
    $after = @((Get-DnsClientServerAddress -InterfaceIndex $index `
        -AddressFamily IPv4 -ErrorAction Stop).ServerAddresses)

    if (-not $automatic -and ($after -join ',') -ne ($servers -join ',')) {
        throw ('DNS đọc lại không khớp. Sao lưu: {0}' -f $backup)
    }

    if ($automatic) {
        $key = 'SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces\{0}' -f (
            ([guid]$guid).ToString('B')
        )
        $setting = Get-CCRegistryValue -Hive LocalMachine -SubKey $key -Name NameServer
        if (-not [string]::IsNullOrWhiteSpace([string]$setting.Value)) {
            throw 'Vẫn phát hiện DNS IPv4 đặt thủ công sau khi reset.'
        }
    }

    New-CCResult 'Áp dụng DNS' Success (
        '{0}DNS hiện đọc được: {1}. Sao lưu: {2}' -f
        $measurement, ($after -join ', '), $backup
    ) ([pscustomobject]@{ DNS = $after })
}

function Invoke-CCPing {
    param($InputData, $Context)

    $target = ([string]$InputData.Target).Trim()
    [void](ConvertTo-CCIPv4Number $target)
    $ping = New-Object Net.NetworkInformation.Ping
    $times = New-Object 'System.Collections.Generic.List[long]'

    try {
        for ($i = 1; $i -le 4; $i++) {
            Test-CCCancellation $Context
            try {
                $reply = $ping.Send($target, 1500)
                if ($reply.Status -eq [Net.NetworkInformation.IPStatus]::Success) {
                    $times.Add($reply.RoundtripTime)
                    $message = 'Lượt {0}: {1} ms' -f $i, $reply.RoundtripTime
                    New-CCResult ('Ping lượt {0}' -f $i) Success $message
                }
                else {
                    $message = 'Lượt {0}: {1}' -f $i, $reply.Status
                    New-CCResult ('Ping lượt {0}' -f $i) Info $message
                }
            }
            catch {
                $message = 'Lượt {0}: {1}' -f $i, $_.Exception.Message
                New-CCResult ('Ping lượt {0}' -f $i) Info $message
            }

            Send-CCProgress $Context $message ($i * 25)
            if ($i -lt 4) { Start-Sleep -Milliseconds 250 }
        }
    }
    finally {
        $ping.Dispose()
    }

    $summary = 'Nhận {0}/4, mất {1}/4.' -f $times.Count, (4 - $times.Count)
    if ($times.Count -gt 0) {
        $stats = $times | Measure-Object -Minimum -Maximum -Average
        $summary += ' Min {0} ms; max {1} ms; trung bình {2:N1} ms.' -f
            $stats.Minimum, $stats.Maximum, $stats.Average
    }

    New-CCResult 'Tổng kết Ping' Info (
        $summary + ' Không phản hồi ICMP không chứng minh thiết bị đã tắt.'
    )
}


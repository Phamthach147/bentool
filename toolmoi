function Set-CCFirewall {
    param($InputData, $Context)

    $enabled = [bool]$InputData.Enabled
    $before = @(Get-NetFirewallProfile -PolicyStore PersistentStore `
        -ErrorAction Stop | Select-Object Name, Enabled)

    [void](Save-CCSnapshot $Context 'Firewall' $before)

    Set-NetFirewallProfile -Profile Domain, Private, Public `
        -Enabled $enabled -ErrorAction Stop

    $stored = @(Get-NetFirewallProfile -PolicyStore PersistentStore -ErrorAction Stop)
    $effective = @(Get-NetFirewallProfile -PolicyStore ActiveStore -ErrorAction Stop)
    $wanted = 'False'
    if ($enabled) { $wanted = 'True' }

    foreach ($name in @('Domain', 'Private', 'Public')) {
        $local = $stored | Where-Object Name -eq $name
        $active = $effective | Where-Object Name -eq $name

        if ([string]$local.Enabled -ne $wanted) {
            New-CCResult ('Firewall {0}' -f $name) Failed `
                'Trạng thái lưu trong cấu hình không khớp.'
        }
        elseif ([string]$active.Enabled -ne $wanted) {
            New-CCResult ('Firewall {0}' -f $name) Info `
                'Đã đổi cấu hình cục bộ nhưng chính sách hiệu lực khác. Có thể do quản trị tập trung.'
        }
        else {
            New-CCResult ('Firewall {0}' -f $name) Success (
                'Đã đọc lại trạng thái hiệu lực: {0}.' -f $wanted
            )
        }
    }
}

function Get-CCWindowsPrinters {
    $ports = @(Get-PrinterPort -ErrorAction Stop)
    foreach ($printer in @(Get-Printer -ErrorAction Stop)) {
        $port = $ports | Where-Object Name -eq $printer.PortName |
            Select-Object -First 1

        [pscustomobject]@{
            Source = 'Windows'
            Name = $printer.Name
            Model = $printer.DriverName
            IP = [string]$port.PrinterHostAddress
            MAC = 'Chưa xác định'
            Port = $printer.PortName
            TCPPort = $port.PortNumber
            Status = [string]$printer.PrinterStatus
            WindowsPrinter = $printer.Name
        }
    }
}


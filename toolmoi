function Get-CCSelectedNetwork {
    $position = $script:CC.UI.Adapter.SelectedIndex
    if ($position -lt 0 -or $position -ge $script:CC.NetworkItems.Count) {
        throw 'Chưa có card mạng. Bấm Làm mới trước.'
    }
    return $script:CC.NetworkItems[$position]
}

function Get-CCSelectedNetworkData {
    $network = Get-CCSelectedNetwork
    return @{
        InterfaceIndex = [int]$network.InterfaceIndex
        InterfaceGuid = [string]$network.InterfaceGuid
    }
}

function Update-CCNetworkFields {
    if ($script:CC.UI.Adapter.SelectedIndex -lt 0) { return }

    $network = Get-CCSelectedNetwork
    $script:CC.LastAdapterGuid = [string]$network.InterfaceGuid

    $ips = @($network.IPv4)
    $script:CC.UI.IPSelect.Items.Clear()

    foreach ($ip in $ips) {
        [void]$script:CC.UI.IPSelect.Items.Add(
            ('{0}/{1}' -f $ip.IPAddress, $ip.PrefixLength)
        )
    }

    if ($ips.Count -gt 0) {
        $selected = 0
        for ($i = 0; $i -lt $ips.Count; $i++) {
            if ($ips[$i].IPAddress -eq $network.SourceIPv4) {
                $selected = $i
            }
        }
        $script:CC.UI.IPSelect.SelectedIndex = $selected
    }
    else {
        $script:CC.UI.IP.Text = ''
        $script:CC.UI.Prefix.Text = '24'
    }

    $script:CC.UI.Gateway.Text = (
        @($network.Gateway) | Select-Object -First 1
    )

    $script:CC.UI.NetworkInfo.Text = (
        '{0} | {1} | MAC: {2}' + "`r`n" +
        'IPv4: {3}' + "`r`n" +
        'Gateway: {4} | DNS: {5}' + "`r`n" +
        'SSID/băng tần/tín hiệu: chưa xác định trong bản này.'
    ) -f $network.Name, $network.Type, $network.MAC,
        (($ips | ForEach-Object {
            '{0}/{1}' -f $_.IPAddress, $_.PrefixLength
        }) -join ', '),
        ($network.Gateway -join ', '), ($network.DNS -join ', ')
}

function Refresh-CCNetworks {
    Invoke-CCUIWorker -Name Network -Title 'Đọc mạng hiện tại' `
        -Resources @('Network') -Completed {
            param($completion)

            if ($completion.State -ne 'Completed') {
                Show-CCCompletion $completion
                return
            }

            $script:CC.NetworkItems = @($completion.Output)
            $script:CC.UI.Adapter.Items.Clear()
            $selected = -1

            for ($i = 0; $i -lt $script:CC.NetworkItems.Count; $i++) {
                $network = $script:CC.NetworkItems[$i]

                [void]$script:CC.UI.Adapter.Items.Add(
                    ('{0} | {1} | #{2}' -f
                        $network.Name, $network.Type, $network.InterfaceIndex)
                )

                if ($network.Preferred -and $selected -lt 0) {
                    $selected = $i
                }
                if ($script:CC.LastAdapterGuid -and
                    $network.InterfaceGuid -eq $script:CC.LastAdapterGuid) {
                    $selected = $i
                }
            }

            if ($selected -lt 0 -and $script:CC.NetworkItems.Count -gt 0) {
                $selected = 0
            }

            $script:CC.UI.Adapter.SelectedIndex = $selected

            if ($selected -lt 0) {
                $script:CC.UI.NetworkInfo.Text =
                    'Không đọc được card đang Up. Mở Cấu hình Windows để kiểm tra.'
            }
        }
}

function Show-CCPrinterRows {
    $grid = $script:CC.UI.PrinterGrid
    $grid.Rows.Clear()

    foreach ($printer in $script:CC.PrinterRows) {
        $index = $grid.Rows.Add([object[]]@(
            $printer.Source, $printer.Name, $printer.IP,
            $printer.MAC, $printer.Port, $printer.Status,

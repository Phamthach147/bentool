function Test-CCTCPPort {
    param(
        [Parameter(Mandatory = $true)][string]$Address,
        [ValidateRange(1, 65535)][int]$Port = 9100,
        [ValidateRange(100, 5000)][int]$Timeout = 400
    )

    $client = New-Object Net.Sockets.TcpClient
    $waitHandle = $null

    try {
        $operation = $client.BeginConnect($Address, $Port, $null, $null)
        $waitHandle = $operation.AsyncWaitHandle

        if (-not $waitHandle.WaitOne($Timeout, $false)) {
            return $false
        }

        $client.EndConnect($operation)
        return $client.Connected
    }
    catch {
        return $false
    }
    finally {
        $client.Close()
        if ($null -ne $waitHandle) { $waitHandle.Close() }
    }
}

function Get-CCPrinterCandidates {
    param($InputData)

    $set = New-Object 'System.Collections.Generic.HashSet[string]'
    $candidates = New-Object 'System.Collections.Generic.List[object]'

    # Nguon 1: May in Windows.
    try {
        foreach ($printer in @(Get-CCWindowsPrinters)) {
            if ($printer.IP -match '^\d{1,3}(\.\d{1,3}){3}$' -and
                $set.Add($printer.IP)) {
                $candidates.Add([pscustomobject]@{
                    IP = $printer.IP
                    Source = 'Cổng máy in Windows'
                    MAC = 'Chưa xác định'
                    WindowsPrinter = $printer.Name
                })
            }
        }
    }
    catch {
        # Tiep tuc nguon khac neu PrintManagement khong doc duoc.
    }

    # Nguon 2: Bang lang gieng.
    foreach ($neighbor in @(Get-NetNeighbor -AddressFamily IPv4 `
        -ErrorAction SilentlyContinue)) {

        if ($neighbor.State -in @('Unreachable', 'Incomplete') -or
            $neighbor.IPAddress -notmatch '^\d{1,3}(\.\d{1,3}){3}$') {
            continue
        }

        $number = ConvertTo-CCIPv4Number $neighbor.IPAddress
        if (($number -shr 24) -ge 224) { continue }

        if ($set.Add($neighbor.IPAddress)) {
            $candidates.Add([pscustomobject]@{
                IP = $neighbor.IPAddress
                Source = 'Bảng láng giềng'
                MAC = $neighbor.LinkLayerAddress
                WindowsPrinter = ''
            })
        }
    }

    # Nguon 3: Doi tuong / dai IP nguoi dung xac nhan.
    # Khong tu quet toan bo cac subnet lon.
    $startText = [string]$InputData.StartIP
    $endText = [string]$InputData.EndIP

    if (-not [string]::IsNullOrWhiteSpace($startText)) {
        if ([string]::IsNullOrWhiteSpace($endText)) {
            $endText = $startText
        }

        $start = ConvertTo-CCIPv4Number $startText
        $end = ConvertTo-CCIPv4Number $endText

        if ($end -lt $start -or ($end - $start + 1) -gt 256) {
            throw 'Mỗi lượt chỉ kiểm tra tối đa 256 địa chỉ liên tiếp.'
        }

        for ([uint64]$n = $start; $n -le $end; $n++) {
            $first = $n -shr 24
            if ($first -eq 0 -or $first -eq 127 -or $first -ge 224) {
                throw 'Dải chứa địa chỉ không phù hợp để dò thiết bị.'
            }

            $address = ConvertFrom-CCIPv4Number $n
            if ($set.Add($address)) {
                $candidates.Add([pscustomobject]@{
                    IP = $address
                    Source = 'Dải đã xác nhận'
                    MAC = 'Chưa xác định'
                    WindowsPrinter = ''
                })
            }
        }
    }

    if ($candidates.Count -gt 512) {
        throw 'Quá 512 ứng viên từ các nguồn. Hãy thu hẹp phạm vi.'
    }

    return $candidates.ToArray()
}

function Find-CCNetworkPrinters {
    param($InputData, $Context)

    $candidates = @(Get-CCPrinterCandidates $InputData)
    $found = New-Object 'System.Collections.Generic.List[object]'
    $position = 0

    # 9100: raw printing; 515: LPD; 631: IPP.
    # Cong mo KHONG xac nhan may in/model.
    foreach ($candidate in $candidates) {
        if ($Context.Token.IsCancellationRequested) { break }
        $position++

        foreach ($port in @(9100, 515, 631)) {
            if ($Context.Token.IsCancellationRequested) { break }

            if (Test-CCTCPPort -Address $candidate.IP -Port $port -Timeout 300) {
                $row = [pscustomobject]@{
                    Source = $candidate.Source
                    Name = 'Nghi là máy in'
                    Model = 'Chưa xác định'
                    IP = $candidate.IP
                    MAC = $candidate.MAC
                    Port = $port
                    Status = 'TCP mở; chưa xác minh giao thức/model'
                    WindowsPrinter = $candidate.WindowsPrinter
                }

                $found.Add($row)

                Send-CCProgress $Context (
                    'Phát hiện cổng mở: {0}:{1}' -f $candidate.IP, $port
                ) ([int](100 * $position / [Math]::Max(1, $candidates.Count))) $row
            }
        }

        Send-CCProgress $Context (
            'Đã kiểm tra {0}/{1} địa chỉ' -f $position, $candidates.Count
        ) ([int](100 * $position / [Math]::Max(1, $candidates.Count)))
    }

    $reason = 'Kiểm tra {0}/{1} địa chỉ, thấy {2} cổng mở.' -f
        $position, $candidates.Count, $found.Count

    if ($Context.Token.IsCancellationRequested) {
        $reason += ' Đã dừng theo yêu cầu; giữ kết quả đã tìm được.'
    }

    $reason += ' Không bảo đảm tìm thiết bị khác subnet, thiếu route hoặc không mở các cổng đã kiểm tra.'

    New-CCResult 'Dò thiết bị nghi là máy in' Info $reason $found.ToArray()
}

function Send-CCPrinterIdentification {
    param($InputData, $Context)

    $address = ([string]$InputData.IP).Trim()
    [void](ConvertTo-CCIPv4Number $address)

    if (-not $InputData.ConfirmedRawPrinter) {
        throw 'Cần xác nhận đây là máy in nhiệt hỗ trợ in RAW văn bản.'
    }

    $port = 9100
    if ($InputData.Port) { $port = [int]$InputData.Port }

    if ($port -lt 1 -or $port -gt 65535) {
        throw 'Cổng không hợp lệ.'
    }

    # Van ban ASCII. Khong gui lenh doi cau hinh, buzzer,
    # self-test firmware hay byte cat giay chua xac minh.
    $id = 'CC-' + ([guid]::NewGuid().ToString('N').Substring(0, 6).ToUpper())
    $text = @(
        ''
        '================================'
        '       CUKCUK - NHAN DIEN'
        '================================'
        ('Ma phieu: {0}' -f $id)
        ('IP dich: {0}' -f $address)
        ('Cong TCP: {0}' -f $port)
        (Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
        ''
        'IP tren phieu la IP tool gui toi.'
        'Khong phai self-test firmware.'
        'Vui long bao ma phieu cho ky thuat.'
        '================================'
        ''
        ''
        ''
    ) -join "`r`n"

    $bytes = [Text.Encoding]::ASCII.GetBytes($text)
    $client = New-Object Net.Sockets.TcpClient
    $waitHandle = $null
    $stream = $null

    try {
        $operation = $client.BeginConnect($address, $port, $null, $null)
        $waitHandle = $operation.AsyncWaitHandle

        if (-not $waitHandle.WaitOne(2000, $false)) {
            throw 'Hết thời gian kết nối cổng in.'
        }

        $client.EndConnect($operation)
        $client.SendTimeout = 2000
        $stream = $client.GetStream()
        $stream.WriteTimeout = 2000
        $stream.Write($bytes, 0, $bytes.Length)
        $stream.Flush()

        New-CCResult 'In phiếu nhận diện' NeedsConfirmation (
            'Đã gửi {0} byte tới {1}:{2}; mã {3}. Cần người tại cửa hàng xác nhận giấy đã in, không coi gửi TCP là in thành công.' -f
            $bytes.Length, $address, $port, $id
        )
    }
    finally {
        if ($null -ne $stream) { $stream.Dispose() }
        $client.Close()
        if ($null -ne $waitHandle) { $waitHandle.Close() }
    }
}


            param($completion)
            if ($completion.State -ne 'Completed') {
                Show-CCCompletion $completion
                return
            }
            $script:CC.PrinterRows.Clear()
            foreach ($printer in @($completion.Output)) {
                $script:CC.PrinterRows.Add($printer)
            }
            Show-CCPrinterRows
        }
    }),
    (New-CCButton 'Bắt đầu dò' {
        $data = @{
            StartIP = $script:CC.UI.ScanStart.Text.Trim()
            EndIP = $script:CC.UI.ScanEnd.Text.Trim()
        }
        if (-not (Confirm-CCAction (
            'Chỉ dò thiết bị/mạng được phép kiểm tra. ' +
            'Để trống dải: chỉ kiểm tra IP từ cổng máy in Windows và bảng láng giềng. Tiếp tục?'
        ))) { return }

        if ($script:CC.Tasks.ContainsKey('Discover')) {
            throw 'Đang có lượt dò. Dừng hoặc chờ lượt hiện tại kết thúc.'
        }

        $script:CC.PrinterRows.Clear()
        Show-CCPrinterRows

        Invoke-CCUIWorker Discover 'Dò máy in mạng' $data @('Network') `
            -CanCancel -Progress {
                param($eventItem, $id)
                if ($eventItem.Percent -ge 0) {
                    $script:CC.UI.ScanProgress.Value = $eventItem.Percent
                }
                if ($null -ne $eventItem.Data) {
                    $script:CC.PrinterRows.Add($eventItem.Data)
                    Show-CCPrinterRows
                }
                if ($eventItem.Message) {
                    $script:CC.UI.ScanStatus.Text = $eventItem.Message
                }
            } -Completed {
                param($completion)

                # Ket qua cuoi la nguon chinh, khong phu thuoc queue tien do.
                foreach ($result in @($completion.Output)) {
                    if ($result.Action -eq 'Dò thiết bị nghi là máy in') {
                        $script:CC.PrinterRows.Clear()
                        foreach ($printer in @($result.Data)) {
                            if ($null -ne $printer) {
                                $script:CC.PrinterRows.Add($printer)
                            }
                        }
                    }
                }
                Show-CCPrinterRows
                Show-CCCompletion $completion
            }
    }),
    (New-CCButton 'Dừng dò' {
        [void](Request-CCTaskCancellation Discover)
    }),
    (New-CCButton 'Cài đặt máy in' {
        Open-CCLocation 'ms-settings:printers'
    })
)


}

function Start-CCRegisteredUninstaller {
    param([Parameter(Mandatory = $true)]$App)

    # Doc lai, khong tin chuoi da hien tren giao dien tu truoc.
    $matches = @(Get-CCInstalledApps | Where-Object {
        $_.RegistryId -eq $App.RegistryId -and
        $_.Hive -eq $App.Hive -and $_.View -eq $App.View -and
        $_.Name -eq $App.Name
    })

    if ($matches.Count -ne 1) {
        throw 'Không xác nhận được ứng dụng trong danh sách hiện tại.'
    }

    $command = [Environment]::ExpandEnvironmentVariables(
        [string]$matches[0].Uninstall
    ).Trim()

    $exe = ''
    $arguments = ''

    if ($command -match '^"([^"]+\.exe)"\s*(.*)$') {
        $exe = $matches[1]
        $arguments = $matches[2]
    }
    elseif ($command -match '^(?i:msiexec(?:\.exe)?)\s+(.*)$') {
        $exe = Join-Path $env:WINDIR 'System32\msiexec.exe'
        $arguments = $matches[1]
    }
    elseif ($command -match '^([^\s"]+\.exe)\s*(.*)$') {
        $exe = $matches[1]
        $arguments = $matches[2]
    }
    else {
        throw 'Lệnh gỡ không có dạng an toàn được hỗ trợ. Hãy gỡ trong Settings.'
    }

    if (-not [IO.Path]::IsPathRooted($exe) -or
        $exe.StartsWith('\\') -or
        -not (Test-Path -LiteralPath $exe -PathType Leaf)) {
        throw 'Không xác minh được đường dẫn bộ gỡ trên máy.'
    }

    $leaf = [IO.Path]::GetFileName($exe)
    if ($leaf -match '^(cmd|powershell|pwsh|wscript|cscript|rundll32|mshta)\.exe$') {
        throw 'Bộ gỡ dùng trình thông dịch không được mở tự động. Hãy dùng Settings.'
    }

    if ($leaf -ieq 'msiexec.exe') {
        if ($arguments -match '(?i)/(quiet|qn|passive)\b') {
            throw 'Bộ gỡ đăng ký ở chế độ ẩn. Hãy dùng Settings để gỡ có xác nhận.'
        }
        $arguments = $arguments -replace '(?i)/I(?=\s|\{)', '/X'
    }

    $info = New-Object Diagnostics.ProcessStartInfo
    $info.FileName = $exe
    $info.Arguments = $arguments
    $info.UseShellExecute = $true

    $process = [Diagnostics.Process]::Start($info)
    if ($null -ne $process) { $process.Dispose() }

    New-CCResult ('Mở bộ gỡ: {0}' -f $App.Name) NeedsConfirmation `
        'Đã mở trình gỡ. Hoàn tất trình gỡ rồi quét lại; chưa xác nhận đã gỡ.'
}

function Remove-CCExactAppPackage {
    param(
        [Parameter(Mandatory = $true)]$Context,
        [Parameter(Mandatory = $true)][string]$Name,
        [Parameter(Mandatory = $true)][string]$Action
    )

    $packages = @(Get-AppxPackage -Name $Name -ErrorAction Stop |
        Where-Object { $_.Name -eq $Name })

    if ($packages.Count -eq 0) {
        New-CCResult $Action NotPresent `
            'Không có gói trong tài khoản đang chạy. Chưa kiểm tra tài khoản khác.'
        return
    }

    [void](Save-CCSnapshot $Context 'AppPackageInventory' (
        $packages | Select-Object Name, PackageFullName, InstallLocation
    ))

    foreach ($package in $packages) {
        try {
            Remove-AppxPackage -Package $package.PackageFullName -ErrorAction Stop
            $remaining = @(Get-AppxPackage -Name $Name -ErrorAction Stop |
                Where-Object { $_.PackageFullName -eq $package.PackageFullName })

            if ($remaining.Count -gt 0) {
                throw 'Gói vẫn hiện trong tài khoản đang chạy.'
            }

            New-CCResult $Action Success `
                'Đã gỡ và kiểm tra lại cho tài khoản đang chạy; không gỡ provisioned/tài khoản khác.'
        }
        catch {
            New-CCResult $Action Failed $_.Exception.Message
        }
    }
}

function Remove-CCOldTemp {
    $cutoff = (Get-Date).AddDays(-7)
    $deleted = 0
    $skipped = 0
    [long]$bytes = 0

    $roots = @(
        [IO.Path]::GetFullPath($env:TEMP)
        (Join-Path $env:WINDIR 'Temp')
    ) | Select-Object -Unique

    foreach ($root in $roots) {
        if (-not (Test-Path -LiteralPath $root -PathType Container)) {
            continue
        }

        $rootInfo = Get-Item -LiteralPath $root -Force -ErrorAction Stop
        if ($rootInfo.Attributes -band [IO.FileAttributes]::ReparsePoint) {
            $skipped++
            continue
        }

        $stack = New-Object 'System.Collections.Generic.Stack[string]'
        $stack.Push($root)

        while ($stack.Count -gt 0) {
            $directory = $stack.Pop()
            try {
                $items = @(Get-ChildItem -LiteralPath $directory -Force `
                    -ErrorAction Stop)
            }
            catch {
                $skipped++
                continue
            }

            foreach ($item in $items) {
                if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {
                    $skipped++
                    continue
                }

                if ($item.PSIsContainer) {
                    $stack.Push($item.FullName)
                    continue
                }

                if ($item.LastWriteTime -ge $cutoff -or
                    $item.CreationTime -ge $cutoff) {
                    continue
                }

                try {
                    $length = $item.Length
                    Remove-Item -LiteralPath $item.FullName -Force -ErrorAction Stop
                    $deleted++
                    $bytes += $length
                }
                catch {
                    $skipped++
                }
            }
        }
    }

    New-CCResult 'Dọn TEMP cũ hơn 7 ngày' Info (
        'Xóa {0} tệp, khoảng {1:N1} MB; bỏ qua/lỗi {2} mục. Không xóa thư mục dữ liệu.' -f
        $deleted, ($bytes / 1MB), $skipped
    )
}

function Set-CCServiceOptimization {
    param($Context)

    foreach ($name in @('MapsBroker', 'WerSvc', 'SysMain', 'TrkWks', 'Spooler')) {
        $action = 'Dịch vụ {0}' -f $name

        try {
            $service = Get-CimInstance Win32_Service `
                -Filter ("Name='{0}'" -f $name) -ErrorAction Stop

            if ($null -eq $service) {
                New-CCResult $action NotPresent 'Không có dịch vụ này.'
                continue
            }

            [void](Save-CCSnapshot $Context 'Service' (
                $service | Select-Object Name, StartMode, State, DelayedAutoStart
            ))

            if ($name -eq 'Spooler') {
                Set-Service -Name Spooler -StartupType Automatic -ErrorAction Stop
                if ((Get-Service Spooler -ErrorAction Stop).Status -ne 'Running') {
                    Start-Service Spooler -ErrorAction Stop
                }
            }
            else {
                # Khong Stop-Service. Khong dong vao UltraViewer.
                Set-Service -Name $name -StartupType Manual -ErrorAction Stop
            }

            $after = Get-CimInstance Win32_Service `
                -Filter ("Name='{0}'" -f $name) -ErrorAction Stop

            if ($name -eq 'Spooler') {
                if ($after.StartMode -ne 'Auto' -or $after.State -ne 'Running') {
                    throw 'Spooler chưa đạt Automatic và Running.'
                }
                New-CCResult $action Success 'Automatic và Running tại thời điểm kiểm tra.'
            }
            else {
                if ($after.StartMode -ne 'Manual') {
                    throw 'Kiểu khởi động chưa chuyển thành Manual.'
                }
                New-CCResult $action Success 'Đã đặt Manual; không buộc dừng dịch vụ đang chạy.'
            }
        }
        catch {
            New-CCResult $action Failed $_.Exception.Message
        }
    }
}

function Invoke-CCOptimization {
    param($InputData, $Context)

    # Chi duoc goi sau hop thoai xac nhan o phan 4.
    # OneDrive co xac nhan rieng trong du lieu dau vao.
    $plan = @(Get-CCOptimizationPlan)

    # Diem khoi phuc phai chay truoc cac thay doi.
    $ordered = @($plan | Where-Object Id -eq 'Restore') +
        @($plan | Where-Object Id -ne 'Restore')

    $index = 0

    foreach ($item in $ordered) {
        $index++
        Send-CCProgress $Context $item.Action (
            [int](100 * $index / $ordered.Count)
        )

        try {
            $writes = @()

            switch ($item.Id) {
                Restore {
                    $before = @(Get-ComputerRestorePoint -ErrorAction Stop)
                    Checkpoint-Computer -Description (
                        'CUKCUK {0}' -f (Get-Date -Format 'yyyyMMdd-HHmmss')
                    ) -RestorePointType MODIFY_SETTINGS -ErrorAction Stop

                    $after = @(Get-ComputerRestorePoint -ErrorAction Stop)
                    $new = @($after | Where-Object {

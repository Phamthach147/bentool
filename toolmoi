function Assert-CCUIThread {
    if ([Threading.Thread]::CurrentThread.ApartmentState -ne
        [Threading.ApartmentState]::STA) {
        throw 'Thao tác này phải chạy trên luồng giao diện STA.'
    }

    if ($null -ne $script:CC.Form) {
        if ($script:CC.Form.IsDisposed) {
            throw 'Giao diện đã đóng.'
        }

        if ($script:CC.Form.InvokeRequired) {
            throw 'Không được điều khiển giao diện từ worker.'
        }
    }
}

function Register-CCWorkerFunction {
    param(
        [Parameter(Mandatory = $true)]
        [string[]]$Name
    )

    foreach ($item in $Name) {
        if ($item -notmatch '^[A-Za-z][A-Za-z0-9_-]*$') {
            throw ('Tên hàm không hợp lệ: {0}' -f $item)
        }

        $command = Get-Command `
            -Name $item `
            -CommandType Function `
            -ErrorAction Stop

        if ($script:CC.WorkerFunctions -notcontains $command.Name) {
            $script:CC.WorkerFunctions += $command.Name
        }
    }
}

function Initialize-CCTaskEngine {
    Assert-CCUIThread

    if ($null -ne $script:CC.RunspacePool) {
        return
    }

    $pool = $null

    try {
        $pool = [RunspaceFactory]::CreateRunspacePool(
            1,
            [int]$script:CC.MaxTasks
        )

        $pool.ApartmentState = [Threading.ApartmentState]::MTA

        $pool.ThreadOptions =
            [System.Management.Automation.Runspaces.PSThreadOptions]::
                ReuseThread

        $pool.Open()
        $script:CC.RunspacePool = $pool

        $timer = New-Object System.Windows.Forms.Timer
        $timer.Interval = 150

        $timer.Add_Tick({
            Receive-CCTasks
        })

        $script:CC.Timer = $timer
        $timer.Start()
    }
    catch {
        if ($null -ne $pool) {
            $pool.Dispose()
        }

        $script:CC.RunspacePool = $null
        throw
    }
}

function Update-CCTaskStatus {
    $label = $script:CC.StatusLabel

    if ($null -eq $label -or $label.IsDisposed) {
        return
    }

    $count = $script:CC.Tasks.Count

    if ($count -eq 0) {
        $label.Text = 'Sẵn sàng'
    }
    else {
        $label.Text = 'Đang xử lý: {0} tác vụ' -f $count
    }
}

function Get-CCConflictingTask {
    param(
        [string]$Id,
        [string[]]$Resources = @()
    )

    foreach ($task in @($script:CC.Tasks.Values)) {
        if ($task.Id -eq $Id) {
            return $task
        }

        foreach ($resource in $Resources) {
            if ($task.Resources -contains $resource) {
                return $task
            }
        }
    }

    return $null
}

function Start-CCTask {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Id,

        [Parameter(Mandatory = $true)]
        [string]$Title,

        [Parameter(Mandatory = $true)]
        [scriptblock]$Worker,

        [hashtable]$InputData = @{},

        [string[]]$Resources = @(),

        [scriptblock]$OnCompleted,

        [scriptblock]$OnProgress,

        [switch]$CanCancel
    )

    Assert-CCUIThread

    if ($script:CC.Closing) {
        return $false
    }

    $conflict = Get-CCConflictingTask `
        -Id $Id `
        -Resources $Resources

    if ($null -ne $conflict) {
        Write-CCLog -Level WARN -Message (
            'Chưa chạy "{0}": đang có tác vụ xung đột "{1}".' -f
            $Title, $conflict.Title
        )
        return $false
    }

    if ($script:CC.Tasks.Count -ge $script:CC.MaxTasks) {
        Write-CCLog -Level WARN -Message (
            'Đã có {0} tác vụ. Hãy đợi một tác vụ kết thúc.' -f
            $script:CC.MaxTasks
        )
        return $false
    }

    $ps = $null
    $cancel = $null
    $started = $false

    try {
        Initialize-CCTaskEngine
        Initialize-CCStorage

        # Tach du lieu dau vao khoi cac bien tren giao dien.
        # Chi truyen chuoi, so, mang, hashtable va doi tuong du lieu.
        $inputXml = [System.Management.Automation.PSSerializer]::
            Serialize($InputData, 12)

        $definitions = New-Object System.Text.StringBuilder

        foreach ($name in $script:CC.WorkerFunctions) {
            $command = Get-Command `
                -Name $name `
                -CommandType Function `
                -ErrorAction Stop

            [void]$definitions.AppendLine(
                ('function {0} {{' -f $command.Name)
            )
            [void]$definitions.AppendLine(
                $command.ScriptBlock.ToString()
            )
            [void]$definitions.AppendLine('}')
        }

        $queue = New-Object `
            'System.Collections.Concurrent.ConcurrentQueue[object]'

        $cancel = New-Object `
            System.Threading.CancellationTokenSource

        $context = [pscustomobject]@{
            TaskId       = $Id
            SessionDir   = $script:CC.SessionDir
            WindowsBuild = $script:CC.WindowsBuild
            Token        = $cancel.Token
            Events       = $queue
        }

        # Khong truyen $script:CC vao runspace.
        # Runspace khong duoc biet Form, Button, Label hay LogBox.
        $runner = {
            param(
                [string]$DefinitionText,
                [string]$WorkerText,
                [string]$InputXml,
                [object]$Context
            )

            $ErrorActionPreference = 'Stop'
            $ProgressPreference = 'SilentlyContinue'

            function Send-CCProgress {
                param(
                    [object]$Context,
                    [string]$Message,
                    [int]$Percent = -1,
                    [object]$Data = $null
                )

                # Gioi han hang doi; khong dung Data de chua
                # ket qua quan trong khong duoc phep mat.
                if ($Context.Events.Count -lt 500) {
                    $Context.Events.Enqueue(
                        [pscustomobject]@{
                            Message = $Message
                            Percent = [Math]::Max(
                                -1,
                                [Math]::Min(100, $Percent)
                            )
                            Data = $Data
                        }
                    )
                }
            }

            function Test-CCCancellation {
                param([object]$Context)

                $Context.Token.ThrowIfCancellationRequested()
            }

            . ([scriptblock]::Create($DefinitionText))

            $data = [System.Management.Automation.PSSerializer]::
                Deserialize($InputXml)

            Test-CCCancellation $Context

            & ([scriptblock]::Create($WorkerText)) $data $Context
        }

        $ps = [PowerShell]::Create()
        $ps.RunspacePool = $script:CC.RunspacePool

        [void]$ps.AddScript($runner.ToString())
        [void]$ps.AddArgument($definitions.ToString())
        [void]$ps.AddArgument($Worker.ToString())
        [void]$ps.AddArgument($inputXml)
        [void]$ps.AddArgument($context)

        $task = [pscustomobject]@{
            Id              = $Id
            Title           = $Title
            Resources       = @($Resources)
            PowerShell      = $ps
            Handle          = $null
            Queue           = $queue
            Cancellation    = $cancel
            CanCancel       = [bool]$CanCancel
            CancelRequested = $false
            OnCompleted     = $OnCompleted
            OnProgress      = $OnProgress
            StartedAt       = Get-Date
        }

        $task.Handle = $ps.BeginInvoke()
        $started = $true
        $script:CC.Tasks[$Id] = $task
    }
    catch {
        if (-not $started) {
            if ($null -ne $ps) {
                $ps.Dispose()
            }

            if ($null -ne $cancel) {
                $cancel.Dispose()
            }
        }

        Write-CCLog -Level ERROR -Message (
            'Không khởi chạy được "{0}": {1}' -f
            $Title, $_.Exception.Message
        )
        return $false
    }

    Write-CCLog -Message ('Bắt đầu: {0}' -f $Title)
    Update-CCTaskStatus
    return $true
}

function Request-CCTaskCancellation {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Id
    )

    Assert-CCUIThread

    if (-not $script:CC.Tasks.ContainsKey($Id)) {
        return $false
    }

    $task = $script:CC.Tasks[$Id]

    if (-not $task.CanCancel) {
        Write-CCLog -Level WARN -Message (
            'Không ngắt "{0}" giữa chừng để tránh cấu hình dở dang.' -f
            $task.Title
        )
        return $false
    }

    if (-not $task.CancelRequested) {
        $task.CancelRequested = $true
        $task.Cancellation.Cancel()

        Write-CCLog -Level WARN -Message (
            'Đã yêu cầu dừng "{0}". Đang chờ điểm dừng an toàn.' -f
            $task.Title
        )
    }

    # Khong goi Stop() dong bo tren UI.
    # Worker phai kiem tra token giua cac luot va dung timeout
    # cho cac phep ket noi. Yeu cau dung khong phai hoan tac.
    return $true
}

function Receive-CCTasks {
    if ($script:CC.TaskPolling) {
        return
    }

    $script:CC.TaskPolling = $true

    try {
        foreach ($task in @($script:CC.Tasks.Values)) {
            $eventItem = $null
            $processed = 0

            # Moi nhip chi xu ly mot luong su kien co gioi han.
            while ($processed -lt 40 -and
                $task.Queue.TryDequeue([ref]$eventItem)) {

                $processed++

                if ($null -ne $task.OnProgress) {
                    try {
                        & $task.OnProgress $eventItem $task.Id |
                            Out-Null
                    }
                    catch {
                        Write-CCLog -Level ERROR -Message (
                            'Lỗi hiển thị tiến độ "{0}": {1}' -f
                            $task.Title, $_.Exception.Message
                        )
                    }
                }

                $eventItem = $null
            }

            if (-not $task.Handle.IsCompleted) {
                continue
            }

            # Xu ly het su kien truoc callback ket thuc.
            # Khong chan UI de doi worker.
            if (-not $task.Queue.IsEmpty) {
                continue
            }

            $output = @()
            $errors = @()
            $state = 'Completed'
            $invocationState =
                $task.PowerShell.InvocationStateInfo.State.ToString()

            try {
                $output = @(
                    $task.PowerShell.EndInvoke($task.Handle)
                )

                $errors = @(
                    $task.PowerShell.Streams.Error |
                        ForEach-Object { $_.ToString() }
                )

                if ($errors.Count -gt 0) {
                    $state = 'Failed'
                }
            }
            catch {
                $state = 'Failed'
                $errors = @($_.Exception.Message)

                $exception = $_.Exception
                $isCancellation = $false

                while ($null -ne $exception) {
                    if ($exception -is
                        [System.OperationCanceledException]) {
                        $isCancellation = $true
                        break
                    }

                    $exception = $exception.InnerException
                }

                if ($task.CancelRequested -and
                    ($isCancellation -or
                     $invocationState -eq 'Stopped')) {
                    $state = 'Cancelled'
                }
            }

            $completion = [pscustomobject]@{
                Id              = $task.Id
                Title           = $task.Title
                State           = $state
                Output          = @($output)
                Errors          = @($errors)
                CancelRequested = $task.CancelRequested
                DurationSeconds = [Math]::Round(
                    ((Get-Date) - $task.StartedAt).TotalSeconds,
                    2
                )
            }

            # Giai phong khoa truoc callback.
            # Callback co the mo bang ket qua hoac chay tac vu moi.
            [void]$script:CC.Tasks.Remove($task.Id)

            try {
                $task.PowerShell.Dispose()
                $task.Cancellation.Dispose()
            }
            catch {
                Write-CCLog -Level WARN -Message (
                    'Lỗi giải phóng tác vụ "{0}": {1}' -f
                    $task.Title, $_.Exception.Message
                )
            }

            Update-CCTaskStatus

            switch ($state) {
                'Completed' {
                    # Ket thuc worker khong dong nghia moi hanh dong
                    # ben trong deu thanh cong. Xem Output thuc te.
                    Write-CCLog -Message (
                        'Tác vụ kết thúc: {0}. Đã nhận kết quả xử lý.' -f
                        $task.Title
                    )
                }

                'Cancelled' {
                    Write-CCLog -Level WARN -Message (
                        'Đã dừng: {0}. Không tự hoàn tác việc đã làm.' -f
                        $task.Title
                    )
                }

                default {
                    Write-CCLog -Level ERROR -Message (
                        'Tác vụ lỗi "{0}": {1}' -f
                        $task.Title, ($errors -join ' | ')
                    )
                }
            }

            if ($null -ne $task.OnCompleted) {
                try {
                    & $task.OnCompleted $completion | Out-Null
                }
                catch {
                    Write-CCLog -Level ERROR -Message (
                        'Lỗi hiển thị kết quả "{0}": {1}' -f
                        $task.Title, $_.Exception.Message
                    )
                }
            }
        }
    }
    catch {
        Write-CCLog -Level ERROR -Message (
            'Lỗi bộ nhận kết quả: {0}' -f $_.Exception.Message
        )
    }
    finally {
        $script:CC.TaskPolling = $false
    }
}

function Close-CCTaskEngine {
    Assert-CCUIThread

    # Phan giao dien se huy dong cua so neu ham tra ve false.
    # Khong giet worker dang ghi Registry, IP hoac go ung dung.
    if ($script:CC.Tasks.Count -gt 0) {
        Write-CCLog -Level WARN -Message (
            'Chưa thể đóng: còn {0} tác vụ. ' +
            'Dừng tác vụ có hỗ trợ dừng hoặc chờ xử lý xong.' -f
            $script:CC.Tasks.Count
        )
        return $false
    }

    $script:CC.Closing = $true

    if ($null -ne $script:CC.Timer) {
        $script:CC.Timer.Stop()
        $script:CC.Timer.Dispose()
        $script:CC.Timer = $null
    }

    if ($null -ne $script:CC.RunspacePool) {
        $script:CC.RunspacePool.Close()
        $script:CC.RunspacePool.Dispose()
        $script:CC.RunspacePool = $null
    }

    return $true
}


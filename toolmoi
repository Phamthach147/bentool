$ccPageSpecs = @(
    [pscustomobject]@{
        Key = 'Optimize'
        Caption = 'Tối ưu Windows'
    }
    [pscustomobject]@{
        Key = 'Network'
        Caption = 'Mạng và DNS'
    }
    [pscustomobject]@{
        Key = 'Security'
        Caption = 'Bảo mật'
    }
    [pscustomobject]@{
        Key = 'Printers'
        Caption = 'Máy in'
    }
    [pscustomobject]@{
        Key = 'Setup'
        Caption = 'Kiểm tra sau setup'
    }
    [pscustomobject]@{
        Key = 'Downloads'
        Caption = 'Sao lưu / Tải app'
    }
)

$ccNavRow = 0

foreach ($ccSpec in $ccPageSpecs) {
    $ccKey = [string]$ccSpec.Key

    $ccPanel = New-Object System.Windows.Forms.Panel
    $ccPanel.Name = 'CCPage_' + $ccKey
    $ccPanel.Dock = [System.Windows.Forms.DockStyle]::Fill
    $ccPanel.Visible = $false
    $ccPanel.BackColor = $script:CC.Colors.Background

    $script:CC.Pages[$ccKey] = $ccPanel
    [void]$contentHost.Controls.Add($ccPanel)

    # Khong truyen Action vao New-CCButton.
    # Su kien ben duoi doc ten trang tu Tag cua chinh nut.
    $ccNavButton = New-CCButton -Text ([string]$ccSpec.Caption)

    if ($ccNavButton -isnot [System.Windows.Forms.Button]) {
        throw ('Khong tao duoc nut cho trang: {0}' -f $ccKey)
    }

    $ccNavButton.Name = 'CCNav_' + $ccKey
    $ccNavButton.Tag = $ccKey

    $ccNavButton.Add_Click({
        param($sender, $eventArgs)

        try {
            $targetPage = [string]$sender.Tag

            if (-not $script:CC.Pages.ContainsKey($targetPage)) {
                throw ('Khong tim thay trang: {0}' -f $targetPage)
            }

            Show-CCPage -Name $targetPage
        }
        catch {
            Write-CCLog -Level ERROR -Message $_.Exception.Message

            [void][System.Windows.Forms.MessageBox]::Show(
                $script:CC.Form,
                $_.Exception.Message,
                'Lỗi chuyển trang',
                [System.Windows.Forms.MessageBoxButtons]::OK,
                [System.Windows.Forms.MessageBoxIcon]::Error
            )
        }
    })

    $script:CC.NavButtons[$ccKey] = $ccNavButton
    [void]$navigation.Controls.Add($ccNavButton, 0, $ccNavRow)

    $ccNavRow++
}

# Kiem tra ngay tai noi khoi tao.
# Neu thieu trang, dung o day thay vi loi Add() hang loat.
foreach ($ccSpec in $ccPageSpecs) {
    $ccKey = [string]$ccSpec.Key
    $ccCheckPanel = $script:CC.Pages[$ccKey]

    if ($ccCheckPanel -isnot [System.Windows.Forms.Panel]) {
        throw ('Trang chua duoc tao dung: {0}' -f $ccKey)
    }

    if ($ccCheckPanel.Parent -ne $contentHost) {
        throw ('Trang chua duoc gan vao cua so: {0}' -f $ccKey)
    }

    if ($script:CC.NavButtons[$ccKey] -isnot
        [System.Windows.Forms.Button]) {
        throw ('Thieu nut dieu huong: {0}' -f $ccKey)
    }
}


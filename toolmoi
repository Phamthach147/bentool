function Show-CCCompletion {
    param($Completion)

    $rows = New-Object 'System.Collections.Generic.List[object]'
    $counts = @{
        Success = 0
        PendingRestart = 0
        NotPresent = 0
        Unsupported = 0
        Failed = 0
        NeedsConfirmation = 0
        Info = 0
    }

    foreach ($result in @($Completion.Output)) {
        if ($null -eq $result -or
            $result.PSObject.Properties.Name -notcontains 'StatusText') {
            continue
        }

        $symbol = '•'
        switch ($result.Status) {
            Success { $symbol = '✓' }
            PendingRestart { $symbol = '↻' }
            Failed { $symbol = '×' }
            NeedsConfirmation { $symbol = '?' }
            Unsupported { $symbol = '-' }
            NotPresent { $symbol = '-' }
        }

        if ($counts.ContainsKey([string]$result.Status)) {
            $counts[[string]$result.Status]++
        }

        $rows.Add([object[]]@(
            $symbol, $result.Action, $result.StatusText, $result.Reason
        ))

        Write-CCLog -Message (
            '{0}: {1}. {2}' -f
            $result.Action, $result.StatusText, $result.Reason
        )
    }

    foreach ($errorText in @($Completion.Errors)) {
        $rows.Add([object[]]@('×', 'Thực thi tác vụ', 'Thất bại', $errorText))
        $counts.Failed++
    }

    if ($rows.Count -eq 0) {
        $rows.Add([object[]]@(
            '•', $Completion.Title, $Completion.State,
            'Không có kết quả chi tiết được trả về.'
        ))
    }

    $footer = (
        'Thành công: {0} | Chờ khởi động lại: {1} | Không áp dụng: {2} | ' +
        'Thất bại: {3} | Cần xác nhận: {4} | Thông tin: {5}'
    ) -f $counts.Success, $counts.PendingRestart,
        ($counts.NotPresent + $counts.Unsupported),
        $counts.Failed, $counts.NeedsConfirmation, $counts.Info

    Show-CCDataWindow -Title $Completion.Title `
        -Columns @('Biểu tượng', 'Hành động', 'Kết quả', 'Lý do / Việc cần làm') `
        -Rows $rows.ToArray() -Footer $footer
}

function Invoke-CCUIWorker {
    param(
        [string]$Name,
        [string]$Title,
        [hashtable]$Data = @{},
        [string[]]$Resources = @(),
        [scriptblock]$Completed = { param($c) Show-CCCompletion $c },
        [scriptblock]$Progress = {
            param($eventItem, $id)
            if ($eventItem.Message) {
                Write-CCLog -Message $eventItem.Message
            }
        },
        [switch]$CanCancel
    )

    if (-not $script:CC.Workers.ContainsKey($Name)) {
        throw ('Chưa đăng ký worker: {0}' -f $Name)
    }

    [void](Start-CCTask -Id $Name -Title $Title `
        -Worker $script:CC.Workers[$Name] -InputData $Data `
        -Resources $Resources -OnCompleted $Completed `
        -OnProgress $Progress -CanCancel:$CanCancel)
}


function Set-CCWifiPreference {
    param($InputData, $Context)

    $adapter = Assert-CCAdapterIdentity `
        ([int]$InputData.InterfaceIndex) ([string]$InputData.InterfaceGuid)

    if ([int]$adapter.NdisPhysicalMedium -ne 9 -and
        $adapter.InterfaceDescription -notmatch 'Wireless|Wi-Fi|802\.11') {
        throw 'Card đã chọn không được xác nhận là Wi-Fi.'
    }

    $properties = @(Get-NetAdapterAdvancedProperty -Name $adapter.Name `
        -AllProperties -ErrorAction Stop)

    $options = @(
        foreach ($property in $properties) {
            $values = @($property.ValidDisplayValues)
            $registryValues = @($property.ValidRegistryValues)

            if ($property.RegistryKeyword -notmatch 'Prefer.*Band|Band.*Prefer' -and
                $property.DisplayName -notmatch 'Preferred Band|Band Preference') {
                continue
            }

            if ($values.Count -ne $registryValues.Count) { continue }

            for ($i = 0; $i -lt $values.Count; $i++) {
                # Khong chon che do "5 GHz only".
                if ([string]$values[$i] -match '(?i)prefer.*5\s*g|5\s*g.*prefer' -and
                    [string]$values[$i] -notmatch '(?i)only|6\s*g') {
                    [pscustomobject]@{
                        Property = $property
                        Value = [string]$registryValues[$i]
                        Label = [string]$values[$i]
                    }
                }
            }
        }
    )

    if ($options.Count -ne 1) {
        New-CCResult 'Ưu tiên Wi-Fi 5 GHz' Unsupported `
            'Không xác định duy nhất được lựa chọn ưu tiên 5 GHz do driver công bố. Không đoán mã Registry.'
        return
    }

    $option = $options[0]
    [void](Save-CCSnapshot $Context 'WifiPreference' ([pscustomobject]@{
        InterfaceIndex = [int]$adapter.InterfaceIndex
        InterfaceGuid = [string]$adapter.InterfaceGuid
        RegistryKeyword = [string]$option.Property.RegistryKeyword
        RegistryValue = @($option.Property.RegistryValue)
    }))

    Set-NetAdapterAdvancedProperty -Name $adapter.Name `
        -RegistryKeyword $option.Property.RegistryKeyword `
        -RegistryValue $option.Value -NoRestart -ErrorAction Stop

    $after = Get-NetAdapterAdvancedProperty -Name $adapter.Name `
        -RegistryKeyword $option.Property.RegistryKeyword -ErrorAction Stop

    if ((@($after.RegistryValue) -join ',') -ne $option.Value) {
        throw 'Giá trị ưu tiên băng tần đọc lại không khớp.'
    }

    New-CCResult 'Ưu tiên Wi-Fi 5 GHz' PendingRestart (
        'Đã lưu lựa chọn "{0}". Không tự ngắt card. ' +
        'Có thể cần kết nối lại/khởi động lại; chưa xác nhận băng tần đang kết nối.' -f
        $option.Label
    )
}

function Restore-CCSupportedSnapshot {
    param($InputData, $Context)

    $path = [string]$InputData.Path
    $record = Import-Clixml -LiteralPath $path -ErrorAction Stop

    if ($record.Schema -ne 1 -or $record.Computer -ne $env:COMPUTERNAME) {
        throw 'Sai định dạng hoặc bản sao lưu thuộc máy khác.'
    }

    switch ([string]$record.Kind) {
        Registry {
            Restore-CCRegistrySnapshot $Context $path
        }

        WifiPreference {
            $data = $record.Data
            $adapter = Assert-CCAdapterIdentity `
                ([int]$data.InterfaceIndex) ([string]$data.InterfaceGuid)

            $before = Get-NetAdapterAdvancedProperty -Name $adapter.Name `
                -RegistryKeyword $data.RegistryKeyword -ErrorAction Stop

            [void](Save-CCSnapshot $Context 'WifiPreference' ([pscustomobject]@{
                InterfaceIndex = [int]$adapter.InterfaceIndex
                InterfaceGuid = [string]$adapter.InterfaceGuid
                RegistryKeyword = [string]$before.RegistryKeyword
                RegistryValue = @($before.RegistryValue)
            }))

            Set-NetAdapterAdvancedProperty -Name $adapter.Name `
                -RegistryKeyword $data.RegistryKeyword `
                -RegistryValue ([string[]]$data.RegistryValue) `
                -NoRestart -ErrorAction Stop

            $after = Get-NetAdapterAdvancedProperty -Name $adapter.Name `
                -RegistryKeyword $data.RegistryKeyword -ErrorAction Stop

            if ((@($after.RegistryValue) -join ',') -ne
                (@($data.RegistryValue) -join ',')) {
                throw 'Khôi phục Wi-Fi không khớp giá trị cũ.'
            }

            New-CCResult 'Khôi phục ưu tiên Wi-Fi' PendingRestart `
                'Đã đọc lại giá trị cũ; không tự khởi động lại card.'
        }

        Firewall {
            $before = @(Get-NetFirewallProfile -PolicyStore PersistentStore `
                -ErrorAction Stop | Select-Object Name, Enabled)
            [void](Save-CCSnapshot $Context 'Firewall' $before)

            foreach ($profile in @($record.Data)) {
                if ($profile.Name -notin @('Domain', 'Private', 'Public')) {
                    throw 'Tên Firewall profile không hợp lệ.'
                }
                $enabled = ([string]$profile.Enabled -eq 'True')
                Set-NetFirewallProfile -Profile $profile.Name `
                    -Enabled $enabled -ErrorAction Stop

                $after = Get-NetFirewallProfile -Name $profile.Name `
                    -PolicyStore ActiveStore -ErrorAction Stop

                if ([string]$after.Enabled -ne [string]$profile.Enabled) {
                    New-CCResult ('Khôi phục Firewall {0}' -f $profile.Name) Info `
                        'Đã ghi cấu hình cục bộ nhưng trạng thái hiệu lực khác.'
                }
                else {
                    New-CCResult ('Khôi phục Firewall {0}' -f $profile.Name) Success `
                        'Đã đọc lại trạng thái hiệu lực.'
                }
            }
        }

        default {
            New-CCResult 'Khôi phục bản sao lưu' Unsupported (
                'Loại {0} chỉ lưu để đối chiếu trong bản này. ' +
                'Không tự phục hồi IP, dịch vụ, ứng dụng hoặc optional feature.' -f
                $record.Kind
            )
        }
    }
}

Register-CCWorkerFunction -Name @(
    'Set-CCIPv4Configuration'
    'Set-CCWifiPreference'
    'Restore-CCSupportedSnapshot'
)

$script:CC.Workers.IP = {
